{
  "name": "pos-saas-website",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./public/css/output.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/css/output.css --watch",
    "build": "npm run build:css",
    "start": "node server.js",
    "dev": "concurrently \"npm run watch:css\" \"node server.js\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^5.2.1",
    "autoprefixer": "^10.5.3",
    "postcss": "^8.5.19",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
