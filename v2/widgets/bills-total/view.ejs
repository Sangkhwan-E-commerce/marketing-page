<div class="w-bills">
    <div class="w-bills-num"><span data-countup="<%= data.value %>" data-format="<%= data.format %>"><%= data.display %></span> <small><%= text.unit %></small></div>
    <% if (settings.show_caption) { %><p class="w-bills-caption"><%= settings['caption_' + locale] || text.caption %></p><% } %>
    <% if (settings.show_channels) { %><p class="w-bills-channels"><%= text.channels %></p><% } %>
    <% if (data.source === 'live' && settings.show_updated) { %><p class="w-bills-updated"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> <%= text.updated %></p><% } %>
</div>
