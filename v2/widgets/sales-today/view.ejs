<div class="w-sales">
    <div class="w-sales-head">
    <div class="w-sales-top">
        <div class="w-sales-total"><span class="w-sales-cur"><%= text.currency %></span><span data-countup="<%= data.total %>"><%= fmt(data.total) %></span></div>
        <% if (settings.show_change) { %>
        <span class="w-sales-change <%= data.change >= 0 ? 'is-up' : 'is-down' %>">
            <i class="bi <%= data.change >= 0 ? 'bi-arrow-up-right' : 'bi-arrow-down-right' %>" aria-hidden="true"></i>
            <%= fmt(Math.abs(data.change), { style: 'percent' }) %> <%= text.vs_yesterday %>
        </span>
        <% } %>
    </div>
    <% if (settings.show_meta) { %><p class="w-sales-meta"><%= fmt(data.bills) %> <%= text.bills %> · <%= text.currency %><%= fmt(data.avg) %> <%= text.avg %></p><% } %>
    </div>

    <% if (data.chart) { %>
    <div class="w-sales-chart" data-chart="<%= JSON.stringify(data.chart) %>"><canvas role="img" aria-label="<%= data.chart.ariaLabel %>"></canvas></div>
    <% } %>

    <% if (data.showPayments) { %>
    <div class="w-sales-pay">
        <% if (data.pay) { %><div class="w-sales-paybar" data-chart="<%= JSON.stringify(data.pay) %>"><canvas role="img" aria-label="<%= data.pay.ariaLabel %>"></canvas></div><% } %>
        <ul class="w-sales-legend">
            <% data.payments.forEach(function (p) { %>
            <li><i class="w-dot w-pay-<%= p.key %>"></i><%= text.payments[p.key] %> <b><%= fmt(p.share, { style: 'percent' }) %></b></li>
            <% }) %>
        </ul>
    </div>
    <% } %>
</div>
