<!DOCTYPE html>
<html lang="<%= head.lang %>">
<head>
<%- include('_head', { head: head }) %>
    <link rel="stylesheet" href="<%= base %>/assets/vendor/fonts/anuphan/font.css">
    <link rel="stylesheet" href="<%= base %>/assets/vendor/bootstrap-icons/1.11.3/bootstrap-icons.min.css">
    <link rel="stylesheet" href="<%= base %>/assets/css/v2.css?v=<%= assetVer.css %>">
    <link rel="stylesheet" href="<%= base %>/assets/widgets.css?v=<%= assetVer.widgetCss %>">
</head>
<%# ส่วนบน/ส่วนท้าย/Footer แก้ได้ที่ Admin > Marketing web > ตั้งค่าเว็บไซต์ (กลุ่ม hero / cta / footer) — ค่าตั้งต้นอยู่ที่ v2/site-settings.js %>
<% var hero = sections.hero, cta = sections.cta; %>
<body class="lp-body<%= pageDark ? ' lp-page-dark' : '' %>" style="--lp-bg: <%= pageBg %>; --lp-primary: <%= primary %>; --lp-primary-ink: <%= primaryInk %>">
    <% if (preview) { %><div class="lp-preview-bar" role="status"><i class="bi bi-eye" aria-hidden="true"></i> <%= t('preview.banner') %></div><% } %>
    <header class="lp-topbar">
        <a class="lp-brand" href="<%= selfUrl %>"><img src="<%= logo %>" alt="<%= texts.site_name %>" style="height: <%= site.brand.logo_height %>px"></a>
        <nav class="lp-topbar-actions">
            <% if (hero.show_lang_switch) { %><a class="lp-link" href="<%= altUrl %>" hreflang="<%= altLocale %>"><i class="bi bi-translate" aria-hidden="true"></i> <%= t('nav.lang') %></a><% } %>
            <% if (hero.show_nav_button) { %><a class="lp-btn lp-btn-dark" href="<%= hero.nav_button_url %>"><%= hero.nav_button_text %></a><% } %>
        </nav>
    </header>

    <main class="lp-main">
        <section class="lp-hero">
            <% if (hero.show_eyebrow) { %><p class="lp-eyebrow"><%= hero.eyebrow %></p><% } %>
            <h1 class="lp-title"><%= hero.title %></h1>
            <% if (hero.show_subtitle) { %><p class="lp-subtitle"><%= hero.subtitle %></p><% } %>
            <% if (hero.show_button) { %><a class="lp-btn lp-btn-primary lp-btn-lg" href="<%= hero.button_url %>"><%= hero.button_text %> <i class="bi bi-arrow-right" aria-hidden="true"></i></a><% } %>
        </section>

        <% if (!cards.length) { %>
            <p class="lp-empty"><%= t('empty') %></p>
        <% } else { %>
        <section class="lp-grid" aria-label="Lullapos">
            <% cards.forEach(function (card) { %>
            <article class="lp-card lp-tone-<%= card.tone %> lp-size-<%= card.size %><%= card.mobile ? '' : ' lp-hide-mobile' %><%= card.cardClass ? ' ' + card.cardClass : '' %>"
                     data-widget="<%= card.id %>" data-key="<%= card.key %>" data-size="<%= card.size %>"<% if (card.style) { %> style="<%= card.style %>"<% } %>>
                <% if (card.header) { %>
                <header class="lp-card-head<%= card.showTitle ? "" : " is-untitled" %>">
                    <h2 class="lp-card-title<%= card.showTitle ? "" : " lp-sr-only" %>"><%= card.name %></h2>
                    <div class="lp-card-tools">
                        <% if (card.source === 'live') { %>
                            <span class="lp-badge lp-badge-live" title="<%= t('badge.live_title') %>"><i class="bi bi-broadcast" aria-hidden="true"></i> <%= t('badge.live') %></span>
                        <% } else { %>
                            <span class="lp-badge" title="<%= t('badge.mock_title') %>"><%= t('badge.mock') %></span>
                        <% } %>
                        <% if (card.docUrl) { %>
                            <a class="lp-card-arrow" href="<%= card.docUrl %>" target="_blank" rel="noopener" aria-label="<%= t('card.doc_link') %>: <%= card.name %>" title="<%= t('card.doc_link') %>"><i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
                        <% } %>
                    </div>
                </header>
                <% } %>
                <div class="lp-card-body"><%- card.html %></div>
            </article>
            <% }) %>
        </section>
        <% } %>

        <% if (cta.show) { %>
        <section class="lp-cta<%= cta.bg_color ? ' lp-band' : '' %><%= ctaDark ? ' lp-band-dark' : '' %>"<% if (cta.bg_color) { %> style="background-color: <%= cta.bg_color %>"<% } %>>
            <h2><%= cta.title %></h2>
            <a class="lp-btn lp-btn-primary lp-btn-lg" href="<%= cta.button_url %>"><%= cta.button_text %> <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
            <% if (cta.show_note) { %><p class="lp-note"><%= cta.note %></p><% } %>
        </section>
        <% } %>
    </main>

<%- include('_footer') %>

    <% if (needsChartJs) { %><script src="<%= base %>/assets/vendor/chartjs/4.5.1/chart.umd.min.js"></script><% } %>
    <script src="<%= base %>/assets/js/v2.js?v=<%= assetVer.js %>"></script>
    <script src="<%= base %>/assets/widgets.js?v=<%= assetVer.widgetJs %>"></script>
    <script>window.LP && window.LP.start({ locale: '<%= locale %>' });</script>
</body>
</html>
