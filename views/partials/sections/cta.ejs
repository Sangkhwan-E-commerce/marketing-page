<div class="<%= sectionBg %> py-16 sm:py-24 lg:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl"><%= settings.cta_title %></h2>
      <div class="mx-auto mt-6 text-lg leading-8 text-gray-600 prose max-w-none"><%- settings.cta_desc %></div>
      <div class="mt-10 flex items-center justify-center gap-x-6">
        <a href="<%= settings.cta_btn1_url %>" class="rounded-md bg-primary px-8 py-3.5 text-sm font-semibold text-white shadow-sm hover:opacity-80 transition"><%= settings.cta_btn1_text %></a>
        <a href="<%= settings.cta_btn2_url %>" class="text-sm font-semibold leading-6 text-gray-900 group"><%= settings.cta_btn2_text %> <span aria-hidden="true" class="group-hover:translate-x-1 inline-block transition-transform">→</span></a>
      </div>
    </div>
  </div>
</div>
