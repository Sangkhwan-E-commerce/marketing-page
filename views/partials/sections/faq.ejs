<div class="<%= sectionBg %> py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto text-center mb-12">
      <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl"><%= settings.faq_title %></h2>
    </div>
    
    <dl class="mx-auto grid max-w-6xl grid-cols-1 gap-6 md:grid-cols-2">
      <% 
          let faqs = [];
          try { faqs = JSON.parse(settings.faq_list); } catch(e) {}
          faqs.forEach(function(faq, index) { 
      %>
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-200 faq-item self-start hover:shadow-md transition-shadow">
        <dt>
          <button type="button" class="faq-toggle-btn flex w-full items-start justify-between text-left text-gray-900 focus:outline-none transition-colors hover:text-primary">
            <span class="text-base font-semibold leading-7 pr-4 flex items-center gap-3"><% if (faq.icon) { %><span class="shrink-0 text-primary [&>svg]:h-5 [&>svg]:w-5"><%- include('../_icon', { value: faq.icon, cls: 'text-xl' }) %></span><% } %><%- faq.question %></span>
            <span class="flex h-7 items-center shrink-0">
              <svg class="h-5 w-5 faq-icon-plus transition-transform duration-200 text-gray-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m6-6H6" /></svg>
              <svg class="h-5 w-5 hidden faq-icon-minus text-primary transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M18 12H6" /></svg>
            </span>
          </button>
        </dt>
        <dd class="mt-4 hidden faq-answer transition-all duration-300 border-t border-gray-100 pt-4">
          <div class="text-base leading-7 text-gray-600 prose max-w-none"><%- faq.answer %></div>
        </dd>
      </div>
      <% }); %>
    </dl>
  </div>
</div>

<script>
    const faqButtons = document.querySelectorAll('.faq-toggle-btn');
    faqButtons.forEach(button => {
        button.addEventListener('click', () => {
            const answer = button.parentElement.nextElementSibling;
            const iconPlus = button.querySelector('.faq-icon-plus');
            const iconMinus = button.querySelector('.faq-icon-minus');
            const isOpen = !answer.classList.contains('hidden');
            
            document.querySelectorAll('.faq-answer').forEach(ans => ans.classList.add('hidden'));
            document.querySelectorAll('.faq-icon-plus').forEach(icon => icon.classList.remove('hidden'));
            document.querySelectorAll('.faq-icon-minus').forEach(icon => icon.classList.add('hidden'));
            
            if (!isOpen) {
                answer.classList.remove('hidden');
                iconPlus.classList.add('hidden');
                iconMinus.classList.remove('hidden');
            }
        });
    });
</script>
