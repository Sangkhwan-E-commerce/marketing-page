<% var HTag = index === 0 ? 'h1' : 'h2'; %>
<div class="overflow-hidden bg-white py-20 sm:py-24">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto grid max-w-2xl grid-cols-1 items-center gap-x-16 gap-y-12 lg:mx-0 lg:max-w-none lg:grid-cols-2">
      <div class="relative flex items-center justify-center lg:order-first">
        <% if (block.image) { %>
        <img src="<%= block.image %>" alt="<%= block.title %>" class="max-w-[360px]">
        <% } %>
      </div>
      <div class="lg:pl-8">
        <div class="lg:max-w-lg">
          <% if (block.badge) { %><p class="text-base font-semibold leading-7 text-primary"><%= block.badge %></p><% } %>
          <<%= HTag %> class="mt-2 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl"><%= block.title %></<%= HTag %>>
          <div class="mt-6 text-lg leading-8 text-gray-600 prose max-w-none"><%- block.desc %></div>
          <%- include('../_buttons', { buttons: block.buttons, align: 'left', tone: 'light' }) %>
        </div>
      </div>
    </div>
  </div>
</div>
