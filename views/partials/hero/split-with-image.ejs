<% var HTag = index === 0 ? 'h1' : 'h2'; %>
<div class="overflow-hidden bg-white py-15 sm:py-30">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto grid max-w-2xl grid-cols-1 gap-x-16 gap-y-16 sm:gap-y-20 lg:mx-0 lg:max-w-none lg:grid-cols-2">
      <div class="lg:pr-[150px] lg:pt-4 relative z-10 bg-white/80 lg:bg-transparent rounded-2xl p-4 lg:p-0">
        <div class="lg:max-w-lg">
          <% if (block.badge) { %><p class="text-base font-semibold leading-7 text-primary"><%= block.badge %></p><% } %>
          <<%= HTag %> class="mt-2 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl"><%= block.title %></<%= HTag %>>
          <div class="mt-6 text-lg leading-8 text-gray-600 prose max-w-none"><%- block.desc %></div>
          <%- include('../_buttons', { buttons: block.buttons, align: 'left', tone: 'light' }) %>
        </div>
      </div>
      <div class="relative flex items-center justify-center mt-10 lg:mt-0">
        <% if (block.image) { %>
        <img src="<%= block.image %>" alt="<%= block.title %>" class="w-full max-w-full lg:max-w-none lg:w-[57rem] rounded-xl shadow-2xl ring-1 ring-gray-400/10 md:-ml-4 lg:-ml-0">
        <% } %>
      </div>
    </div>
  </div>
</div>
