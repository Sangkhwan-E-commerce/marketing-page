<% var HTag = index === 0 ? 'h1' : 'h2'; %>
<div class="relative isolate py-20 overflow-hidden bg-white pt-20 sm:pt-28">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <% if (block.badge) { %>
      <p class="mb-4 inline-block rounded-full bg-primary/10 px-4 py-1 text-sm font-semibold leading-6 text-primary"><%= block.badge %></p>
      <% } %>
      <<%= HTag %> class="text-4xl font-bold tracking-tight text-gray-900 sm:text-6xl"><%= block.title %></<%= HTag %>>
      <div class="mt-6 text-lg leading-8 text-gray-600 prose max-w-none mx-auto"><%- block.desc %></div>
      <%- include('../_buttons', { buttons: block.buttons, align: 'center', tone: 'light' }) %>
    </div>
    <% if (block.image) { %>
    <div class="mt-16 flow-root sm:mt-24">
      <div class="-m-2 rounded-xl bg-gray-900/5 p-2 ring-1 ring-inset ring-gray-900/10 lg:-m-4 lg:rounded-2xl lg:p-4">
        <%- include('_media', { block: block, mediaClass: 'mx-auto w-full rounded-md shadow-2xl ring-1 ring-gray-900/10' }) %>
      </div>
    </div>
    <% } %>
  </div>
  <div class="h-20 sm:h-28"></div>
</div>
