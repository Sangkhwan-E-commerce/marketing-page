<div class="<%= section.bg || 'bg-white' %> py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto grid max-w-2xl grid-cols-1 items-start gap-x-16 gap-y-16 lg:mx-0 lg:max-w-none <%= section.image ? 'lg:grid-cols-2' : '' %>">
      <div class="lg:pt-4">
        <% if (section.badge) { %><h2 class="text-base font-semibold leading-7 text-primary"><%= section.badge %></h2><% } %>
        <p class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl"><%= section.title %></p>
        <p class="mt-6 text-lg leading-8 text-gray-600"><%- section.desc %></p>
        <dl class="mt-10 max-w-xl space-y-8 text-base leading-7 text-gray-600">
          <% section.items.forEach(function(item) { %>
          <div class="relative pl-14">
            <dt class="font-semibold text-gray-900"><div class="absolute left-0 top-0 flex h-9 w-9 items-center justify-center rounded-lg bg-primary text-white [&>svg]:w-5 [&>svg]:h-5"><%- item.icon %></div><%- item.title %></dt>
            <dd class="mt-1"><%- item.desc %></dd>
          </div>
          <% }); %>
        </dl>
      </div>
      <% if (section.image) { %>
      <div class="flex items-start justify-center lg:sticky lg:top-8">
        <img src="<%= section.image %>" alt="<%= section.title %>" class="w-full rounded-xl shadow-2xl ring-1 ring-gray-400/10">
      </div>
      <% } %>
    </div>
  </div>
</div>
