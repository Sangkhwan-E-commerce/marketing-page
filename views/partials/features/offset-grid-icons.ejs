<div class="<%= section.bg || 'bg-white' %> py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl lg:text-center">
      <% if (section.badge) { %><h2 class="text-base font-semibold leading-7 text-primary"><%= section.badge %></h2><% } %>
      <p class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl"><%= section.title %></p>
      <p class="mt-6 text-lg leading-8 text-gray-600"><%- section.desc %></p>
    </div>
    <div class="mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-4xl">
      <dl class="grid max-w-xl grid-cols-1 gap-x-8 gap-y-10 lg:max-w-none lg:grid-cols-2 lg:gap-y-16">
        <% section.items.forEach(function(item) { %>
        <div class="relative pl-16">
          <dt class="text-base font-semibold leading-7 text-gray-900"><div class="absolute left-0 top-0 flex h-10 w-10 items-center justify-center rounded-lg bg-primary text-white [&>svg]:w-6 [&>svg]:h-6"><%- include('../_icon', { value: item.icon, cls: 'text-2xl' }) %></div><%- item.title %></dt>
          <dd class="mt-2 text-base leading-7 text-gray-600"><%= item.desc %></dd>
        </div>
        <% }); %>
      </dl>
    </div>
  </div>
</div>
