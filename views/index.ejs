            </div>
            <%- settings.grid4_title %>
          </dt>
          <dd class="mt-2 text-base leading-7 text-gray-600"><%= settings.grid4_desc %></dd>
        </div>

        <!-- Feature 5 -->
        <div class="relative pl-16">
          <dt class="text-base font-semibold leading-7 text-gray-900">
