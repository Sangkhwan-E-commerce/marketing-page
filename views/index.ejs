<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lullapos - <%= settings.hero_title %></title>
    <link rel="icon" type="image/png" href="<%= settings.favicon_url %>">
    <!-- เปลี่ยนบรรทัดนี้ -->
    <script src="https://cdn.tailwindcss.com?plugins=typography"></script>
    
    
    <!-- เพิ่ม Script นี้เพื่อให้ Tailwind ดึงสีจาก Database มาสร้างเป็นคลาส bg-primary, text-primary -->
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              primary: '<%= settings.theme_color %>'
            }
          }
        }
      }
    </script>

    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style> body { font-family: 'Prompt', sans-serif; } </style>
</head>
<body class="bg-gray-50 text-gray-800">

<!-- Hero Section ที่คุณต้องการ -->
<div class="overflow-hidden bg-white py-15 sm:py-30">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    
    <!-- แสดง Logo -->
    <div class="mb-12">
        <img src="<%= settings.logo_url %>" alt="Lullapos Logo" class="h-auto w-full max-w-[300px]">
    </div>

    <div class="mx-auto grid max-w-2xl grid-cols-1 gap-x-16 gap-y-16 sm:gap-y-20 lg:mx-0 lg:max-w-none lg:grid-cols-2">
      
      <!-- ฝั่งซ้าย: ข้อความ (เพิ่ม pr-[30px] และ z-10 ให้อยู่เหนือรูปเสมอ) -->
      <div class="lg:pr-[150px] lg:pt-4 relative z-10 bg-white/80 lg:bg-transparent rounded-2xl p-4 lg:p-0">
        <div class="lg:max-w-lg">
          <h2 class="text-base font-semibold leading-7 text-primary"><%= settings.hero_badge %></h2>
          <p class="mt-2 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl"><%= settings.hero_title %></p>
          
          <!-- ใช้ <%- %> และ prose สำหรับ Text Editor -->
          <div class="mt-6 text-lg leading-8 text-gray-600 prose max-w-none"><%- settings.hero_desc %></div>
          
          <!-- ปุ่ม CTA -->
          <div class="mt-10 flex items-center gap-x-6">
            <a href="<%= settings.btn_url %>" 
               class="rounded-md bg-primary px-8 py-3.5 <%= settings.btn_size %> font-semibold text-white shadow-sm hover:opacity-80 transition">
               <%= settings.btn_text %>
            </a>
          </div>
        </div>
      </div>

      <!-- ฝั่งขวา: Product Screenshot (ปรับให้พอดีจอมือถือ แต่ทะลุกรอบในจอคอม) -->
      <div class="relative flex items-center justify-center mt-10 lg:mt-0">
        <img src="<%= settings.hero_img_url %>" alt="Lullapos Dashboard Screenshot" class="w-full max-w-full lg:max-w-none lg:w-[57rem] rounded-xl shadow-2xl ring-1 ring-gray-400/10 md:-ml-4 lg:-ml-0">
      </div>

    </div>
  </div>
</div>

<!-- Feature 3 Columns Section -->
<div class="bg-primary-50 py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl lg:text-center">
      <h2 class="text-base font-semibold leading-7 text-primary">วิสัยทัศน์ของเรา</h2>
      <p class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl"><%= settings.feature_title %></p>
      <p class="mt-6 text-lg leading-8 text-gray-600"><%= settings.feature_subtitle %></p>
    </div>
    
    <div class="mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-none">
      <dl class="grid max-w-xl grid-cols-1 gap-x-8 gap-y-16 lg:max-w-none lg:grid-cols-3">
        
        <!-- Column 1: Story -->
        <div class="flex flex-col bg-white p-8 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition">
          <dt class="flex items-center gap-x-3 text-xl font-semibold leading-7 text-gray-900">
            <div class="h-10 w-10 flex items-center justify-center rounded-lg bg-primary text-white [&>svg]:w-6 [&>svg]:h-6">
              <%- settings.col1_icon %>
            </div>
            <%= settings.col1_title %>
          </dt>
          <dd class="mt-4 flex flex-auto flex-col text-base leading-7 text-gray-600">
            <p class="flex-auto"><%- settings.col1_desc %></p>
          </dd>
        </div>

        <!-- Column 2: Free 1000 Orders -->
        <div class="flex flex-col bg-white p-8 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition">
          <dt class="flex items-center gap-x-3 text-xl font-semibold leading-7 text-gray-900">
            <div class="h-10 w-10 flex items-center justify-center rounded-lg bg-primary text-white [&>svg]:w-6 [&>svg]:h-6">
              <%- settings.col2_icon %>
            </div>
            <%= settings.col2_title %>
          </dt>
          <dd class="mt-4 flex flex-auto flex-col text-base leading-7 text-gray-600">
            <p class="flex-auto"><%- settings.col2_desc %></p>
          </dd>
        </div>

        <!-- Column 3: Pay as you grow -->
        <div class="flex flex-col bg-white p-8 rounded-2xl shadow-sm border-2 border-primary hover:shadow-md transition relative overflow-hidden">
          <div class="absolute top-0 right-0 bg-primary-500 text-white text-xs font-bold px-3 py-1 rounded-bl-lg">คุ้มค่าที่สุด</div>
          <dt class="flex items-center gap-x-3 text-xl font-semibold leading-7 text-gray-900">
            <div class="h-10 w-10 flex items-center justify-center rounded-lg bg-primary text-white [&>svg]:w-6 [&>svg]:h-6">
              <%- settings.col3_icon %>
            </div>
            <%= settings.col3_title %>
          </dt>
          <dd class="mt-4 flex flex-auto flex-col text-base leading-7 text-gray-600">
            <p class="flex-auto"><%- settings.col3_desc %></p>
          </dd>
        </div>

      </dl>
    </div>
  </div>
</div>

