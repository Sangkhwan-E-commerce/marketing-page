          <dd class="mt-2 text-base leading-7 text-gray-600"><%= settings.grid3_desc %></dd>
        </div>
        <div class="relative pl-16">
          <dt class="text-base font-semibold leading-7 text-gray-900"><div class="absolute left-0 top-0 flex h-10 w-10 items-center justify-center rounded-lg bg-primary text-white [&>svg]:w-6 [&>svg]:h-6"><%- settings.grid4_icon %></div><%- settings.grid4_title %></dt>
          <dd class="mt-2 text-base leading-7 text-gray-600"><%= settings.grid4_desc %></dd>
        </div>
        <div class="relative pl-16">
          <dt class="text-base font-semibold leading-7 text-gray-900"><div class="absolute left-0 top-0 flex h-10 w-10 items-center justify-center rounded-lg bg-primary text-white [&>svg]:w-6 [&>svg]:h-6"><%- settings.grid5_icon %></div><%- settings.grid5_title %></dt>
          <dd class="mt-2 text-base leading-7 text-gray-600"><%= settings.grid5_desc %></dd>
        </div>
        <div class="relative pl-16">
          <dt class="text-base font-semibold leading-7 text-gray-900"><div class="absolute left-0 top-0 flex h-10 w-10 items-center justify-center rounded-lg bg-primary text-white [&>svg]:w-6 [&>svg]:h-6"><%- settings.grid6_icon %></div><%- settings.grid6_title %></dt>
          <dd class="mt-2 text-base leading-7 text-gray-600"><%= settings.grid6_desc %></dd>
