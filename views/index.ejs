<%
// ฟังก์ชันช่วยดึงข้อมูล JSON แยกตามภาษาปัจจุบัน
function getVal(key) {
    let val = settings[key] || '';
    try {
        let parsed = JSON.parse(val);
        if (parsed && typeof parsed === 'object' && !Array.isArray(parsed) && (parsed.th !== undefined || parsed.en !== undefined)) {
            return parsed[currentLang] !== undefined ? parsed[currentLang] : '';
        }
    } catch(e) { }
    return val;
}

// เตรียมข้อมูลสไลด์แบนเนอร์
let bannerSlides = [];
try {
    bannerSlides = JSON.parse(getVal('banner_list') || '[]');
} catch(e) { }
%>
<!DOCTYPE html>
<html lang="<%= currentLang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= getVal('seo_title') %></title>
    <meta name="description" content="<%= getVal('seo_description') %>">
    <meta name="keywords" content="<%= getVal('seo_keywords') %>">
    
    <!-- Open Graph (SEO Social Media) -->
    <meta property="og:title" content="<%= getVal('seo_title') %>">
    <meta property="og:description" content="<%= getVal('seo_description') %>">
    <meta property="og:image" content="<%= settings.seo_thumbnail_url %>">
    
    <!-- Favicon -->
    <link rel="icon" href="<%= settings.favicon_url %>">

    <!-- CSS / Tailwind -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    
    <!-- Swiper CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.css" />

    <style>
        :root {
            --theme-color: <%= settings.theme_color || '#3b82f6' %>;
        }
        .text-theme { color: var(--theme-color); }
        .bg-theme { background-color: var(--theme-color); }
        .border-theme { border-color: var(--theme-color); }
        .hover-bg-theme:hover { filter: brightness(0.9); }
    </style>
</head>
<body class="font-sans antialiased text-gray-800 bg-white">

    <!-- Navbar -->
    <nav class="bg-white shadow-sm fixed w-full z-40 top-0">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <!-- Logo -->
                <div class="flex-shrink-0">
                    <a href="/"><img src="<%= settings.logo_url %>" alt="Logo" class="h-8 w-auto"></a>
                </div>
                
                <!-- Action & Lang Switcher -->
                <div class="flex items-center gap-4">
                    <select onchange="window.location.href='/?lang=' + this.value" class="text-sm font-medium border-gray-300 rounded-md shadow-sm focus:border-blue-500 focus:ring-blue-500 bg-gray-50 py-1.5 pl-3 pr-8 cursor-pointer">
                        <option value="th" <%= currentLang === 'th' ? 'selected' : '' %>>🇹🇭 TH</option>
                        <option value="en" <%= currentLang === 'en' ? 'selected' : '' %>>🇬🇧 EN</option>
                    </select>
                    <a href="<%= getVal('btn_url') %>" class="bg-theme text-white px-4 py-2 rounded-full text-sm font-bold shadow hover-bg-theme transition-all">
                        <%= getVal('btn_text') %>
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Spacer for fixed navbar -->
    <div class="h-16"></div>

    <!-- Hero Section -->
    <section class="relative bg-gray-50 overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-24 lg:pt-32 lg:pb-40 flex flex-col lg:flex-row items-center gap-12">
            <div class="w-full lg:w-1/2 text-center lg:text-left z-10">
                <% if(getVal('hero_badge')) { %>
                    <span class="inline-block py-1 px-3 rounded-full bg-blue-100 text-theme text-sm font-semibold mb-4 border border-blue-200">
                        <%= getVal('hero_badge') %>
                    </span>
                <% } %>
                <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-gray-900 mb-6 leading-tight">
                    <%- getVal('hero_title').replace(/\n/g, '<br>') %>
                </h1>
                <p class="text-lg text-gray-600 mb-8 max-w-2xl mx-auto lg:mx-0">
                    <%- getVal('hero_desc') %>
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
                    <a href="<%= getVal('btn_url') %>" class="bg-theme text-white text-lg font-bold px-8 py-3 rounded-full shadow-lg hover:-translate-y-1 transition-transform">
                        <%= getVal('btn_text') %>
                    </a>
                </div>
            </div>
            <div class="w-full lg:w-1/2 relative z-10">
                <img src="<%= settings.hero_img_url %>" alt="Hero" class="rounded-2xl shadow-2xl w-full object-cover aspect-video lg:aspect-square">
            </div>
        </div>
    </section>

    <!-- 3 Columns Feature Section -->
    <section class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"><%= getVal('feature_title') %></h2>
            <p class="text-lg text-gray-500 max-w-3xl mx-auto mb-16"><%= getVal('feature_subtitle') %></p>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
                <% for(let i=1; i<=3; i++) { %>
                <div class="flex flex-col items-center text-center p-6 rounded-2xl hover:bg-gray-50 transition-colors">
                    <div class="w-16 h-16 bg-blue-50 text-theme rounded-2xl flex items-center justify-center mb-6 shadow-sm border border-blue-100">
                        <%- getVal('col' + i + '_icon') %>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 mb-3"><%= getVal('col' + i + '_title') %></h3>
                    <p class="text-gray-600"><%- getVal('col' + i + '_desc') %></p>
                </div>
                <% } %>
            </div>
        </div>
    </section>

    <!-- Grid Features (6 Boxes) -->
    <section class="py-20 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <% if(getVal('grid_badge')) { %>
                    <span class="text-theme font-semibold tracking-wide uppercase text-sm mb-2 block"><%= getVal('grid_badge') %></span>
                <% } %>
                <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"><%= getVal('grid_title') %></h2>
                <p class="text-lg text-gray-500 max-w-2xl mx-auto"><%- getVal('grid_desc') %></p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <% for(let i=1; i<=6; i++) { %>
                <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
                    <div class="w-12 h-12 text-theme mb-6">
                        <%- getVal('grid' + i + '_icon') %>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900 mb-2"><%= getVal('grid' + i + '_title') %></h3>
                    <p class="text-gray-600"><%= getVal('grid' + i + '_desc') %></p>
                </div>
                <% } %>
            </div>
        </div>
    </section>

    <!-- Stats Section -->
    <section class="relative py-24 bg-gray-900 overflow-hidden">
        <div class="absolute inset-0">
            <img src="<%= settings.stats_img_url %>" class="w-full h-full object-cover opacity-20" alt="Stats Background">
        </div>
        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-white z-10">
            <span class="text-blue-400 font-semibold tracking-wide uppercase text-sm mb-2 block"><%= getVal('stats_badge') %></span>
            <h2 class="text-3xl md:text-4xl font-bold mb-4"><%= getVal('stats_title') %></h2>
            <p class="text-lg text-gray-300 max-w-2xl mx-auto mb-16"><%- getVal('stats_desc') %></p>
            
            <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
                <% for(let i=1; i<=4; i++) { %>
                <div>
                    <div class="text-4xl md:text-5xl font-extrabold text-white mb-2"><%= getVal('stat' + i + '_value') %></div>
                    <div class="text-sm md:text-base text-gray-400 font-medium"><%= getVal('stat' + i + '_label') %></div>
                </div>
                <% } %>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <% 
        let faqs = [];
        try { faqs = JSON.parse(getVal('faq_list') || '[]'); } catch(e) {}
        if(faqs.length > 0) {
    %>
    <section class="py-20 bg-white">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-3xl font-bold text-center text-gray-900 mb-12"><%= getVal('faq_title') %></h2>
            <div class="space-y-4">
                <% faqs.forEach((faq, index) => { %>
                <div class="border border-gray-200 rounded-lg bg-gray-50 overflow-hidden">
                    <button class="w-full px-6 py-4 text-left font-bold text-gray-900 flex justify-between items-center focus:outline-none" onclick="document.getElementById('faq-<%= index %>').classList.toggle('hidden')">
                        <%= faq.question %>
                        <i class="fas fa-chevron-down text-gray-400"></i>
                    </button>
                    <div id="faq-<%= index %>" class="hidden px-6 pb-4 text-gray-600">
                        <%- faq.answer %>
                    </div>
                </div>
                <% }) %>
            </div>
        </div>
    </section>
    <% } %>

    <!-- CTA & Footer -->
    <section class="py-20 bg-theme text-white text-center">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-3xl md:text-5xl font-bold mb-6"><%= getVal('cta_title') %></h2>
            <p class="text-xl mb-10 text-white/90"><%- getVal('cta_desc') %></p>
            <div class="flex flex-col sm:flex-row justify-center gap-4">
                <a href="<%= getVal('cta_btn1_url') %>" class="bg-white text-theme text-lg font-bold px-8 py-3 rounded-full shadow hover:bg-gray-100 transition-colors">
                    <%= getVal('cta_btn1_text') %>
                </a>
                <% if(getVal('cta_btn2_text')) { %>
                <a href="<%= getVal('cta_btn2_url') %>" class="bg-transparent border-2 border-white text-white text-lg font-bold px-8 py-3 rounded-full hover:bg-white/10 transition-colors">
                    <%= getVal('cta_btn2_text') %>
                </a>
                <% } %>
            </div>
        </div>
    </section>

    <footer class="bg-gray-900 text-gray-400 py-12 text-center">
        <div class="flex justify-center gap-6 mb-6">
            <% if(settings.facebook_url) { %>
            <a href="<%= settings.facebook_url %>" target="_blank" class="text-gray-400 hover:text-white transition-colors w-6 h-6"><%- settings.facebook_icon %></a>
            <% } %>
            <% if(settings.line_url) { %>
            <a href="<%= settings.line_url %>" target="_blank" class="text-gray-400 hover:text-white transition-colors w-6 h-6"><%- settings.line_icon %></a>
            <% } %>
        </div>
        <p class="text-sm"><%= getVal('footer_text') %></p>
    </footer>

    <!-- ============================================== -->
    <!-- Modal Banner (Swiper Carousel) -->
    <!-- ============================================== -->
    <div id="bannerModal" class="fixed inset-0 z-[100] hidden flex items-center justify-center p-4">
        <!-- Backdrop -->
        <div class="absolute inset-0 bg-black/60 backdrop-blur-sm transition-opacity" onclick="closeBanner()"></div>
        
        <!-- Modal Content -->
        <div class="relative w-full max-w-lg bg-transparent rounded-2xl shadow-2xl overflow-hidden z-10 transform scale-95 opacity-0 transition-all duration-300" id="bannerContent">
            
            <!-- ปุ่มปิดมุมขวาบน -->
            <button onclick="closeBanner()" class="absolute top-2 right-2 z-20 w-8 h-8 flex items-center justify-center rounded-full bg-black/50 text-white hover:bg-black/80 transition-colors">
                <i class="fas fa-times"></i>
            </button>

            <!-- Swiper Container -->
            <div class="swiper mySwiper w-full bg-white">
                <div class="swiper-wrapper">
                    <% bannerSlides.forEach(slide => { %>
                        <div class="swiper-slide">
                            <% if(slide.link) { %><a href="<%= slide.link %>" target="_blank"><% } %>
                                <img src="<%= slide.url %>" alt="Promotion" class="w-full h-auto object-contain max-h-[70vh]">
                            <% if(slide.link) { %></a><% } %>
                        </div>
                    <% }) %>
                </div>
                <!-- Controls -->
                <% if(bannerSlides.length > 1) { %>
                    <div class="swiper-button-next !text-white drop-shadow-md after:!text-2xl"></div>
                    <div class="swiper-button-prev !text-white drop-shadow-md after:!text-2xl"></div>
                    <div class="swiper-pagination"></div>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.css"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.js"></script>
    <script>
        // ระบบจัดการ Banner
        const bannerActive = <%= settings.banner_active === 'true' %>;
        const bannerType = '<%= settings.banner_display_type %>';
        const displayLimit = parseInt('<%= settings.banner_display_limit || 1 %>');
        const bannerVersion = '<%= settings.banner_version || "1" %>';
        const hasSlides = <%= bannerSlides.length > 0 %>;

        function showBanner() {
            const modal = document.getElementById('bannerModal');
            const content = document.getElementById('bannerContent');
            
            modal.classList.remove('hidden');
            // Trigger animation
            setTimeout(() => {
                content.classList.remove('scale-95', 'opacity-0');
                content.classList.add('scale-100', 'opacity-100');
            }, 10);

            // Initialize Swiper
            new Swiper(".mySwiper", {
                loop: <%= bannerSlides.length > 1 %>,
                autoplay: { delay: 4000, disableOnInteraction: false },
                pagination: { el: ".swiper-pagination", clickable: true },
                navigation: { nextEl: ".swiper-button-next", prevEl: ".swiper-button-prev" },
            });
        }

        function closeBanner() {
            const modal = document.getElementById('bannerModal');
            const content = document.getElementById('bannerContent');
            content.classList.remove('scale-100', 'opacity-100');
            content.classList.add('scale-95', 'opacity-0');
            setTimeout(() => { modal.classList.add('hidden'); }, 300);
        }

        // เช็คเงื่อนไขการแสดงผล (Local Storage)
        window.addEventListener('DOMContentLoaded', () => {
            if (!bannerActive || !hasSlides) return;

            const storageKey = `lullapos_banner_${bannerVersion}`;
            const today = new Date().toDateString();
            
            let bannerData = JSON.parse(localStorage.getItem(storageKey) || '{}');

            // ล้างข้อมูลถ้าเป็นวันใหม่
            if (bannerData.date !== today) {
                bannerData = { date: today, count: 0, showed_this_session: false };
            }

            let shouldShow = false;

            if (bannerType === 'always') {
                shouldShow = true;
            } else if (bannerType === 'once_per_session') {
                if (!sessionStorage.getItem('banner_shown')) {
                    shouldShow = true;
                    sessionStorage.setItem('banner_shown', 'true');
                }
            } else if (bannerType === 'limited_times') {
                if (bannerData.count < displayLimit) {
                    shouldShow = true;
                    bannerData.count += 1;
                }
            }

            if (shouldShow) {
                localStorage.setItem(storageKey, JSON.stringify(bannerData));
                setTimeout(showBanner, 1000); // หน่วงเวลา 1 วินาทีก่อนแสดง
            }
        });
    </script>
</body>
</html>