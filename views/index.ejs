<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
<%
  // ลำดับ/การซ่อนของแต่ละส่วน คำนวณตรงนี้เพราะ <head> ต้องรู้ว่าส่วน FAQ ถูกแสดงไหม
  var knownSections = sectionCatalogue.map(function(s) { return s.type; });
  var pageSections = [];
  try { pageSections = JSON.parse(settings.section_order || '[]'); } catch(e) {}
  pageSections = pageSections.filter(function(s) { return knownSections.indexOf(s.type) !== -1; });
  knownSections.forEach(function(type) {
    if (!pageSections.some(function(s) { return s.type === type; })) pageSections.push({ type: type, enabled: true });
  });
  var sectionShown = function(type) {
    var s = pageSections.find(function(x) { return x.type === type; });
    return !!s && s.enabled !== false;
  };

  var siteName = settings.site_name || 'Lullapos';
  var thisPage = (typeof page !== 'undefined' && page) ? page : { is_home: true, title: siteName };
  var thisUrl = (typeof pageUrl !== 'undefined' && pageUrl) ? pageUrl : siteUrl + '/';
  // ข้อความใน structured data ต้องเป็น plain text: ตัดแท็กออกแล้วคืนค่า entity กลับเป็นตัวอักษรจริง
  var stripTags = function(v) {
    return String(v || '')
      .replace(/<[^>]*>/g, ' ')
      .replace(/&nbsp;/g, ' ')
      .replace(/&lt;/g, '<').replace(/&gt;/g, '>')
      .replace(/&quot;/g, '"').replace(/&#0?39;/g, "'").replace(/&apos;/g, "'")
      .replace(/&amp;/g, '&')
      .replace(/\s+/g, ' ').trim();
  };

  var homeFaqs = [];
  try { homeFaqs = JSON.parse(settings.faq_list || '[]'); } catch(e) {}

  var graph = thisPage.is_home ? [
    {
      '@type': 'Organization',
      '@id': siteUrl + '/#organization',
      name: siteName,
      url: siteUrl + '/',
      logo: settings.logo_url,
      sameAs: [settings.facebook_url, settings.line_url].filter(Boolean)
    },
    {
      '@type': 'WebSite',
      '@id': siteUrl + '/#website',
      url: siteUrl + '/',
      name: siteName,
      inLanguage: 'th-TH',
      publisher: { '@id': siteUrl + '/#organization' },
      potentialAction: {
        '@type': 'SearchAction',
        target: { '@type': 'EntryPoint', urlTemplate: siteUrl + '/articles?search={search_term_string}' },
        'query-input': 'required name=search_term_string'
      }
    },
    {
      '@type': 'SoftwareApplication',
      name: settings.seo_title,
      operatingSystem: 'Web Browser',
      applicationCategory: 'BusinessApplication',
      description: settings.seo_description,
      url: siteUrl + '/',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'THB' },
      publisher: { '@id': siteUrl + '/#organization' }
    }
  ] : [
    {
      '@type': 'WebPage',
      '@id': thisUrl + '#page',
      url: thisUrl,
      name: settings.seo_title,
      description: settings.seo_description,
      inLanguage: 'th-TH',
      isPartOf: { '@id': siteUrl + '/#website' }
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: siteUrl + '/' },
        { '@type': 'ListItem', position: 2, name: thisPage.title, item: thisUrl }
      ]
    }
  ];

  // ใส่ FAQPage เฉพาะตอนที่ส่วน FAQ แสดงจริงบนหน้า มิฉะนั้นถือว่าเป็น structured data ที่ไม่ตรงกับเนื้อหา
  if (sectionShown('faq') && homeFaqs.length) {
    graph.push({
      '@type': 'FAQPage',
      mainEntity: homeFaqs.map(function(f) {
        return {
          '@type': 'Question',
          name: stripTags(f.question),
          acceptedAnswer: { '@type': 'Answer', text: stripTags(f.answer) }
        };
      })
    });
  }
%>
<%- include('partials/seo/meta', {
      pageTitle: settings.seo_title,
      pageDescription: settings.seo_description,
      pageUrl: thisUrl,
      pageImage: settings.seo_thumbnail_url,
      ogType: 'website'
    }) %>
<meta name="keywords" content="<%= settings.seo_keywords %>">
<%- include('partials/seo/jsonld', { graph: graph }) %>
    
    <script src="https://cdn.tailwindcss.com?plugins=typography"></script>
    
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              primary: '<%= settings.theme_color %>'
            }
          }
        }
      }
    </script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style> body { font-family: 'Prompt', sans-serif; } </style>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-KBN65YV6D1"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-KBN65YV6D1');
    </script>

    <script src="https://cdn.cookiehub.eu/c2/9f66921c.js"></script>
    <script type="text/javascript">
    document.addEventListener("DOMContentLoaded", function(event) {
    var cpm = {};
    window.cookiehub.load(cpm);
    });
    </script>
</head>
<body class="bg-gray-50 text-gray-800">
<%- include('partials/_navbar') %>
<main>

<% pageSections.forEach(function(sec) { %>
  <% if (sec.enabled !== false) { %>
    <% var meta = sectionCatalogue.find(function(s) { return s.type === sec.type; }); %>
<%- include('partials/sections/' + sec.type, { sectionBg: sec.bg || meta.defaultBg }) %>
  <% } %>
<% }); %>
</main>

<footer class="bg-white border-t border-gray-200 py-12">
    <div class="mx-auto max-w-7xl px-6 md:flex md:items-center md:justify-between lg:px-8">
        <div class="flex justify-center space-x-6 md:order-2">
            <% if(settings.facebook_url) { %>
            <a href="<%= settings.facebook_url %>" target="_blank" class="text-gray-400 hover:text-primary transition transform hover:scale-110">
                <span class="sr-only">Facebook</span>
                <div class="h-7 w-7 [&>svg]:w-7 [&>svg]:h-7"><%- settings.facebook_icon %></div>
            </a>
            <% } %>
            <% if(settings.line_url) { %>
            <a href="<%= settings.line_url %>" target="_blank" class="text-gray-400 hover:text-primary transition transform hover:scale-110">
                <span class="sr-only">LINE</span>
                <div class="h-7 w-7 [&>svg]:w-7 [&>svg]:h-7"><%- settings.line_icon %></div>
            </a>
            <% } %>
        </div>
        <div class="mt-8 md:order-1 md:mt-0">
            <p class="text-center text-sm leading-5 text-gray-500"><%= settings.footer_text %></p>
        </div>
    </div>
</footer>

<% if (settings.banner_active === 'true') { %>
    <%
        let parsedBanners = [];
        try { parsedBanners = JSON.parse(settings.banner_list || '[]'); } catch(e) {}

        // สไลด์ที่ยังไม่ได้กรอกอะไรเลยจะกลายเป็นช่องว่างใน carousel จึงตัดทิ้งก่อน
        var slideHasMedia = function(s) { return !!(s && s.img_url && String(s.img_url).trim()); };
        var slideHasText = function(s) {
            return String((s && s.content) || '').replace(/<[^>]*>/g, '').replace(/&nbsp;/g, ' ').trim().length > 0;
        };
        parsedBanners = parsedBanners.filter(function(s) { return slideHasMedia(s) || slideHasText(s); });

        // สไลด์ที่เก็บก่อนมีระบบวิดีโอจะไม่มี media_type จึงเดาจากนามสกุลไฟล์เป็นตัวสำรอง
        var slideIsVideo = function(s) {
            if (s && s.media_type === 'video') return true;
            return /\.(mp4|webm|mov|m4v)(\?|$)/i.test(String((s && s.img_url) || ''));
        };

        // ถ้าไม่มีสไลด์ไหนมีรูปหรือวิดีโอเลย ไม่ต้องแสดง carousel
        var bannerHasMedia = parsedBanners.some(slideHasMedia);
    %>

    <% if (parsedBanners.length > 0 && bannerHasMedia) { %>
        <div id="promo-config" 
              data-type="<%= settings.banner_display_type %>" 
              data-limit="<%= settings.banner_display_limit %>"
              data-version="<%= settings.banner_version %>"
              class="hidden"></div>
    
        <div id="promo-modal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/60 backdrop-blur-sm opacity-0 transition-opacity duration-300">
            <div class="relative scale-95 transform rounded-2xl bg-white shadow-2xl transition-all duration-300 flex flex-col max-h-[90vh] overflow-hidden" id="promo-modal-content"
             style="width: <%= settings.banner_width_percent || 80 %>%; max-width: <%= settings.banner_max_width || 1200 %>px;">
                
                <button id="close-promo" class="absolute right-4 top-4 z-50 rounded-full bg-white/80 p-2 text-gray-500 hover:bg-white hover:text-gray-900 shadow-sm backdrop-blur transition-colors">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
    
                <div class="swiper bannerSwiper w-full h-full flex-grow flex flex-col group">
                    <div class="swiper-wrapper">
                        <% parsedBanners.forEach(function(slide) { %>
                            <div class="swiper-slide flex flex-col h-auto">
                                <% if (slide.img_url) { %>
                                    <div class="relative flex-shrink-0">
                                        <% if (slide.link_url && slide.link_url.trim() !== '') { %>
                                            <a href="<%= slide.link_url %>" target="_blank" class="block transition hover:opacity-90">
                                                <%- include('partials/_promo-media', { slide: slide, isVideo: slideIsVideo(slide) }) %>
                                            </a>
                                        <% } else { %>
                                            <%- include('partials/_promo-media', { slide: slide, isVideo: slideIsVideo(slide) }) %>
                                        <% } %>
                                    </div>
                                <% } %>
                                
                                <% if (slide.content && slide.content !== '<p><br></p>') { %>
                                    <div class="p-6 prose max-w-none flex-grow overflow-y-auto custom-scrollbar">
                                        <%- slide.content %>
                                    </div>
                                <% } %>
                            </div>
                        <% }); %>
                    </div>
                    
                    <% if (parsedBanners.length > 1) { %>
                        <div class="swiper-pagination !bottom-2"></div>
                        
                        <div class="swiper-button-next !text-white !w-10 !h-10 bg-black/40 hover:bg-black/60 rounded-full !right-2 backdrop-blur-sm after:!hidden shadow-lg transition-all">
                            <svg class="w-5 h-5 ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path></svg>
                        </div>
                        
                        <div class="swiper-button-prev !text-white !w-10 !h-10 bg-black/40 hover:bg-black/60 rounded-full !left-2 backdrop-blur-sm after:!hidden shadow-lg transition-all">
                            <svg class="w-5 h-5 mr-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path></svg>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const modal = document.getElementById('promo-modal');
                const modalContent = document.getElementById('promo-modal-content');
                const closeBtn = document.getElementById('close-promo');
                const config = document.getElementById('promo-config');
                
                if (!modal || !config) return;
                const displayType = config.dataset.type;
                const displayLimit = parseInt(config.dataset.limit) || 1;
                const bannerVersion = config.dataset.version;
                
                const storageKey = `promo_views_v${bannerVersion}`;
                let views = parseInt(localStorage.getItem(storageKey) || '0');
                
                const isLoopActive = <%= parsedBanners.length > 1 ? 'true' : 'false' %>;
                const IMAGE_SLIDE_MS = 5000;
                let swiper = null;
                let userInteracted = false;
                let slideTimer = null;

                const clearSlideTimer = () => { if (slideTimer) { clearTimeout(slideTimer); slideTimer = null; } };
                const markInteracted = () => { userInteracted = true; clearSlideTimer(); };

                const stopAllVideos = () => {
                    document.querySelectorAll('video.promo-video').forEach(v => {
                        v.pause();
                        try { v.currentTime = 0; } catch (e) {}
                    });
                };

                const goNext = () => {
                    if (!swiper || userInteracted) return;
                    if (swiper.slides.length > 1) swiper.slideNext();
                };
                const queueAdvance = () => {
                    clearSlideTimer();
                    if (userInteracted) return;
                    slideTimer = setTimeout(goNext, IMAGE_SLIDE_MS);
                };

                // อ่านสไลด์ที่กำลังแสดงจากดัชนีของ Swiper โดยตรง เพราะคลาส swiper-slide-active
                // ยังไม่ถูกอัปเดตในจังหวะที่ event ทำงาน
                const activeSlide = () => {
                    const byIndex = swiper && swiper.slides ? swiper.slides[swiper.activeIndex] : null;
                    return byIndex || document.querySelector('.bannerSwiper .swiper-slide-active');
                };

                // สไลด์วิดีโอคุมจังหวะเอง เล่นจนจบแล้วค่อยเลื่อน ส่วนสไลด์รูปเดินตามตัวจับเวลา
                const syncActiveSlide = () => {
                    if (!swiper) return;
                    clearSlideTimer();
                    stopAllVideos();
                    const active = activeSlide();
                    const video = active ? active.querySelector('video.promo-video') : null;
                    if (!video) { queueAdvance(); return; }
                    const played = video.play();
                    // ถ้าเบราว์เซอร์ปฏิเสธการเล่น ให้สไลด์เดินตามเวลาปกติแทน จะได้ไม่ค้าง
                    if (played && played.catch) played.catch(queueAdvance);
                };

                const showModal = () => {
                    modal.classList.remove('hidden');
                    modal.classList.add('flex');
                    // ไม่ใช้ autoplay ของ Swiper เพราะสไลด์วิดีโอต้องรอจนเล่นจบ จึงคุมจังหวะเองทั้งหมด
                    swiper = new Swiper('.bannerSwiper', {
                        observer: true,
                        observeParents: true,
                        loop: isLoopActive,
                        pagination: { el: '.swiper-pagination', clickable: true },
                        navigation: { nextEl: '.swiper-button-next', prevEl: '.swiper-button-prev' }
                    });
                    // ต้องเป็น transitionEnd ไม่ใช่ slideChange เพราะ slideChange ทำงานก่อน Swiper
                    // จะอัปเดตสไลด์ที่ active ทำให้ไปอ่านสไลด์เดิมแล้ววิดีโอตัวถัดไปไม่ถูกสั่งเล่น
                    swiper.on('slideChangeTransitionEnd', syncActiveSlide);
                    swiper.on('touchStart', markInteracted);
                    document.querySelectorAll('.bannerSwiper .swiper-button-next, .bannerSwiper .swiper-button-prev, .bannerSwiper .swiper-pagination')
                        .forEach(el => el.addEventListener('click', markInteracted));
                    // 'ended' ไม่ bubble จึงต้องดักที่ capture phase เพื่อให้ครอบคลุมสไลด์ที่ Swiper โคลนมา
                    document.querySelector('.bannerSwiper').addEventListener('ended', (e) => {
                        if (!e.target.classList || !e.target.classList.contains('promo-video')) return;
                        if (swiper && !userInteracted && swiper.slides.length > 1) {
                            swiper.slideNext();
                        } else {
                            e.target.currentTime = 0;
                            const again = e.target.play();
                            if (again && again.catch) again.catch(() => {});
                        }
                    }, true);
                    syncActiveSlide();
                    setTimeout(() => {
                        modal.classList.remove('opacity-0');
                        modalContent.classList.remove('scale-95');
                    }, 50);
                    if (displayType === 'limited') {
                        localStorage.setItem(storageKey, (views + 1).toString());
                    }
                };
                const hideModal = () => {
                    clearSlideTimer();
                    stopAllVideos();
                    modal.classList.add('opacity-0');
                    modalContent.classList.add('scale-95');
                    setTimeout(() => {
                        modal.classList.add('hidden');
                        modal.classList.remove('flex');
                    }, 300);
                };
    
                if (displayType === 'always' || views < displayLimit) {
                    setTimeout(showModal, 1500);
                }
    
                closeBtn.addEventListener('click', hideModal);
                modal.addEventListener('click', (e) => {
                    if (e.target === modal) hideModal();
                });
            });
        </script>
        
        <style>
            .custom-scrollbar::-webkit-scrollbar { width: 6px; }
            .custom-scrollbar::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 4px; }
            .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
            .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
            .swiper-pagination-bullet { background: #cbd5e1; opacity: 1; }
            .swiper-pagination-bullet-active { background: #000; }
            
            /* ป้องกันการคลุมทับของ Swiper ต่อลูกศรที่เรากำหนดเอง */
            .swiper-button-next::after, .swiper-button-prev::after {
                display: none !important;
            }
        </style>
    <% } %>
<% } %>

</body>
</html>