<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <title><%= settings.seo_title %></title>
    <meta name="title" content="<%= settings.seo_title %>">
    <meta name="description" content="<%= settings.seo_description %>">
    <meta name="keywords" content="<%= settings.seo_keywords %>">
    
    <link rel="canonical" href="https://lullapos.com/">
    
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://lullapos.com/">
    <meta property="og:title" content="<%= settings.seo_title %>">
    <meta property="og:description" content="<%= settings.seo_description %>">
    <meta property="og:image" content="<%= settings.seo_thumbnail_url %>">
    
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="https://lullapos.com/">
    <meta property="twitter:title" content="<%= settings.seo_title %>">
    <meta property="twitter:description" content="<%= settings.seo_description %>">
    <meta property="twitter:image" content="<%= settings.seo_thumbnail_url %>">

    <link rel="icon" type="image/png" href="<%= settings.favicon_url %>">
    
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "<%= settings.seo_title %>",
      "operatingSystem": "Web Browser",
      "applicationCategory": "BusinessApplication",
      "description": "<%= settings.seo_description %>",
      "url": "https://lullapos.com/",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "THB"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Lullapos",
        "url": "https://lullapos.com/",
        "logo": "<%= settings.logo_url %>"
      }
    }
    </script>
    
    <script src="https://cdn.tailwindcss.com?plugins=typography"></script>
    
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              primary: '<%= settings.theme_color %>'
            }
          }
        }
      }
    </script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style> body { font-family: 'Prompt', sans-serif; } </style>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-KBN65YV6D1"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-KBN65YV6D1');
    </script>
</head>
<body class="bg-gray-50 text-gray-800">
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-T5P828RK" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
 
<main>
<div class="overflow-hidden bg-white py-15 sm:py-30">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mb-12">
        <img src="<%= settings.logo_url %>" alt="Lullapos Logo" class="h-auto w-full max-w-[300px]">
    </div>
    <div class="mx-auto grid max-w-2xl grid-cols-1 gap-x-16 gap-y-16 sm:gap-y-20 lg:mx-0 lg:max-w-none lg:grid-cols-2">
      <div class="lg:pr-[150px] lg:pt-4 relative z-10 bg-white/80 lg:bg-transparent rounded-2xl p-4 lg:p-0">
        <div class="lg:max-w-lg">
          <h1 class="text-base font-semibold leading-7 text-primary"><%= settings.hero_badge %></h1>
          <p class="mt-2 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl"><%= settings.hero_title %></p>
          <div class="mt-6 text-lg leading-8 text-gray-600 prose max-w-none"><%- settings.hero_desc %></div>
          <div class="mt-10 flex items-center gap-x-6">
            <a href="<%= settings.btn_url %>" class="rounded-md bg-primary px-8 py-3.5 <%= settings.btn_size %> font-semibold text-white shadow-sm hover:opacity-80 transition"><%= settings.btn_text %></a>
          </div>
        </div>
      </div>
      <div class="relative flex items-center justify-center mt-10 lg:mt-0">
        <img src="<%= settings.hero_img_url %>" alt="Lullapos Dashboard Screenshot" class="w-full max-w-full lg:max-w-none lg:w-[57rem] rounded-xl shadow-2xl ring-1 ring-gray-400/10 md:-ml-4 lg:-ml-0">
      </div>
    </div>
  </div>
</div>

<div class="bg-primary-50 py-24 sm:py-32">
