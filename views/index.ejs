<!-- ========================================== -->
<!-- Promotional Banner Modal -->
<!-- ========================================== -->
<% if (settings.banner_active === 'true') { %>
<div id="promo-modal" class="relative z-50 hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
  <div class="fixed inset-0 bg-gray-900 bg-opacity-60 transition-opacity backdrop-blur-sm"></div>
  <div class="fixed inset-0 z-10 overflow-y-auto">
    <div class="flex min-h-full items-center justify-center p-4 text-center sm:p-0">
      <div class="relative transform overflow-hidden rounded-2xl bg-white text-left shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-lg scale-95 opacity-0" id="modal-content-box">
        
        <button type="button" id="close-modal-btn" class="absolute top-4 right-4 z-20 flex h-8 w-8 items-center justify-center rounded-full bg-black/10 text-gray-700 hover:bg-black/20 hover:text-gray-900 transition backdrop-blur-md">
            <span class="sr-only">ปิดหน้าต่าง</span>
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>

        <% if (settings.banner_img_url) { %>
        <div class="relative">
            <img src="<%= settings.banner_img_url %>" alt="Promotion" class="w-full h-auto object-cover max-h-[300px]">
            <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
        </div>
        <% } %>
        
        <div class="px-6 py-8">
          <div class="prose prose-sm max-w-none text-gray-700">
              <%- settings.banner_content %>
          </div>
          <div class="mt-8 flex justify-center">
              <button type="button" id="close-modal-btn-bottom" class="rounded-full bg-primary px-8 py-2.5 text-sm font-semibold text-white shadow-sm hover:opacity-80 transition w-full sm:w-auto">รับทราบ</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const displayType = '<%= settings.banner_display_type %>';
        const displayLimit = parseInt('<%= settings.banner_display_limit %>', 10) || 1;
        
        // 👇 เปลี่ยนมาใช้ Key ที่มีเวอร์ชันพ่วงท้าย หากมีการเซฟหลังบ้านใหม่ Key นี้จะเปลี่ยนไป ทำให้เริ่มนับ 0 ใหม่
        const storageKey = 'lullapos_promo_count_<%= settings.banner_version || "default" %>';
        
        let showCount = parseInt(localStorage.getItem(storageKey) || '0', 10);
        let shouldShow = false;
        
        if (displayType === 'always') {
            shouldShow = true;
        } else if (displayType === 'limited' && showCount < displayLimit) {
            shouldShow = true;
        }

        if (shouldShow) {
            const modal = document.getElementById('promo-modal');
            const modalBox = document.getElementById('modal-content-box');
            
            setTimeout(() => {
                modal.classList.remove('hidden');
                setTimeout(() => {
                    modalBox.classList.remove('scale-95', 'opacity-0');
                    modalBox.classList.add('scale-100', 'opacity-100');
                }, 10);
            }, 1000); 
            
            const closeModal = () => {
                modalBox.classList.remove('scale-100', 'opacity-100');
                modalBox.classList.add('scale-95', 'opacity-0');
                setTimeout(() => { modal.classList.add('hidden'); }, 300);
                
                // อัปเดตจำนวนครั้งที่ดูเฉพาะเวอร์ชันปัจจุบัน
                if (displayType === 'limited') {
                    localStorage.setItem(storageKey, showCount + 1);
                }
            };

            document.getElementById('close-modal-btn').addEventListener('click', closeModal);
            document.getElementById('close-modal-btn-bottom').addEventListener('click', closeModal);
        }
    });
</script>
<% } %>

</body>
