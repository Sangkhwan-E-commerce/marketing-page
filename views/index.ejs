      </dl>
    </div>
  </div>
</div>

<div class="relative bg-white">
  <img class="h-56 w-full bg-gray-50 object-cover lg:absolute lg:inset-y-0 lg:left-0 lg:h-full lg:w-1/2" src="<%= settings.stats_img_url %>" alt="Lullapos Mission">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl lg:mx-0 lg:max-w-xl lg:pt-32 lg:pb-32 lg:pl-16 xl:pl-32 lg:ml-auto">
      <h2 class="text-base font-semibold leading-7 text-primary"><%= settings.stats_badge %></h2>
      <p class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl"><%= settings.stats_title %></p>
      <div class="mt-6 text-base leading-7 text-gray-600 prose max-w-none"><%- settings.stats_desc %></div>
      <dl class="mt-10 grid max-w-xl grid-cols-1 gap-8 sm:mt-16 sm:grid-cols-2 xl:mt-16">
        <div class="flex flex-col gap-y-3 border-l border-gray-200 pl-6"><dt class="text-sm leading-6 text-gray-600"><%= settings.stat1_label %></dt><dd class="order-first text-3xl font-semibold tracking-tight text-gray-900"><%= settings.stat1_value %></dd></div>
        <div class="flex flex-col gap-y-3 border-l border-gray-200 pl-6"><dt class="text-sm leading-6 text-gray-600"><%= settings.stat2_label %></dt><dd class="order-first text-3xl font-semibold tracking-tight text-gray-900"><%= settings.stat2_value %></dd></div>
        <div class="flex flex-col gap-y-3 border-l border-gray-200 pl-6"><dt class="text-sm leading-6 text-gray-600"><%= settings.stat3_label %></dt><dd class="order-first text-3xl font-semibold tracking-tight text-gray-900"><%= settings.stat3_value %></dd></div>
        <div class="flex flex-col gap-y-3 border-l border-gray-200 pl-6"><dt class="text-sm leading-6 text-gray-600"><%= settings.stat4_label %></dt><dd class="order-first text-3xl font-semibold tracking-tight text-gray-900"><%= settings.stat4_value %></dd></div>
      </dl>
    </div>
  </div>
</div>

<% if (typeof latest_articles !== 'undefined' && latest_articles.length > 0) { %>
<div class="bg-white py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">ความรู้และเทคนิคธุรกิจ</h2>
      <p class="mt-2 text-lg leading-8 text-gray-600">เคล็ดลับการจัดการร้านค้า และเทคนิคเพิ่มยอดขายที่ผู้ประกอบการควรรู้</p>
    </div>
    
    <div class="mx-auto mt-16 grid max-w-2xl grid-cols-1 gap-x-8 gap-y-16 lg:mx-0 lg:max-w-none lg:grid-cols-3">
      <% latest_articles.forEach(function(article) { %>
      <article class="flex flex-col items-start justify-between bg-gray-50 p-6 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition">
        <div class="relative w-full">
          <% if(article.cover_image) { %>
          <img src="<%= article.cover_image %>" alt="<%= article.title %>" class="aspect-[16/9] w-full rounded-2xl bg-gray-100 object-cover sm:aspect-[2/1] lg:aspect-[3/2]">
          <% } else { %>
          <div class="aspect-[16/9] w-full rounded-2xl bg-gray-200 flex items-center justify-center text-gray-400">ไม่มีรูปภาพ</div>
          <% } %>
          <div class="absolute inset-0 rounded-2xl ring-1 ring-inset ring-gray-900/10"></div>
        </div>
        <div class="max-w-xl w-full">
          <div class="mt-8 flex items-center gap-x-4 text-xs">
            <time datetime="<%= article.created_at %>" class="text-gray-500"><%= new Date(article.created_at).toLocaleDateString('th-TH') %></time>
            <% if(article.category_name) { %><span class="relative z-10 rounded-full bg-primary/10 px-3 py-1.5 font-medium text-primary"><%= article.category_name %></span><% } %>
          </div>
          <div class="group relative">
            <h3 class="mt-3 text-lg font-semibold leading-6 text-gray-900 group-hover:text-gray-600">
              <a href="/article/<%= encodeURIComponent(article.slug) %>"><span class="absolute inset-0"></span><%= article.title %></a>
            </h3>
            <p class="mt-5 line-clamp-3 text-sm leading-6 text-gray-600"><%= article.seo_description %></p>
          </div>
        </div>
      </article>
      <% }); %>
    </div>
    
    <div class="mt-16 flex justify-center">
        <a href="/articles" class="rounded-full bg-white px-8 py-3.5 text-sm font-semibold text-primary shadow-sm ring-1 ring-inset ring-primary hover:bg-primary hover:text-white transition-all transform hover:-translate-y-1">
            ดูบทความทั้งหมด <span aria-hidden="true">&rarr;</span>
        </a>
    </div>

  </div>
</div>
<% } %>

<div class="bg-gray-50 py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto text-center mb-12">
      <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl"><%= settings.faq_title %></h2>
    </div>
    
    <dl class="mx-auto grid max-w-6xl grid-cols-1 gap-6 md:grid-cols-2">
      <% 
          let faqs = [];
          try { faqs = JSON.parse(settings.faq_list); } catch(e) {}
          faqs.forEach(function(faq, index) { 
      %>
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-200 faq-item self-start hover:shadow-md transition-shadow">
        <dt>
          <button type="button" class="faq-toggle-btn flex w-full items-start justify-between text-left text-gray-900 focus:outline-none transition-colors hover:text-primary">
            <span class="text-base font-semibold leading-7 pr-4 flex items-center gap-3"><%- faq.question %></span>
            <span class="flex h-7 items-center shrink-0">
              <svg class="h-5 w-5 faq-icon-plus transition-transform duration-200 text-gray-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m6-6H6" /></svg>
              <svg class="h-5 w-5 hidden faq-icon-minus text-primary transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M18 12H6" /></svg>
            </span>
          </button>
        </dt>
        <dd class="mt-4 hidden faq-answer transition-all duration-300 border-t border-gray-100 pt-4">
          <div class="text-base leading-7 text-gray-600 prose max-w-none"><%- faq.answer %></div>
        </dd>
      </div>
      <% }); %>
    </dl>
  </div>
</div>

<script>
    const faqButtons = document.querySelectorAll('.faq-toggle-btn');
    faqButtons.forEach(button => {
        button.addEventListener('click', () => {
            const answer = button.parentElement.nextElementSibling;
            const iconPlus = button.querySelector('.faq-icon-plus');
            const iconMinus = button.querySelector('.faq-icon-minus');
            const isOpen = !answer.classList.contains('hidden');
            
            document.querySelectorAll('.faq-answer').forEach(ans => ans.classList.add('hidden'));
            document.querySelectorAll('.faq-icon-plus').forEach(icon => icon.classList.remove('hidden'));
            document.querySelectorAll('.faq-icon-minus').forEach(icon => icon.classList.add('hidden'));
            
            if (!isOpen) {
                answer.classList.remove('hidden');
                iconPlus.classList.add('hidden');
                iconMinus.classList.remove('hidden');
            }
        });
    });
</script>

<div class="bg-red-50 py-16 sm:py-24 lg:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl"><%= settings.cta_title %></h2>
      <div class="mx-auto mt-6 text-lg leading-8 text-gray-600 prose max-w-none"><%- settings.cta_desc %></div>
      <div class="mt-10 flex items-center justify-center gap-x-6">
        <a href="<%= settings.cta_btn1_url %>" class="rounded-md bg-primary px-8 py-3.5 text-sm font-semibold text-white shadow-sm hover:opacity-80 transition"><%= settings.cta_btn1_text %></a>
        <a href="<%= settings.cta_btn2_url %>" class="text-sm font-semibold leading-6 text-gray-900 group"><%= settings.cta_btn2_text %> <span aria-hidden="true" class="group-hover:translate-x-1 inline-block transition-transform">→</span></a>
      </div>
    </div>
  </div>
</div>
</main>

<footer class="bg-white border-t border-gray-200 py-12">
    <div class="mx-auto max-w-7xl px-6 md:flex md:items-center md:justify-between lg:px-8">
        <div class="flex justify-center space-x-6 md:order-2">
            <% if(settings.facebook_url) { %>
            <a href="<%= settings.facebook_url %>" target="_blank" class="text-gray-400 hover:text-primary transition transform hover:scale-110">
                <span class="sr-only">Facebook</span>
                <div class="h-7 w-7 [&>svg]:w-7 [&>svg]:h-7"><%- settings.facebook_icon %></div>
            </a>
            <% } %>
            <% if(settings.line_url) { %>
            <a href="<%= settings.line_url %>" target="_blank" class="text-gray-400 hover:text-primary transition transform hover:scale-110">
                <span class="sr-only">LINE</span>
                <div class="h-7 w-7 [&>svg]:w-7 [&>svg]:h-7"><%- settings.line_icon %></div>
            </a>
            <% } %>
        </div>
        <div class="mt-8 md:order-1 md:mt-0">
            <p class="text-center text-sm leading-5 text-gray-500"><%= settings.footer_text %></p>
        </div>
    </div>
</footer>

<% if (settings.banner_active === 'true') { %>
    <% 
        let parsedBanners = [];
        try { parsedBanners = JSON.parse(settings.banner_list || '[]'); } catch(e) {}
    %>
    
    <% if (parsedBanners.length > 0) { %>
        <div id="promo-config" 
              data-type="<%= settings.banner_display_type %>" 
              data-limit="<%= settings.banner_display_limit %>"
              data-version="<%= settings.banner_version %>"
              class="hidden"></div>
    
        <div id="promo-modal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/60 backdrop-blur-sm opacity-0 transition-opacity duration-300">
            <div class="relative w-full max-w-lg scale-95 transform rounded-2xl bg-white shadow-2xl transition-all duration-300 flex flex-col max-h-[90vh] overflow-hidden" id="promo-modal-content">
                
                <button id="close-promo" class="absolute right-4 top-4 z-50 rounded-full bg-white/80 p-2 text-gray-500 hover:bg-white hover:text-gray-900 shadow-sm backdrop-blur transition-colors">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
    
                <div class="swiper bannerSwiper w-full h-full flex-grow flex flex-col group">
                    <div class="swiper-wrapper">
                        <% parsedBanners.forEach(function(slide) { %>
                            <div class="swiper-slide flex flex-col h-auto">
                                <% if (slide.img_url) { %>
                                    <div class="relative flex-shrink-0">
                                        <% if (slide.link_url && slide.link_url.trim() !== '') { %>
                                            <a href="<%= slide.link_url %>" target="_blank" class="block transition hover:opacity-90">
                                                <img src="<%= slide.img_url %>" alt="Promotion" class="w-full h-auto object-cover max-h-[350px]">
                                            </a>
                                        <% } else { %>
                                            <img src="<%= slide.img_url %>" alt="Promotion" class="w-full h-auto object-cover max-h-[350px]">
                                        <% } %>
                                    </div>
                                <% } %>
                                
                                <% if (slide.content && slide.content !== '<p><br></p>') { %>
                                    <div class="p-6 prose max-w-none flex-grow overflow-y-auto custom-scrollbar">
                                        <%- slide.content %>
                                    </div>
                                <% } %>
                            </div>
                        <% }); %>
                    </div>
                    
                    <% if (parsedBanners.length > 1) { %>
                        <div class="swiper-pagination !bottom-2"></div>
                        
                        <div class="swiper-button-next !text-white !w-10 !h-10 bg-black/40 hover:bg-black/60 rounded-full !right-2 backdrop-blur-sm after:!hidden shadow-lg transition-all">
                            <svg class="w-5 h-5 ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path></svg>
                        </div>
                        
                        <div class="swiper-button-prev !text-white !w-10 !h-10 bg-black/40 hover:bg-black/60 rounded-full !left-2 backdrop-blur-sm after:!hidden shadow-lg transition-all">
                            <svg class="w-5 h-5 mr-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path></svg>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const modal = document.getElementById('promo-modal');
                const modalContent = document.getElementById('promo-modal-content');
                const closeBtn = document.getElementById('close-promo');
                const config = document.getElementById('promo-config');
                
                if (!modal || !config) return;
                const displayType = config.dataset.type;
                const displayLimit = parseInt(config.dataset.limit) || 1;
                const bannerVersion = config.dataset.version;
                
                const storageKey = `promo_views_v${bannerVersion}`;
                let views = parseInt(localStorage.getItem(storageKey) || '0');
                
                const isLoopActive = <%= parsedBanners.length > 1 ? 'true' : 'false' %>;
                const showModal = () => {
                    modal.classList.remove('hidden');
                    modal.classList.add('flex');
                    new Swiper('.bannerSwiper', {
                        observer: true,
                        observeParents: true,
                        loop: isLoopActive,
                        pagination: { el: '.swiper-pagination', clickable: true },
                        navigation: { nextEl: '.swiper-button-next', prevEl: '.swiper-button-prev' },
                        autoplay: { delay: 5000, disableOnInteraction: true }
                    });
                    setTimeout(() => {
                        modal.classList.remove('opacity-0');
                        modalContent.classList.remove('scale-95');
                    }, 50);
                    if (displayType === 'limited') {
                        localStorage.setItem(storageKey, (views + 1).toString());
                    }
                };
                const hideModal = () => {
                    modal.classList.add('opacity-0');
                    modalContent.classList.add('scale-95');
                    setTimeout(() => {
                        modal.classList.add('hidden');
                        modal.classList.remove('flex');
                    }, 300);
                };
    
                if (displayType === 'always' || views < displayLimit) {
                    setTimeout(showModal, 1500);
                }
    
                closeBtn.addEventListener('click', hideModal);
                modal.addEventListener('click', (e) => {
                    if (e.target === modal) hideModal();
                });
            });
        </script>
        
        <style>
            .custom-scrollbar::-webkit-scrollbar { width: 6px; }
            .custom-scrollbar::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 4px; }
            .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
            .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
            .swiper-pagination-bullet { background: #cbd5e1; opacity: 1; }
            .swiper-pagination-bullet-active { background: #000; }
            
            /* ป้องกันการคลุมทับของ Swiper ต่อลูกศรที่เรากำหนดเอง */
            .swiper-button-next::after, .swiper-button-prev::after {
                display: none !important;
            }
        </style>
    <% } %>
<% } %>

</body>
</html>