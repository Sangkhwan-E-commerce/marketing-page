<!-- Mission & Stats Section (Split with Image) -->
<div class="relative bg-white">
  <!-- ฝั่งซ้าย: รูปภาพ (จะเต็มจอบนมือถือ และแบ่งครึ่งซ้ายบนคอมพิวเตอร์) -->
  <img class="h-56 w-full bg-gray-50 object-cover lg:absolute lg:inset-y-0 lg:left-0 lg:h-full lg:w-1/2" src="<%= settings.stats_img_url %>" alt="Lullapos Mission">
  
  <!-- ฝั่งขวา: เนื้อหาและสถิติ -->
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl lg:mx-0 lg:max-w-xl lg:pt-32 lg:pb-32 lg:pl-16 xl:pl-32 lg:ml-auto">
      <h2 class="text-base font-semibold leading-7 text-primary"><%= settings.stats_badge %></h2>
      <p class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl"><%= settings.stats_title %></p>
      
      <!-- ใช้ <%- %> และ prose สำหรับ Text Editor -->
      <div class="mt-6 text-base leading-7 text-gray-600 prose max-w-none"><%- settings.stats_desc %></div>
      
      <dl class="mt-10 grid max-w-xl grid-cols-1 gap-8 sm:mt-16 sm:grid-cols-2 xl:mt-16">
        <!-- สถิติที่ 1 -->
        <div class="flex flex-col gap-y-3 border-l border-gray-200 pl-6">
          <dt class="text-sm leading-6 text-gray-600"><%= settings.stat1_label %></dt>
          <dd class="order-first text-3xl font-semibold tracking-tight text-gray-900"><%= settings.stat1_value %></dd>
        </div>
        <!-- สถิติที่ 2 -->
        <div class="flex flex-col gap-y-3 border-l border-gray-200 pl-6">
          <dt class="text-sm leading-6 text-gray-600"><%= settings.stat2_label %></dt>
          <dd class="order-first text-3xl font-semibold tracking-tight text-gray-900"><%= settings.stat2_value %></dd>
        </div>
        <!-- สถิติที่ 3 -->
        <div class="flex flex-col gap-y-3 border-l border-gray-200 pl-6">
          <dt class="text-sm leading-6 text-gray-600"><%= settings.stat3_label %></dt>
          <dd class="order-first text-3xl font-semibold tracking-tight text-gray-900"><%= settings.stat3_value %></dd>
        </div>
        <!-- สถิติที่ 4 -->
        <div class="flex flex-col gap-y-3 border-l border-gray-200 pl-6">
          <dt class="text-sm leading-6 text-gray-600"><%= settings.stat4_label %></dt>
          <dd class="order-first text-3xl font-semibold tracking-tight text-gray-900"><%= settings.stat4_value %></dd>
        </div>
      </dl>
    </div>
  </div>
</div>

<!-- FAQ Section (Centered Accordion) -->
<div class="bg-gray-50 py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-4xl divide-y divide-gray-900/10">
      <h2 class="text-2xl font-bold leading-10 tracking-tight text-gray-900"><%= settings.faq_title %></h2>
      <dl class="mt-10 space-y-6 divide-y divide-gray-900/10">
        
        <% 
            let faqs = [];
            try { faqs = JSON.parse(settings.faq_list); } catch(e) {}
            faqs.forEach(function(faq, index) { 
        %>
        <div class="pt-6 faq-item">
          <dt>
            <!-- ปุ่มกดเพื่อเปิด/ปิด -->
            <button type="button" class="faq-toggle-btn flex w-full items-start justify-between text-left text-gray-900 focus:outline-none transition-colors hover:text-primary">
              <span class="text-base font-semibold leading-7"><%= faq.question %></span>
              <span class="ml-6 flex h-7 items-center">
                <!-- Icon: Plus (แสดงตอนปิด) -->
                <svg class="h-6 w-6 faq-icon-plus transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m6-6H6" />
                </svg>
                <!-- Icon: Minus (แสดงตอนเปิด - ซ่อนเป็นค่าเริ่มต้น) -->
                <svg class="h-6 w-6 hidden faq-icon-minus text-primary transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M18 12H6" />
                </svg>
              </span>
            </button>
          </dt>
          <!-- ส่วนคำตอบ (ซ่อนเป็นค่าเริ่มต้น) -->
          <dd class="mt-2 pr-12 hidden faq-answer transition-all duration-300">
            <div class="text-base leading-7 text-gray-600 prose max-w-none"><%- faq.answer %></div>
          </dd>
        </div>
        <% }); %>

      </dl>
    </div>
  </div>
</div>

<!-- Script สำหรับเปิด/ปิด Accordion -->
<!-- Script สำหรับเปิด/ปิด Accordion (เปิดได้ทีละข้อ) -->
<script>
    const faqButtons = document.querySelectorAll('.faq-toggle-btn');
    
    faqButtons.forEach(button => {
        button.addEventListener('click', () => {
            const answer = button.parentElement.nextElementSibling;
            const iconPlus = button.querySelector('.faq-icon-plus');
            const iconMinus = button.querySelector('.faq-icon-minus');
            
            // เช็คว่าข้อนี้กำลังเปิดอยู่หรือไม่
            const isOpen = !answer.classList.contains('hidden');
            
            // 1. ปิดทุกข้อก่อนเสมอ
            document.querySelectorAll('.faq-answer').forEach(ans => ans.classList.add('hidden'));
            document.querySelectorAll('.faq-icon-plus').forEach(icon => icon.classList.remove('hidden'));
            document.querySelectorAll('.faq-icon-minus').forEach(icon => icon.classList.add('hidden'));
            
            // 2. ถ้าข้อที่กดไม่ได้เปิดอยู่แต่แรก ให้เปิดขึ้นมา
            if (!isOpen) {
                answer.classList.remove('hidden');
                iconPlus.classList.add('hidden');
                iconMinus.classList.remove('hidden');
            }
        });
    });
</script>

<!-- CTA Section (Simple Centered) -->
<div class="bg-blue-50 py-16 sm:py-24 lg:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      
      <!-- หัวข้อ CTA -->
      <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl"><%= settings.cta_title %></h2>
      
      <!-- รายละเอียด (แสดงผล HTML จาก Text Editor) -->
      <div class="mx-auto mt-6 text-lg leading-8 text-gray-600 prose max-w-none">
        <%- settings.cta_desc %>
      </div>
      
      <!-- ส่วนปุ่มและลิงก์ -->
      <div class="mt-10 flex items-center justify-center gap-x-6">
        <!-- ปุ่มหลัก -->
        <a href="<%= settings.cta_btn1_url %>" class="rounded-md bg-primary px-8 py-3.5 text-sm font-semibold text-white shadow-sm hover:opacity-80 transition">
          <%= settings.cta_btn1_text %>
        </a>
        <!-- ปุ่มรอง (ลิงก์ลูกศร) -->
        <a href="<%= settings.cta_btn2_url %>" class="text-sm font-semibold leading-6 text-gray-900 group">
          <%= settings.cta_btn2_text %> <span aria-hidden="true" class="group-hover:translate-x-1 inline-block transition-transform">→</span>
        </a>
      </div>
      
    </div>
  </div>
</div>

<!-- Footer Section -->
<footer class="bg-white border-t border-gray-200 py-12">
    <div class="mx-auto max-w-7xl px-6 md:flex md:items-center md:justify-between lg:px-8">
        
        <!-- Social Media Icons -->
        <div class="flex justify-center space-x-6 md:order-2">
            
            <% if(settings.facebook_url) { %>
            <a href="<%= settings.facebook_url %>" target="_blank" class="text-gray-400 hover:text-primary transition transform hover:scale-110">
                <span class="sr-only">Facebook</span>
                <!-- ไอคอนเปลี่ยนตามที่ตั้งค่าไว้ -->
                <div class="h-7 w-7 [&>svg]:w-7 [&>svg]:h-7"><%- settings.facebook_icon %></div>
            </a>
            <% } %>

            <% if(settings.line_url) { %>
            <a href="<%= settings.line_url %>" target="_blank" class="text-gray-400 hover:text-primary transition transform hover:scale-110">
                <span class="sr-only">LINE</span>
                <!-- ไอคอนเปลี่ยนตามที่ตั้งค่าไว้ -->
                <div class="h-7 w-7 [&>svg]:w-7 [&>svg]:h-7"><%- settings.line_icon %></div>
            </a>
            <% } %>
        </div>

        <!-- Copyright Text -->
        <div class="mt-8 md:order-1 md:mt-0">
            <p class="text-center text-sm leading-5 text-gray-500"><%= settings.footer_text %></p>
        </div>
        
    </div>
</footer>

</body>
</html>