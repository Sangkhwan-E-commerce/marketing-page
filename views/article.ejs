<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= article.title %> - Lullapos</title>
    <meta name="description" content="<%= article.seo_description || settings.seo_description %>">
    
    <link rel="canonical" href="https://lullapos.com/article/<%= encodeURIComponent(article.slug) %>">
    <meta property="og:type" content="article">
    <meta property="og:url" content="https://lullapos.com/article/<%= encodeURIComponent(article.slug) %>">
    <meta property="og:title" content="<%= article.title %>">
    <meta property="og:description" content="<%= article.seo_description || '' %>">
    <% if(article.cover_image) { %><meta property="og:image" content="<%= article.cover_image %>"><% } %>

    <link rel="icon" type="image/png" href="<%= settings.favicon_url %>">
    
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "<%= article.title %>",
      "image": "<%= article.cover_image || settings.seo_thumbnail_url %>",
      "author": { "@type": "Organization", "name": "Lullapos" },
      "publisher": { "@type": "Organization", "name": "Lullapos", "logo": { "@type": "ImageObject", "url": "<%= settings.logo_url %>" } }
    }
    </script>
    
    <script src="https://cdn.tailwindcss.com?plugins=typography"></script>
    <script> tailwind.config = { theme: { extend: { colors: { primary: '<%= settings.theme_color %>' } } } } </script>
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style> body { font-family: 'Prompt', sans-serif; } </style>
</head>
<body class="bg-gray-50 text-gray-800 flex flex-col min-h-screen">

    <header class="bg-white shadow-sm border-b border-gray-200 sticky top-0 z-50">
        <div class="mx-auto max-w-7xl px-6 h-16 flex items-center justify-between">
            <a href="/" class="hover:opacity-80 transition"><img src="<%= settings.logo_url %>" alt="Lullapos" class="h-8 w-auto"></a>
            <div class="flex space-x-4">
                <a href="/articles" class="text-sm font-semibold text-gray-600 hover:text-primary transition flex items-center">อ่านบทความทั้งหมด</a>
                <a href="/" class="text-sm font-semibold text-primary bg-primary/10 px-4 py-2 rounded-full hover:bg-primary/20 transition hidden sm:inline-block">กลับหน้าหลัก</a>
            </div>
        </div>
    </header>

    <main class="flex-grow pt-10 pb-16">
        <article class="mx-auto max-w-3xl px-6 lg:px-8">
            <div class="text-center mb-10">
                <% if(article.category_name) { %>
                    <span class="text-xs font-bold tracking-widest text-primary uppercase bg-primary/10 px-3 py-1 rounded-full"><%= article.category_name %></span>
                <% } %>
                <h1 class="mt-6 text-3xl font-bold tracking-tight text-gray-900 sm:text-5xl leading-tight"><%= article.title %></h1>
                <p class="mt-4 text-sm text-gray-500">เผยแพร่เมื่อ: <%= new Date(article.created_at).toLocaleDateString('th-TH', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
            </div>

            <% if(article.cover_image) { %>
                <img src="<%= article.cover_image %>" alt="<%= article.title %>" class="w-full rounded-2xl shadow-md mb-12 object-cover aspect-video">
            <% } %>

            <div class="prose prose-lg prose-blue max-w-none mx-auto prose-img:rounded-xl prose-img:shadow-sm">
                <%- article.content %>
            </div>
            
            <div class="mt-16 pt-10 border-t border-gray-200 text-center">
                <h3 class="text-2xl font-bold mb-6 text-gray-900"><%= settings.article_cta_title %></h3>
                <a href="<%= settings.article_cta_btn_url %>" class="inline-block bg-primary text-white font-bold px-10 py-4 rounded-full hover:opacity-90 shadow-lg transition transform hover:-translate-y-1">
                    <%= settings.article_cta_btn_text %>
                </a>
            </div>
        </article>
    </main>

    <% if (typeof related_articles !== 'undefined' && related_articles.length > 0) { %>
    <section class="bg-white py-16 border-t border-gray-100">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
            <div class="mb-10 flex items-center justify-between">
                <h2 class="text-2xl font-bold tracking-tight text-gray-900">บทความที่น่าสนใจเพิ่มเติม</h2>
                <a href="/articles" class="text-sm font-semibold text-primary hover:underline hidden sm:block">ดูทั้งหมด &rarr;</a>
            </div>
            <div class="mx-auto grid max-w-2xl grid-cols-1 gap-x-8 gap-y-12 lg:mx-0 lg:max-w-none lg:grid-cols-3">
                <% related_articles.forEach(function(relArticle) { %>
                <article class="flex flex-col items-start justify-between bg-gray-50 p-5 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition">
                    <div class="relative w-full">
                        <% if(relArticle.cover_image) { %>
                            <img src="<%= relArticle.cover_image %>" alt="<%= relArticle.title %>" class="aspect-[16/9] w-full rounded-xl bg-gray-200 object-cover">
                        <% } else { %>
                            <div class="aspect-[16/9] w-full rounded-xl bg-gray-200 flex items-center justify-center text-gray-400 text-sm">ไม่มีรูปภาพ</div>
                        <% } %>
                        <div class="absolute inset-0 rounded-xl ring-1 ring-inset ring-gray-900/10"></div>
                    </div>
                    <div class="max-w-xl w-full">
                        <div class="mt-6 flex items-center gap-x-4 text-xs">
                            <time datetime="<%= relArticle.created_at %>" class="text-gray-500"><%= new Date(relArticle.created_at).toLocaleDateString('th-TH') %></time>
                            <% if(relArticle.category_name) { %><span class="relative z-10 rounded-full bg-white border border-gray-200 px-2.5 py-0.5 font-medium text-gray-600"><%= relArticle.category_name %></span><% } %>
                        </div>
                        <div class="group relative">
                            <h3 class="mt-3 text-base font-semibold leading-6 text-gray-900 group-hover:text-primary transition-colors line-clamp-2">
                                <a href="/article/<%= encodeURIComponent(relArticle.slug) %>"><span class="absolute inset-0"></span><%= relArticle.title %></a>
                            </h3>
                            <p class="mt-2 line-clamp-2 text-sm leading-6 text-gray-600"><%= relArticle.seo_description %></p>
                        </div>
                    </div>
                </article>
                <% }); %>
            </div>
            <div class="mt-10 text-center sm:hidden">
                <a href="/articles" class="text-sm font-semibold text-primary hover:underline">ดูบทความทั้งหมด &rarr;</a>
            </div>
        </div>
    </section>
    <% } %>

    <footer class="bg-gray-50 border-t border-gray-200 py-8 mt-auto">
        <div class="mx-auto max-w-7xl px-6 text-center text-sm text-gray-500"><%= settings.footer_text %></div>
    </footer>
</body>
</html>