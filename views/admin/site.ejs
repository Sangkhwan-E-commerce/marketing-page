                            <button type="submit" class="inline-flex items-center rounded-md bg-primary px-6 py-2.5 text-sm font-bold text-white shadow-sm hover:opacity-90 transition">
                                💾 บันทึกการเปลี่ยนแปลง
                            </button>
                        </div>
                    </div>

                    <div class="p-6">

                        <div id="tab-general" class="tab-content space-y-6">
                            <div><label class="block text-sm font-medium text-gray-700 mb-1">ชื่อเว็บไซต์ (ใช้ใน og:site_name และท้ายชื่อหน้าบทความ)</label><input type="text" name="site_name" value="<%= settings.site_name %>" class="w-full border-gray-300 rounded-md border p-2 text-sm"></div>
