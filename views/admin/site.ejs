                                        <input type="number" name="banner_width_percent" value="<%= settings.banner_width_percent || 80 %>" min="10" max="100" step="1" class="w-full border-gray-300 rounded-md border p-2 text-sm shadow-sm">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-semibold mb-1">ความกว้างสูงสุด (px)</label>
                                        <input type="number" name="banner_max_width" value="<%= settings.banner_max_width || 1200 %>" min="200" max="3000" step="10" class="w-full border-gray-300 rounded-md border p-2 text-sm shadow-sm">
