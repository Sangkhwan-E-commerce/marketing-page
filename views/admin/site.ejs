                                                <option value="limited" <%= settings.banner_display_type === 'limited' ? 'selected' : '' %>>จำกัดจำนวนครั้งต่อผู้ใช้ 1 คน</option>
                                            </select>
                                        </div>
                                        <div>
                                            <label class="block text-sm font-semibold mb-1">แสดงผลสูงสุด (ครั้ง)</label>
                                            <input type="number" name="banner_display_limit" value="<%= settings.banner_display_limit %>" min="1" class="w-full border-gray-300 rounded-md border p-2 text-sm shadow-sm">
                                        </div>
