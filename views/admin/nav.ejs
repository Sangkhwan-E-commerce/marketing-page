<%- include('_head', { pageTitle: 'Navbar & เมนู' }) %>
<%- include('_sidebar', { adminPage: 'nav', tabs: [] }) %>
<%- include('_topbar', { heading: 'Navbar & เมนู' }) %>

                <form action="/admin/nav/save" method="POST" class="bg-white rounded-xl shadow-sm border border-gray-200">
                    <div class="px-6 py-4 border-b border-gray-200 flex flex-col sm:flex-row sm:items-center sm:justify-between sticky top-0 bg-white z-20 rounded-t-xl">
                        <div>
                            <p class="text-sm text-gray-500">เมนูนี้แสดงบนทุกหน้าของเว็บไซต์</p>
                        </div>
                        <div class="mt-4 sm:mt-0">
                            <button type="submit" class="inline-flex items-center rounded-md bg-primary px-6 py-2.5 text-sm font-bold text-white shadow-sm hover:opacity-90 transition">
                                💾 บันทึกการเปลี่ยนแปลง
                            </button>
                        </div>
                    </div>

                    <div class="p-6 space-y-4">
                        <div class="flex justify-between items-center">
                            <h4 class="font-semibold">รายการเมนู (<span id="nav-count">0</span> รายการ)</h4>
                            <div class="flex items-center gap-2">
                                <button type="button" id="expand-nav-btn" class="text-xs text-gray-600 underline hover:text-primary">กางทั้งหมด</button>
                                <button type="button" id="collapse-nav-btn" class="text-xs text-gray-600 underline hover:text-primary">ยุบทั้งหมด</button>
                                <button type="button" id="add-nav-btn" class="bg-white px-3 py-2 text-sm border rounded hover:bg-gray-50">+ เพิ่มเมนู</button>
                            </div>
                        </div>
                        <p class="text-xs text-gray-500">แต่ละเมนูเพิ่มเมนูย่อยได้ กลายเป็น dropdown อัตโนมัติ — เมนูที่ชี้ไปหน้าที่ถูกลบหรือยังไม่เผยแพร่จะไม่แสดงบนเว็บ</p>
                        <p id="nav-empty" class="text-sm text-gray-500 bg-gray-50 border border-dashed rounded p-4 text-center hidden">ยังไม่มีเมนู กดปุ่ม "+ เพิ่มเมนู" เพื่อเริ่ม</p>
                        <div id="nav-container" class="space-y-4"></div>
                        <input type="hidden" name="nav_items" id="nav_items_input" value="<%= settings.nav_items || '[]' %>">
                    </div>
                </form>

            </div>
        </main>
    </div>

    <%- include('_icon-picker') %>


    <script>
<%- include('_shared-js') %>

        // --- Navbar & เมนู (สองระดับ, แถวยุบ/กางได้) ---
        const NAV_PAGES = <%- JSON.stringify(pages.map(function (p) { return { id: p.id, title: p.title, slug: p.slug, is_home: p.is_home, is_published: p.is_published }; })) %>;

        const navContainer = document.getElementById('nav-container');
        const navInput = document.getElementById('nav_items_input');
        const navEmpty = document.getElementById('nav-empty');
        const navCount = document.getElementById('nav-count');
        let navItems = [];
        try { navItems = JSON.parse(navInput.value || '[]'); } catch (e) { navItems = []; }
        if (!Array.isArray(navItems)) navItems = [];

        const navEsc = (str) => (str || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
        // _open คือสถานะกาง/ยุบของแถว เก็บติดกับตัวรายการเพื่อให้ย้ายลำดับแล้วตามไปด้วย และตัดทิ้งก่อนบันทึก
        const navSync = () => { navInput.value = JSON.stringify(navItems, (k, v) => k === '_open' ? undefined : v); };
        const blankItem = () => ({ label: '', icon: '', type: 'page', page_id: '', url: '', new_tab: false, enabled: true, children: [] });

        // path: [i] สำหรับเมนูหลัก, [i, j] สำหรับเมนูย่อย
        const itemAt = (path) => path.length === 1 ? navItems[path[0]] : navItems[path[0]].children[path[1]];
        const listAt = (path) => path.length === 1 ? navItems : navItems[path[0]].children;
        const pathAttr = (path) => path.join('-');
        const parsePath = (value) => value.split('-').map(Number);

        const NO_NAME = '<span class="font-normal text-gray-400">(ยังไม่ตั้งชื่อ)</span>';

        function targetSummary(item) {
            if (item.type === 'url') return item.url ? item.url : '— ยังไม่ใส่ลิงก์ —';
            const pg = NAV_PAGES.find(p => String(p.id) === String(item.page_id));
            if (!pg) return '— ยังไม่เลือกหน้า —';
            return (pg.is_home ? '/' : '/' + pg.slug) + (pg.is_published ? '' : ' (ยังไม่เผยแพร่)');
        }

        function targetFields(item, path) {
            const options = NAV_PAGES.map(p =>
                `<option value="${p.id}" ${String(item.page_id) === String(p.id) ? 'selected' : ''}>${navEsc(p.title)}${p.is_published ? '' : ' (ยังไม่เผยแพร่)'}</option>`
            ).join('');
            return `
                <select class="w-full border p-2 text-sm" onchange="updateNav('${pathAttr(path)}', 'type', this.value)">
                    <option value="page" ${item.type !== 'url' ? 'selected' : ''}>ลิงก์ไปหน้าในเว็บ</option>
                    <option value="url" ${item.type === 'url' ? 'selected' : ''}>ลิงก์ภายนอก / URL เอง</option>
                </select>
                ${item.type === 'url'
                    ? `<input type="text" class="w-full border p-2 text-sm" placeholder="https://..." value="${navEsc(item.url)}" oninput="updateNav('${pathAttr(path)}', 'url', this.value)">`
                    : `<select class="w-full border p-2 text-sm" onchange="updateNav('${pathAttr(path)}', 'page_id', this.value)"><option value="">— เลือกหน้า —</option>${options}</select>`}
            `;
        }

        function itemRow(item, path, isChild) {
            const list = listAt(path);
            const index = path[path.length - 1];
            const key = pathAttr(path);
            const enabled = item.enabled !== false;
            const open = item._open === true;
            const childCount = (item.children || []).length;

            return `
                <div class="${isChild ? 'bg-white border rounded' : 'bg-white border border-gray-200 rounded-lg shadow-sm'} ${enabled ? '' : 'opacity-60'}">
                    <div class="flex items-center gap-2 px-3 py-2.5 cursor-pointer select-none hover:bg-gray-50 rounded-lg" onclick="toggleRow('${key}')">
                        <svg data-row-caret="${key}" class="h-4 w-4 shrink-0 text-gray-400 transition-transform ${open ? 'rotate-90' : ''}" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                        <span class="shrink-0 text-xs font-bold text-gray-400">${index + 1}</span>
                        ${item.icon ? `<i class="bi ${navEsc(item.icon)} shrink-0 text-primary" aria-hidden="true"></i>` : ''}
                        <span class="flex-1 truncate text-sm font-semibold text-gray-800" data-row-label="${key}">${navEsc(item.label) || NO_NAME}</span>
                        <span class="hidden max-w-[13rem] truncate text-xs text-gray-500 sm:block" data-row-target="${key}">${navEsc(targetSummary(item))}</span>
                        ${childCount ? `<span class="shrink-0 rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600">${childCount} ย่อย</span>` : ''}
                        ${enabled ? '' : '<span class="shrink-0 rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-700">ปิด</span>'}
                        <div class="flex shrink-0 space-x-1" onclick="event.stopPropagation()">
                            ${index > 0 ? `<button type="button" title="เลื่อนขึ้น" onclick="moveNav('${key}', -1)" class="text-blue-600 hover:text-white hover:bg-blue-600 border border-blue-600 font-bold px-2 py-1 rounded text-xs transition">▲</button>` : ''}
                            ${index < list.length - 1 ? `<button type="button" title="เลื่อนลง" onclick="moveNav('${key}', 1)" class="text-blue-600 hover:text-white hover:bg-blue-600 border border-blue-600 font-bold px-2 py-1 rounded text-xs transition">▼</button>` : ''}
                            <button type="button" title="ลบ" onclick="removeNav('${key}')" class="text-red-500 hover:text-white hover:bg-red-500 border border-red-500 font-bold px-2 py-1 rounded text-xs transition">✖</button>
                        </div>
                    </div>

                    <div class="${open ? '' : 'hidden'} space-y-2 border-t border-gray-200 px-3 py-3" data-row-body="${key}">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                            <input type="text" class="border p-2 text-sm" placeholder="ข้อความบนเมนู" value="${navEsc(item.label)}" oninput="updateNav('${key}', 'label', this.value)">
                            <div class="flex items-stretch gap-1">
                                <button type="button" onclick="openIconPickerFor('setNavIcon', '${key}')" class="flex flex-1 items-center gap-2 overflow-hidden rounded border border-gray-300 p-2 text-left text-sm transition hover:border-primary">
                                    <i class="bi ${item.icon ? navEsc(item.icon) + ' text-primary' : 'bi-plus-square text-gray-300'} shrink-0 text-lg" aria-hidden="true"></i>
                                    <span class="flex-1 truncate ${item.icon ? 'font-mono text-gray-700' : 'text-gray-400'}">${navEsc(item.icon) || 'เลือกไอคอน'}</span>
                                </button>
                                ${item.icon ? `<button type="button" title="เอาไอคอนออก" onclick="updateNavIcon('${key}', '')" class="shrink-0 rounded border border-gray-300 px-2 text-gray-400 transition hover:border-red-400 hover:text-red-500">✖</button>` : ''}
                            </div>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-2">${targetFields(item, path)}</div>
                        <div class="flex flex-wrap items-center gap-4">
                            <label class="flex items-center gap-2 text-xs text-gray-600">
                                <input type="checkbox" ${item.new_tab ? 'checked' : ''} onchange="updateNav('${key}', 'new_tab', this.checked)" class="h-4 w-4"> เปิดในแท็บใหม่
                            </label>
                            <label class="flex items-center gap-2 text-xs font-semibold ${enabled ? 'text-gray-700' : 'text-amber-700'}">
                                <input type="checkbox" ${enabled ? 'checked' : ''} onchange="toggleNav('${key}', this.checked)" class="h-4 w-4"> เปิดใช้งานเมนูนี้
                            </label>
                        </div>
                        ${isChild ? '' : `
                        <div class="pt-2 border-t border-gray-100">
                            <div class="flex justify-between items-center mb-2">
                                <span class="text-xs font-semibold text-gray-600">เมนูย่อย (${childCount})</span>
                                <button type="button" onclick="addNavChild(${index})" class="bg-white px-2 py-1 text-xs border rounded hover:bg-gray-100">+ เพิ่มเมนูย่อย</button>
                            </div>
                            <div class="space-y-2">${(item.children || []).map((c, j) => itemRow(c, [index, j], true)).join('')}</div>
                        </div>`}
                    </div>
                </div>
            `;
        }

        function renderNav() {
            navEmpty.classList.toggle('hidden', navItems.length > 0);
            const active = navItems.filter(i => i.enabled !== false).length;
            navCount.innerText = active === navItems.length ? navItems.length : active + ' จาก ' + navItems.length;
            navContainer.innerHTML = navItems.map((item, i) => itemRow(item, [i], false)).join('');
            navSync();
        }

        window.toggleRow = (key) => {
            const body = document.querySelector('[data-row-body="' + key + '"]');
            const caret = document.querySelector('[data-row-caret="' + key + '"]');
            if (!body) return;
            const nowOpen = body.classList.contains('hidden');
            body.classList.toggle('hidden', !nowOpen);
            if (caret) caret.classList.toggle('rotate-90', nowOpen);
            itemAt(parsePath(key))._open = nowOpen;
        };

        const setAllOpen = (state) => {
            navItems.forEach(item => {
                item._open = state;
                (item.children || []).forEach(child => { child._open = state; });
            });
            renderNav();
        };
        document.getElementById('expand-nav-btn').addEventListener('click', () => setAllOpen(true));
        document.getElementById('collapse-nav-btn').addEventListener('click', () => setAllOpen(false));

        window.updateNav = (pathStr, key, value) => {
            const item = itemAt(parsePath(pathStr));
            item[key] = value;
            navSync();
            // สลับชนิดลิงก์ต้องวาดฟิลด์ใหม่ ส่วนที่เหลืออัปเดตเฉพาะหัวแถว จะได้ไม่หลุดโฟกัสระหว่างพิมพ์
            if (key === 'type') { renderNav(); return; }
            if (key === 'label') {
                const el = document.querySelector('[data-row-label="' + pathStr + '"]');
                if (el) el.innerHTML = navEsc(value) || NO_NAME;
            }
            if (key === 'url' || key === 'page_id') {
                const el = document.querySelector('[data-row-target="' + pathStr + '"]');
                if (el) el.textContent = targetSummary(item);
            }
        };
        window.toggleNav = (pathStr, enabled) => {
            itemAt(parsePath(pathStr)).enabled = enabled;
            renderNav();
        };
        window.moveNav = (pathStr, direction) => {
            const path = parsePath(pathStr);
            const list = listAt(path);
            const i = path[path.length - 1];
            const target = i + direction;
            if (target < 0 || target >= list.length) return;
            const tmp = list[i]; list[i] = list[target]; list[target] = tmp;
            renderNav();
        };
        window.removeNav = (pathStr) => {
            if (!confirm('ลบรายการนี้?')) return;
            const path = parsePath(pathStr);
            listAt(path).splice(path[path.length - 1], 1);
            renderNav();
        };
        window.addNavChild = (index) => {
            navItems[index].children = navItems[index].children || [];
            navItems[index].children.push(Object.assign(blankItem(), { _open: true }));
            navItems[index]._open = true;
            renderNav();
        };
        // ตัวเลือกไอคอนอยู่ใน _icon-picker เรียกกลับมาที่ setNavIcon
        window.setNavIcon = (pathStr, name) => {
            itemAt(parsePath(pathStr)).icon = name;
            navSync();
            renderNav();
        };
        window.updateNavIcon = window.setNavIcon;

        document.getElementById('add-nav-btn').addEventListener('click', () => {
            navItems.push(Object.assign(blankItem(), { _open: true }));
            renderNav();
        });

        renderNav();
    </script>
</body>
</html>
