<%- include('_head', { pageTitle: 'จัดการ Page' }) %>
<%- include('_sidebar', { adminPage: 'pages', tabs: [], tabsTitle: 'หัวข้อในหน้านี้' }) %>
<%- include('_topbar', { heading: 'จัดการ Page' }) %>

                <div class="bg-white rounded-xl shadow-sm border border-gray-200">
                    <div class="px-6 py-4 border-b border-gray-200">
                        <h2 class="text-lg font-bold text-gray-800">Page ทั้งหมด</h2>
                        <p class="text-sm text-gray-500 mt-1">แต่ละ Page มีเนื้อหาและ SEO ของตัวเอง หน้าแรกเป็นหน้าเริ่มต้นที่ลบไม่ได้</p>
                    </div>
                    <ul class="divide-y divide-gray-200">
                        <% pages.forEach(function (pg) { %>
                        <li class="flex flex-wrap items-center gap-3 px-6 py-4">
                            <div class="flex-1 min-w-[12rem]">
                                <div class="font-semibold text-gray-800"><%= pg.title %></div>
                                <div class="text-xs text-gray-500">/<%= pg.is_home ? '' : pg.slug %></div>
                            </div>
                            <% if (pg.is_home) { %><span class="rounded-full bg-primary/10 px-2 py-0.5 text-xs font-semibold text-primary">หน้าแรก</span><% } %>
                            <a href="/admin/pages/<%= pg.id %>" class="rounded-md bg-primary px-4 py-2 text-sm font-semibold text-white hover:opacity-90 transition">แก้ไข</a>
                        </li>
                        <% }); %>
                    </ul>
                </div>

            </div>
        </main>
    </div>

    <script>
<%- include('_shared-js') %>

    </script>
</body>
</html>
