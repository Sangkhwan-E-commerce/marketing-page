<%- include('_head', { pageTitle: 'จัดการ Page' }) %>
<%- include('_sidebar', { adminPage: 'pages', tabs: [], tabsTitle: 'หัวข้อในหน้านี้' }) %>
<%- include('_topbar', { heading: 'จัดการ Page' }) %>

                <% if (typeof error !== 'undefined' && error) { %>
                <div class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"><%= error %></div>
                <% } %>

                <form action="/admin/pages" method="POST" class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
                    <h2 class="text-lg font-bold text-gray-800 mb-1">สร้าง Page ใหม่</h2>
                    <p class="text-sm text-gray-500 mb-4">หน้าใหม่จะเริ่มจากค่าปริยาย แก้เนื้อหาได้ทันทีหลังสร้าง</p>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="md:col-span-1">
                            <label class="block text-sm font-medium text-gray-700 mb-1">ชื่อหน้า</label>
                            <input type="text" name="title" required placeholder="เช่น ระบบ POS ร้านอาหาร" class="w-full border-gray-300 rounded-md border p-2 text-sm">
                        </div>
                        <div class="md:col-span-1">
                            <label class="block text-sm font-medium text-gray-700 mb-1">URL (เว้นว่างให้สร้างจากชื่อ)</label>
                            <input type="text" name="slug" placeholder="pos-restaurant" class="w-full border-gray-300 rounded-md border p-2 text-sm">
                        </div>
                        <div class="md:col-span-1 flex items-end">
                            <button type="submit" class="w-full rounded-md bg-primary px-6 py-2.5 text-sm font-bold text-white shadow-sm hover:opacity-90 transition">+ สร้าง Page</button>
                        </div>
                    </div>
                </form>

                <div class="bg-white rounded-xl shadow-sm border border-gray-200">
                    <div class="px-6 py-4 border-b border-gray-200">
                        <h2 class="text-lg font-bold text-gray-800">Page ทั้งหมด</h2>
                        <p class="text-sm text-gray-500 mt-1">แต่ละ Page มีเนื้อหาและ SEO ของตัวเอง หน้าแรกเป็นหน้าเริ่มต้นที่ลบไม่ได้</p>
                    </div>
                    <ul class="divide-y divide-gray-200">
                        <% pages.forEach(function (pg) { %>
                        <li class="flex flex-wrap items-center gap-3 px-6 py-4">
                            <div class="flex-1 min-w-[12rem]">
                                <div class="font-semibold text-gray-800"><%= pg.title %></div>
                                <div class="text-xs text-gray-500">/<%= pg.is_home ? '' : pg.slug %></div>
                            </div>
                            <% if (pg.is_home) { %><span class="rounded-full bg-primary/10 px-2 py-0.5 text-xs font-semibold text-primary">หน้าแรก</span><% } %>
                            <% if (!pg.is_published) { %><span class="rounded-full bg-gray-200 px-2 py-0.5 text-xs font-semibold text-gray-600">ยังไม่เผยแพร่</span><% } %>
                            <a href="<%= pg.is_home ? '/' : '/' + encodeURIComponent(pg.slug) %>" target="_blank" class="rounded-md border border-gray-300 px-3 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50 transition">ดูหน้า</a>
                            <a href="/admin/pages/<%= pg.id %>" class="rounded-md bg-primary px-4 py-2 text-sm font-semibold text-white hover:opacity-90 transition">แก้ไข</a>
                            <% if (!pg.is_home) { %>
                            <form action="/admin/pages/<%= pg.id %>/delete" method="POST" onsubmit="return confirm('ลบหน้า &quot;<%= pg.title %>&quot; และเนื้อหาทั้งหมดของหน้านี้?');">
                                <button type="submit" class="rounded-md border border-red-500 px-3 py-2 text-sm font-semibold text-red-600 hover:bg-red-500 hover:text-white transition">ลบ</button>
                            </form>
                            <% } %>
                        </li>
                        <% }); %>
                    </ul>
                </div>

            </div>
        </main>
    </div>

    <script>
<%- include('_shared-js') %>

    </script>
</body>
</html>
