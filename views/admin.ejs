<%
// ฟังก์ชันช่วยดึงข้อมูล JSON แยกตามภาษาที่แอดมินเลือก
function getVal(key) {
    let val = settings[key] || '';
    try {
        let parsed = JSON.parse(val);
        if (parsed && typeof parsed === 'object' && !Array.isArray(parsed) && (parsed.th !== undefined || parsed.en !== undefined)) {
            return parsed[currentLang] !== undefined ? parsed[currentLang] : '';
        }
    } catch(e) { }
    return val;
}
%>
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ระบบจัดการหลังบ้าน - Lullapos</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        .tab-btn.active { border-bottom: 2px solid #3b82f6; color: #3b82f6; font-weight: 600; }
    </style>
</head>
<body class="bg-gray-50 min-h-screen">

    <!-- Navbar -->
    <nav class="bg-white shadow-sm sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <span class="text-xl font-bold text-gray-800"><i class="fas fa-cog text-blue-600 mr-2"></i> Lullapos Admin</span>
                </div>
                <div class="flex items-center gap-6">
                    <!-- Dropdown เปลี่ยนภาษา -->
                    <div class="flex items-center gap-2 bg-gray-100 px-3 py-1.5 rounded-lg border border-gray-200">
                        <i class="fas fa-language text-gray-500"></i>
                        <label class="text-sm font-medium text-gray-700">ภาษา:</label>
                        <select onchange="window.location.href='/admin?lang=' + this.value" class="bg-transparent text-sm font-bold text-blue-600 focus:outline-none cursor-pointer">
                            <option value="th" <%= currentLang === 'th' ? 'selected' : '' %>>🇹🇭 ภาษาไทย</option>
                            <option value="en" <%= currentLang === 'en' ? 'selected' : '' %>>🇬🇧 English</option>
                        </select>
                    </div>
                    
                    <a href="/" target="_blank" class="text-gray-600 hover:text-blue-600 font-medium transition-colors">
                        <i class="fas fa-external-link-alt mr-1"></i> ดูเว็บไซต์
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        
        <form action="/admin/save" method="POST" enctype="multipart/form-data" class="bg-white shadow-lg rounded-xl overflow-hidden">
            <input type="hidden" name="edit_lang" value="<%= currentLang %>">

            <!-- Tabs Header -->
            <div class="border-b border-gray-200 bg-gray-50 overflow-x-auto">
                <nav class="flex px-4" aria-label="Tabs" id="tabs-nav">
                    <button type="button" class="tab-btn active whitespace-nowrap py-4 px-4 text-sm font-medium text-gray-500 hover:text-gray-700" data-target="tab1">1. ทั่วไป & SEO</button>
                    <button type="button" class="tab-btn whitespace-nowrap py-4 px-4 text-sm font-medium text-gray-500 hover:text-gray-700" data-target="tab2">2. ส่วนหัว (Hero)</button>
                    <button type="button" class="tab-btn whitespace-nowrap py-4 px-4 text-sm font-medium text-gray-500 hover:text-gray-700" data-target="tab3">3. ฟีเจอร์หลัก</button>
                    <button type="button" class="tab-btn whitespace-nowrap py-4 px-4 text-sm font-medium text-gray-500 hover:text-gray-700" data-target="tab4">4. กริดฟีเจอร์</button>
                    <button type="button" class="tab-btn whitespace-nowrap py-4 px-4 text-sm font-medium text-gray-500 hover:text-gray-700" data-target="tab5">5. สถิติ</button>
                    <button type="button" class="tab-btn whitespace-nowrap py-4 px-4 text-sm font-medium text-gray-500 hover:text-gray-700" data-target="tab6">6. FAQ</button>
                    <button type="button" class="tab-btn whitespace-nowrap py-4 px-4 text-sm font-medium text-gray-500 hover:text-gray-700" data-target="tab7">7. CTA & Footer</button>
                    <button type="button" class="tab-btn whitespace-nowrap py-4 px-4 text-sm font-medium text-gray-500 hover:text-gray-700" data-target="tab8">8. แบนเนอร์</button>
                </nav>
            </div>

            <!-- Tabs Content Container -->
            <div class="p-6">
                
                <!-- Tab 1: ทั่วไป & SEO -->
                <div id="tab1" class="tab-content active space-y-6">
                    <h2 class="text-lg font-bold text-gray-900 border-b pb-2">ตั้งค่าทั่วไป <span class="text-sm font-normal text-red-500 ml-2">(ใช้ร่วมกันทุกภาษา)</span></h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div><label class="block text-sm font-medium text-gray-700">สีธีม</label><input type="text" name="theme_color" value="<%= settings.theme_color %>" class="mt-1 block w-full border rounded-md p-2"></div>
                        <div><label class="block text-sm font-medium text-gray-700">อัปโหลด Favicon</label><input type="file" name="favicon" accept="image/*" class="mt-1 block w-full text-sm"></div>
                        <div><label class="block text-sm font-medium text-gray-700">อัปโหลดโลโก้</label><input type="file" name="logo" accept="image/*" class="mt-1 block w-full text-sm"></div>
                        <div><label class="block text-sm font-medium text-gray-700">ลิงก์ Facebook</label><input type="text" name="facebook_url" value="<%= settings.facebook_url %>" class="mt-1 block w-full border rounded-md p-2"></div>
                        <div><label class="block text-sm font-medium text-gray-700">ลิงก์ LINE</label><input type="text" name="line_url" value="<%= settings.line_url %>" class="mt-1 block w-full border rounded-md p-2"></div>
                    </div>

                    <h2 class="text-lg font-bold text-gray-900 border-b pb-2 mt-8">SEO (รองรับหลายภาษา)</h2>
                    <div class="grid grid-cols-1 gap-6">
                        <div><label class="block text-sm font-medium">SEO Title</label><input type="text" name="seo_title" value="<%= getVal('seo_title') %>" class="mt-1 block w-full border rounded-md p-2"></div>
                        <div><label class="block text-sm font-medium">SEO Description</label><textarea name="seo_description" rows="3" class="mt-1 block w-full border rounded-md p-2"><%= getVal('seo_description') %></textarea></div>
                        <div><label class="block text-sm font-medium">SEO Keywords</label><input type="text" name="seo_keywords" value="<%= getVal('seo_keywords') %>" class="mt-1 block w-full border rounded-md p-2"></div>
                        <div><label class="block text-sm font-medium">SEO Thumbnail Image <span class="text-red-500 font-normal">(ใช้ร่วมกันทุกภาษา)</span></label><input type="file" name="seo_thumbnail" accept="image/*" class="mt-1 block w-full text-sm"></div>
                    </div>
                </div>

                <!-- Tab 2: ส่วนหัว (Hero) -->
                <div id="tab2" class="tab-content space-y-6">
                    <h2 class="text-lg font-bold text-gray-900 border-b pb-2">ตั้งค่าส่วนหัว (Hero Section)</h2>
                    <div><label class="block text-sm font-medium">รูปภาพหน้าปก <span class="text-red-500 font-normal">(ใช้ร่วมกันทุกภาษา)</span></label><input type="file" name="hero_img" accept="image/*" class="mt-1 block w-full text-sm"></div>
                    <div><label class="block text-sm font-medium">ป้ายกำกับ</label><input type="text" name="hero_badge" value="<%= getVal('hero_badge') %>" class="mt-1 block w-full border rounded-md p-2"></div>
                    <div><label class="block text-sm font-medium">หัวข้อหลัก</label><input type="text" name="hero_title" value="<%= getVal('hero_title') %>" class="mt-1 block w-full border rounded-md p-2"></div>
                    <div><label class="block text-sm font-medium">คำบรรยาย</label><textarea name="hero_desc" rows="4" class="mt-1 block w-full border rounded-md p-2"><%= getVal('hero_desc') %></textarea></div>
                    <div class="grid grid-cols-2 gap-4">
                        <div><label class="block text-sm font-medium">ข้อความปุ่ม</label><input type="text" name="btn_text" value="<%= getVal('btn_text') %>" class="mt-1 block w-full border rounded-md p-2"></div>
                        <div><label class="block text-sm font-medium">ลิงก์ปุ่ม</label><input type="text" name="btn_url" value="<%= getVal('btn_url') %>" class="mt-1 block w-full border rounded-md p-2"></div>
                    </div>
                </div>

                <!-- Tab 3: ฟีเจอร์หลัก -->
                <div id="tab3" class="tab-content space-y-6">
                    <h2 class="text-lg font-bold text-gray-900 border-b pb-2">ฟีเจอร์หลัก 3 คอลัมน์</h2>
                    <div><label class="block text-sm font-medium">หัวข้อฟีเจอร์</label><input type="text" name="feature_title" value="<%= getVal('feature_title') %>" class="mt-1 block w-full border rounded-md p-2"></div>
                    <div><label class="block text-sm font-medium">คำบรรยายฟีเจอร์</label><textarea name="feature_subtitle" rows="2" class="mt-1 block w-full border rounded-md p-2"><%= getVal('feature_subtitle') %></textarea></div>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-4">
                        <% for(let i=1; i<=3; i++) { %>
                        <div class="p-4 bg-gray-50 rounded-lg border">
                            <h3 class="font-bold mb-2">คอลัมน์ที่ <%= i %></h3>
                            <input type="text" name="col<%= i %>_title" value="<%= getVal('col' + i + '_title') %>" class="mb-2 mt-1 w-full border rounded p-2 text-sm" placeholder="หัวข้อ">
                            <textarea name="col<%= i %>_desc" rows="3" class="w-full border rounded p-2 text-sm" placeholder="คำบรรยาย"><%= getVal('col' + i + '_desc') %></textarea>
                            <textarea name="col<%= i %>_icon" rows="2" class="w-full border rounded p-2 text-xs font-mono mt-2" placeholder="SVG Icon"><%= getVal('col' + i + '_icon') %></textarea>
                        </div>
                        <% } %>
                    </div>
                </div>

                <!-- Tab 4: กริดฟีเจอร์ (Grid) -->
                <div id="tab4" class="tab-content space-y-6">
                    <h2 class="text-lg font-bold text-gray-900 border-b pb-2">กริดฟีเจอร์ (6 กล่อง)</h2>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="md:col-span-1"><label class="block text-sm font-medium">ป้ายกำกับ</label><input type="text" name="grid_badge" value="<%= getVal('grid_badge') %>" class="mt-1 block w-full border rounded-md p-2"></div>
                        <div class="md:col-span-2"><label class="block text-sm font-medium">หัวข้อหลัก</label><input type="text" name="grid_title" value="<%= getVal('grid_title') %>" class="mt-1 block w-full border rounded-md p-2"></div>
                        <div class="md:col-span-3"><label class="block text-sm font-medium">คำบรรยาย</label><textarea name="grid_desc" rows="2" class="mt-1 block w-full border rounded-md p-2"><%= getVal('grid_desc') %></textarea></div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
                        <% for(let i=1; i<=6; i++) { %>
                        <div class="p-4 bg-gray-50 border rounded-lg flex flex-col gap-2">
                            <h4 class="font-bold text-sm text-blue-600">กล่องที่ <%= i %></h4>
                            <input type="text" name="grid<%= i %>_title" placeholder="หัวข้อ" value="<%= getVal('grid' + i + '_title') %>" class="w-full border rounded p-2 text-sm">
                            <input type="text" name="grid<%= i %>_desc" placeholder="คำบรรยายสั้นๆ" value="<%= getVal('grid' + i + '_desc') %>" class="w-full border rounded p-2 text-sm">
                            <textarea name="grid<%= i %>_icon" placeholder="SVG Icon Code" rows="1" class="w-full border rounded p-2 text-xs font-mono"><%= getVal('grid' + i + '_icon') %></textarea>
                        </div>
                        <% } %>
                    </div>
                </div>

                <!-- Tab 5: สถิติ (Stats) -->
                <div id="tab5" class="tab-content space-y-6">
                    <h2 class="text-lg font-bold text-gray-900 border-b pb-2">ส่วนแสดงสถิติ</h2>
                    <div><label class="block text-sm font-medium">รูปภาพพื้นหลัง <span class="text-red-500 font-normal">(ส่วนกลาง)</span></label><input type="file" name="stats_img" accept="image/*" class="mt-1 block w-full text-sm"></div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div><label class="block text-sm font-medium">ป้ายกำกับ</label><input type="text" name="stats_badge" value="<%= getVal('stats_badge') %>" class="mt-1 w-full border rounded p-2"></div>
                        <div><label class="block text-sm font-medium">หัวข้อ</label><input type="text" name="stats_title" value="<%= getVal('stats_title') %>" class="mt-1 w-full border rounded p-2"></div>
                    </div>
                    <div><label class="block text-sm font-medium">คำบรรยาย</label><textarea name="stats_desc" rows="2" class="mt-1 w-full border rounded p-2"><%= getVal('stats_desc') %></textarea></div>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 bg-gray-50 p-4 rounded-lg border">
                        <% for(let i=1; i<=4; i++) { %>
                        <div>
                            <label class="block text-xs font-medium text-gray-500">Label <%= i %></label>
                            <input type="text" name="stat<%= i %>_label" value="<%= getVal('stat' + i + '_label') %>" class="mt-1 w-full border rounded p-2 text-sm mb-2">
                            <label class="block text-xs font-medium text-gray-500">Value <%= i %></label>
                            <input type="text" name="stat<%= i %>_value" value="<%= getVal('stat' + i + '_value') %>" class="mt-1 w-full border rounded p-2 text-sm font-bold">
                        </div>
                        <% } %>
                    </div>
                </div>

                <!-- Tab 6: FAQ -->
                <div id="tab6" class="tab-content space-y-6">
                    <h2 class="text-lg font-bold text-gray-900 border-b pb-2">คำถามที่พบบ่อย (FAQ)</h2>
                    <div><label class="block text-sm font-medium">หัวข้อส่วน FAQ</label><input type="text" name="faq_title" value="<%= getVal('faq_title') %>" class="mt-1 block w-full border rounded-md p-2"></div>
                    <div><label class="block text-sm font-medium">รายการคำถาม (JSON Format)</label><textarea name="faq_list" rows="10" class="mt-1 block w-full border rounded-md p-2 font-mono text-sm"><%= getVal('faq_list') %></textarea></div>
                </div>

                <!-- Tab 7: CTA & Footer -->
                <div id="tab7" class="tab-content space-y-6">
                    <h2 class="text-lg font-bold text-gray-900 border-b pb-2">Call to Action & Footer</h2>
                    <div class="bg-gray-50 p-4 rounded-lg border mb-6">
                        <h3 class="font-bold mb-4">Call to Action</h3>
                        <div><label class="block text-sm font-medium">หัวข้อ</label><input type="text" name="cta_title" value="<%= getVal('cta_title') %>" class="mt-1 w-full border rounded p-2"></div>
                        <div class="mt-4"><label class="block text-sm font-medium">คำบรรยาย</label><textarea name="cta_desc" rows="2" class="mt-1 w-full border rounded p-2"><%= getVal('cta_desc') %></textarea></div>
                        <div class="grid grid-cols-2 gap-4 mt-4">
                            <div><label class="block text-xs font-medium">ปุ่มที่ 1 (Text)</label><input type="text" name="cta_btn1_text" value="<%= getVal('cta_btn1_text') %>" class="mt-1 w-full border rounded p-2"></div>
                            <div><label class="block text-xs font-medium">ปุ่มที่ 1 (URL)</label><input type="text" name="cta_btn1_url" value="<%= getVal('cta_btn1_url') %>" class="mt-1 w-full border rounded p-2"></div>
                            <div><label class="block text-xs font-medium">ปุ่มที่ 2 (Text)</label><input type="text" name="cta_btn2_text" value="<%= getVal('cta_btn2_text') %>" class="mt-1 w-full border rounded p-2"></div>
                            <div><label class="block text-xs font-medium">ปุ่มที่ 2 (URL)</label><input type="text" name="cta_btn2_url" value="<%= getVal('cta_btn2_url') %>" class="mt-1 w-full border rounded p-2"></div>
                        </div>
                    </div>
                    <div><label class="block text-sm font-medium">ข้อความ Footer</label><input type="text" name="footer_text" value="<%= getVal('footer_text') %>" class="mt-1 block w-full border rounded-md p-2"></div>
                </div>

                <!-- Tab 8: แบนเนอร์ (Modal/Carousel) -->
                <div id="tab8" class="tab-content space-y-6">
                    <h2 class="text-lg font-bold text-gray-900 border-b pb-2">ระบบจัดการแบนเนอร์โฆษณา</h2>
                    
                    <!-- การตั้งค่า Global (ใช้ร่วมกันทุกภาษา) -->
                    <div class="bg-blue-50 border border-blue-200 p-4 rounded-lg mb-6">
                        <h3 class="font-bold text-blue-800 mb-2">การตั้งค่าการแสดงผล <span class="text-red-500 text-xs font-normal">(ใช้ร่วมกันทุกภาษา)</span></h3>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div class="flex items-center mt-6">
                                <input type="checkbox" name="banner_active" id="banner_active" <%= settings.banner_active === 'true' ? 'checked' : '' %> class="h-4 w-4 text-blue-600 rounded">
                                <label for="banner_active" class="ml-2 block text-sm font-medium text-gray-700">เปิดใช้งาน Banner</label>
                            </div>
                            <div>
                                <label class="block text-sm font-medium">เงื่อนไขการแสดง</label>
                                <select name="banner_display_type" class="mt-1 block w-full p-2 rounded-md border">
                                    <option value="always" <%= settings.banner_display_type === 'always' ? 'selected' : '' %>>แสดงทุกครั้ง</option>
                                    <option value="once_per_session" <%= settings.banner_display_type === 'once_per_session' ? 'selected' : '' %>>ครั้งเดียวต่อ Session</option>
                                    <option value="limited_times" <%= settings.banner_display_type === 'limited_times' ? 'selected' : '' %>>จำกัดจำนวนครั้ง</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-medium">จำนวนครั้งสูงสุด</label>
                                <input type="number" name="banner_display_limit" value="<%= settings.banner_display_limit || 1 %>" class="mt-1 block w-full border rounded-md p-2">
                            </div>
                        </div>
                    </div>

                    <!-- ระบบจัดการสไลด์รูปภาพ -->
                    <div class="bg-white border rounded-lg p-4">
                        <div class="flex justify-between items-center mb-4">
                            <h3 class="font-bold text-gray-800">
                                จัดการรูปภาพสไลด์ 
                                <span class="text-blue-600 text-sm font-normal">(อิงตามภาษา <%= currentLang === 'th' ? 'ไทย' : 'English' %>)</span>
                            </h3>
                        </div>

                        <!-- ซ่อน Textarea ไว้เก็บ JSON ตอนส่งเข้า Form -->
                        <textarea name="banner_list" id="banner_list_input" class="hidden"><%= getVal('banner_list') %></textarea>

                        <!-- ส่วนอัปโหลด -->
                        <div class="flex items-center gap-3 mb-6 bg-gray-50 p-4 rounded-lg border border-dashed border-gray-300">
                            <input type="file" id="slide_upload" accept="image/*" class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700">
                            <button type="button" id="btn_add_slide" class="whitespace-nowrap bg-blue-100 text-blue-700 px-4 py-2 rounded hover:bg-blue-200 font-medium transition-colors">
                                <i class="fas fa-upload mr-1"></i> อัปโหลดเพิ่มสไลด์
                            </button>
                        </div>
                        <div id="slide_loading" class="hidden text-sm text-blue-600 mb-4 animate-pulse"><i class="fas fa-spinner fa-spin mr-2"></i>กำลังอัปโหลดรูปภาพ...</div>

                        <!-- คอนเทนเนอร์แสดงสไลด์ที่มีอยู่ -->
                        <div id="slides_container" class="space-y-3">
                            <!-- JS จะดึงภาพมาแสดงตรงนี้ -->
                        </div>
                    </div>
                </div>

            </div>

            <!-- Action Bar (Sticky Bottom) -->
            <div class="bg-gray-50 px-6 py-4 border-t border-gray-200 flex items-center justify-between sticky bottom-0">
                <span class="text-sm text-gray-500">กำลังแก้ไขข้อมูลสำหรับภาษา: <strong><%= currentLang === 'th' ? 'ภาษาไทย' : 'English' %></strong></span>
                <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 font-bold shadow-md transition-transform hover:scale-105 flex items-center gap-2">
                    <i class="fas fa-save"></i> บันทึกข้อมูล
                </button>
            </div>
        </form>
    </main>

    <!-- Scripts -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // 1. ระบบจัดการ Tabs
            const tabs = document.querySelectorAll('.tab-btn');
            const contents = document.querySelectorAll('.tab-content');

            tabs.forEach(tab => {
                tab.addEventListener('click', () => {
                    tabs.forEach(t => t.classList.remove('active', 'border-b', 'border-blue-500', 'text-blue-600'));
                    contents.forEach(c => c.classList.remove('active'));
                    tab.classList.add('active', 'border-b', 'border-blue-500', 'text-blue-600');
                    document.getElementById(tab.getAttribute('data-target')).classList.add('active');
                });
            });

            // 2. ระบบจัดการแบนเนอร์ (Slide Carousel)
            const bannerInput = document.getElementById('banner_list_input');
            const slidesContainer = document.getElementById('slides_container');
            const uploadInput = document.getElementById('slide_upload');
            const btnAddSlide = document.getElementById('btn_add_slide');
            const slideLoading = document.getElementById('slide_loading');

            // ดึงค่า JSON เริ่มต้น
            let slides = [];
            try {
                slides = JSON.parse(bannerInput.value || '[]');
            } catch(e) {
                slides = [];
            }

            // ฟังก์ชันวาด UI สไลด์
            function renderSlides() {
                slidesContainer.innerHTML = '';
                
                if(slides.length === 0) {
                    slidesContainer.innerHTML = '<div class="text-center text-gray-400 py-6">ยังไม่มีรูปภาพแบนเนอร์สำหรับภาษานี้</div>';
                }

                slides.forEach((slide, index) => {
                    const div = document.createElement('div');
                    div.className = 'flex items-start md:items-center flex-col md:flex-row gap-4 p-4 border rounded-lg bg-gray-50 shadow-sm';
                    div.innerHTML = `
                        <div class="flex-shrink-0 relative">
                            <span class="absolute -top-2 -left-2 bg-gray-800 text-white w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold">${index + 1}</span>
                            <img src="${slide.url}" class="h-20 w-32 object-cover rounded border border-gray-300">
                        </div>
                        <div class="flex-1 w-full">
                            <label class="block text-xs font-medium text-gray-600 mb-1">ลิงก์เมื่อคลิกรูปนี้ (ใส่ URL หรือปล่อยว่างได้)</label>
                            <input type="text" value="${slide.link || ''}" onchange="updateSlideLink(${index}, this.value)" class="w-full border border-gray-300 rounded p-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" placeholder="https://example.com/promotion">
                        </div>
                        <button type="button" onclick="removeSlide(${index})" class="flex-shrink-0 text-red-500 hover:text-white hover:bg-red-500 border border-red-500 px-3 py-2 rounded transition-colors text-sm font-medium">
                            <i class="fas fa-trash"></i> ลบรูปนี้
                        </button>
                    `;
                    slidesContainer.appendChild(div);
                });

                // อัปเดตกลับลง textarea ทันที
                bannerInput.value = JSON.stringify(slides);
            }

            // ฟังก์ชันอัปเดตลิงก์
            window.updateSlideLink = function(index, value) {
                slides[index].link = value;
                bannerInput.value = JSON.stringify(slides);
            }

            // ฟังก์ชันลบสไลด์
            window.removeSlide = function(index) {
                if(confirm('ต้องการลบรูปภาพนี้ใช่หรือไม่?')) {
                    slides.splice(index, 1);
                    renderSlides();
                }
            }

            // ฟังก์ชันอัปโหลดเมื่อกดปุ่ม
            btnAddSlide.addEventListener('click', async () => {
                const file = uploadInput.files[0];
                if (!file) return alert('กรุณาเลือกไฟล์รูปภาพก่อนกดอัปโหลด');

                const formData = new FormData();
                formData.append('slide_image', file);

                btnAddSlide.disabled = true;
                slideLoading.classList.remove('hidden');

                try {
                    // เรียก API ที่อยู่ใน server.js
                    const res = await fetch('/admin/api/upload-slide', {
                        method: 'POST',
                        body: formData
                    });
                    
                    const data = await res.json();
                    if (data.success) {
                        // อัปโหลดสำเร็จ เพิ่มเข้า Array และ Render ใหม่
                        slides.push({ url: data.url, link: '' });
                        renderSlides();
                        uploadInput.value = ''; // เคลียร์ช่องเลือกไฟล์
                    } else {
                        alert('อัปโหลดไม่สำเร็จ: ' + data.message);
                    }
                } catch (err) {
                    alert('เกิดข้อผิดพลาดในการเชื่อมต่อเซิร์ฟเวอร์');
                } finally {
                    btnAddSlide.disabled = false;
                    slideLoading.classList.add('hidden');
                }
            });

            // รันครั้งแรกเมื่อโหลดหน้าจอ
            renderSlides();
        });
    </script>
</body>
</html>