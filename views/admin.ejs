<!DOCTYPE html>
<html lang="th" class="h-full bg-gray-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>จัดการเว็บไซต์ - Lullapos Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
    <style> 
        body { font-family: 'Prompt', sans-serif; } 
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        .ql-editor { min-height: 200px; }
    </style>
    <script>
      tailwind.config = { theme: { extend: { colors: { primary: '<%= settings.theme_color %>' } } } }
      function previewImage(input, imgId) {
          if (input.files && input.files[0]) {
              var reader = new FileReader();
              reader.onload = function(e) { document.getElementById(imgId).src = e.target.result; }
              reader.readAsDataURL(input.files[0]);
          }
      }
    </script>
</head>
<body class="h-full overflow-hidden flex">

    <div id="mobile-sidebar-backdrop" class="fixed inset-0 z-40 hidden bg-gray-900/80 transition-opacity md:hidden" aria-hidden="true"></div>

    <aside id="sidebar" class="fixed inset-y-0 left-0 z-50 flex w-72 -translate-x-full flex-col bg-gray-900 transition-transform duration-300 ease-in-out md:static md:translate-x-0">
        <div class="flex h-16 shrink-0 items-center bg-gray-900 px-6 border-b border-gray-800">
            <span class="text-2xl font-bold text-white tracking-wide">Lulla<span class="text-primary">pos</span> <span class="text-xs text-gray-400 font-normal ml-1">Admin</span></span>
            <button id="close-sidebar-btn" type="button" class="ml-auto flex items-center justify-center text-gray-400 hover:text-white md:hidden">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
        </div>

        <nav class="flex flex-1 flex-col overflow-y-auto no-scrollbar px-4 py-6">
            <ul role="list" class="flex flex-1 flex-col gap-y-7">
                <li>
                    <div class="text-xs font-semibold leading-6 text-gray-400 uppercase tracking-wider mb-2">จัดการหน้า Landing Page</div>
                    <ul role="list" class="-mx-2 space-y-1">
                        <li><button type="button" class="sidebar-menu-btn w-full flex gap-x-3 rounded-md p-2 text-sm font-semibold leading-6 text-gray-400 hover:bg-gray-800 hover:text-white" data-target="tab-general">1. ทั่วไป & Footer</button></li>
                        <li><button type="button" class="sidebar-menu-btn w-full flex gap-x-3 rounded-md p-2 text-sm font-semibold leading-6 text-gray-400 hover:bg-gray-800 hover:text-white" data-target="tab-hero">2. ส่วนบนสุด (Hero)</button></li>
                        <li><button type="button" class="sidebar-menu-btn w-full flex gap-x-3 rounded-md p-2 text-sm font-semibold leading-6 text-gray-400 hover:bg-gray-800 hover:text-white" data-target="tab-features3">3. วิสัยทัศน์</button></li>
                        <li><button type="button" class="sidebar-menu-btn w-full flex gap-x-3 rounded-md p-2 text-sm font-semibold leading-6 text-gray-400 hover:bg-gray-800 hover:text-white" data-target="tab-features4">4. ฟีเจอร์หลัก</button></li>
                        <li><button type="button" class="sidebar-menu-btn w-full flex gap-x-3 rounded-md p-2 text-sm font-semibold leading-6 text-gray-400 hover:bg-gray-800 hover:text-white" data-target="tab-stats">5. ภารกิจและสถิติ</button></li>
                        <li><button type="button" class="sidebar-menu-btn w-full flex gap-x-3 rounded-md p-2 text-sm font-semibold leading-6 text-gray-400 hover:bg-gray-800 hover:text-white" data-target="tab-faq">6. คำถามที่พบบ่อย (FAQ)</button></li>
                        <li><button type="button" class="sidebar-menu-btn w-full flex gap-x-3 rounded-md p-2 text-sm font-semibold leading-6 text-gray-400 hover:bg-gray-800 hover:text-white" data-target="tab-cta">7. ส่วนเชิญชวน (CTA)</button></li>
                        <li><button type="button" class="sidebar-menu-btn w-full flex gap-x-3 rounded-md p-2 text-sm font-semibold leading-6 text-gray-400 hover:bg-gray-800 hover:text-white" data-target="tab-banner">8. โฆษณา Modal</button></li>
                        <li><button type="button" class="sidebar-menu-btn w-full flex gap-x-3 rounded-md p-2 text-sm font-semibold leading-6 text-gray-400 hover:bg-gray-800 hover:text-white" data-target="tab-seo">9. ตั้งค่า SEO</button></li>
                    </ul>
                </li>
                <li>
                    <div class="text-xs font-semibold leading-6 text-gray-400 uppercase tracking-wider mb-2">บทความ & คอนเทนต์</div>
                    <ul role="list" class="-mx-2 space-y-1">
                        <li><button type="button" class="sidebar-menu-btn w-full flex gap-x-3 rounded-md p-2 text-sm font-semibold leading-6 text-primary bg-primary/10 hover:bg-gray-800 hover:text-white transition-colors" data-target="tab-blog" id="btn-blog">📝 10. จัดการบทความ (Blog)</button></li>
                    </ul>
                </li>
            </ul>
        </nav>
    </aside>

    <div class="flex flex-col flex-1 w-0 overflow-hidden bg-gray-50">
        <header class="flex items-center justify-between h-16 px-4 bg-white border-b border-gray-200 shadow-sm sm:px-6 lg:px-8 shrink-0 relative z-10">
            <button id="open-sidebar-btn" type="button" class="text-gray-500 hover:text-gray-700 md:hidden">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25H12" /></svg>
            </button>
            <h1 class="hidden text-xl font-bold text-gray-800 md:block" id="page-title-display">1. ทั่วไป & Footer</h1>
            
            <div class="flex items-center ml-auto space-x-4">
                <div class="relative ml-3">
                    <button id="user-menu-btn" type="button" class="flex items-center bg-white rounded-full focus:outline-none focus:ring-2 focus:ring-primary">
                        <img class="w-9 h-9 rounded-full object-cover border border-gray-200" src="https://ui-avatars.com/api/?name=Admin&background=random&color=fff" alt="Admin">
                    </button>
                    <div id="user-dropdown-panel" class="absolute right-0 z-10 hidden w-48 py-1 mt-2 bg-white rounded-md shadow-lg ring-1 ring-black ring-opacity-5">
                        <a href="/" target="_blank" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">ดูหน้าเว็บไซต์จริง</a>
                        <a href="/admin/login" class="block px-4 py-2 text-sm text-red-600 hover:bg-red-50">ออกจากระบบ</a>
                    </div>
                </div>
            </div>
        </header>

        <main class="flex-1 relative overflow-y-auto focus:outline-none">
            <div class="py-6 px-4 sm:px-6 lg:px-8 mx-auto max-w-5xl">
                
                <form action="/admin/save" method="POST" enctype="multipart/form-data" class="bg-white rounded-xl shadow-sm border border-gray-200" id="main-settings-form">
                    <div class="px-6 py-4 border-b border-gray-200 flex flex-col sm:flex-row sm:items-center sm:justify-between sticky top-0 bg-white/90 backdrop-blur-sm z-20 rounded-t-xl">
                        <div><p class="text-sm text-gray-500">กรุณากดบันทึกทุกครั้งเมื่อแก้ไขข้อมูลเสร็จสิ้น</p></div>
                        <div class="mt-4 sm:mt-0"><button type="submit" class="inline-flex items-center rounded-md bg-primary px-6 py-2.5 text-sm font-bold text-white shadow-md hover:opacity-80 transition-all transform hover:scale-105">💾 บันทึกการเปลี่ยนแปลง</button></div>
                    </div>

                    <div class="p-6">
                        <div id="tab-general" class="tab-content space-y-6">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 bg-gray-50/50 p-6 rounded-lg border border-gray-100">
                                <div><label class="block text-sm font-semibold mb-2">Favicon</label><input type="file" name="favicon" onchange="previewImage(this, 'p-fav')"><img id="p-fav" src="<%= settings.favicon_url %>" class="h-10 mt-2"></div>
                                <div><label class="block text-sm font-semibold mb-2">Logo</label><input type="file" name="logo" onchange="previewImage(this, 'p-log')"><img id="p-log" src="<%= settings.logo_url %>" class="h-10 mt-2"></div>
                            </div>
                        </div>
                        <div id="tab-hero" class="tab-content space-y-6 hidden">... (เนื้อหาเดิม) ...</div>
                        <div id="tab-features3" class="tab-content space-y-6 hidden">... (เนื้อหาเดิม) ...</div>
                        <div id="tab-features4" class="tab-content space-y-6 hidden">... (เนื้อหาเดิม) ...</div>
                        <div id="tab-stats" class="tab-content space-y-6 hidden">... (เนื้อหาเดิม) ...</div>
                        <div id="tab-faq" class="tab-content space-y-6 hidden">... (เนื้อหาเดิม) ...</div>
                        <div id="tab-cta" class="tab-content space-y-6 hidden">... (เนื้อหาเดิม) ...</div>
                        <div id="tab-banner" class="tab-content space-y-6 hidden">... (เนื้อหาเดิม) ...</div>
                        <div id="tab-seo" class="tab-content space-y-6 hidden">... (เนื้อหาเดิม) ...</div>
                        </div>
                </form>

                <div id="tab-blog" class="tab-content hidden">
                    <div class="bg-white rounded-xl shadow-sm border border-gray-200">
                        <div class="px-6 py-4 border-b border-gray-200 flex flex-col sm:flex-row sm:items-center sm:justify-between bg-white/90 rounded-t-xl">
                            <h2 class="text-lg font-bold text-gray-800">จัดการบทความ (Blog)</h2>
                            <div class="flex space-x-2 mt-2 sm:mt-0">
                                <button onclick="blogUI.showCategoryModal()" class="bg-gray-100 text-gray-700 px-4 py-2 rounded text-sm font-bold border border-gray-300 hover:bg-gray-200">จัดการหมวดหมู่</button>
                                <button onclick="blogUI.showArticleEditor()" class="bg-primary text-white px-4 py-2 rounded text-sm font-bold hover:bg-opacity-80">+ เขียนบทความใหม่</button>
                            </div>
                        </div>
                        <div class="p-6">
                            <div class="overflow-x-auto">
                                <table class="w-full text-sm text-left text-gray-500 border border-gray-200 rounded-lg">
                                    <thead class="text-xs text-gray-700 uppercase bg-gray-50 border-b">
                                        <tr><th class="px-6 py-3">หัวข้อบทความ</th><th class="px-6 py-3">หมวดหมู่</th><th class="px-6 py-3">สถานะ</th><th class="px-6 py-3">วันที่เขียน</th><th class="px-6 py-3 text-right">จัดการ</th></tr>
                                    </thead>
                                    <tbody id="articles-tbody">
                                        <tr><td colspan="5" class="text-center py-4">กำลังโหลด...</td></tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="flex justify-between items-center mt-4">
                                <span class="text-sm text-gray-600" id="pagination-info">หน้า 1 จาก 1</span>
                                <div class="flex space-x-2">
                                    <button onclick="blogUI.prevPage()" class="px-3 py-1 bg-gray-200 rounded text-sm hover:bg-gray-300">« ก่อนหน้า</button>
                                    <button onclick="blogUI.nextPage()" class="px-3 py-1 bg-gray-200 rounded text-sm hover:bg-gray-300">ถัดไป »</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="article-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-gray-900/60 backdrop-blur-sm p-4">
                    <div class="bg-white rounded-xl shadow-2xl w-full max-w-4xl max-h-[90vh] flex flex-col overflow-hidden">
                        <div class="px-6 py-4 border-b flex justify-between items-center bg-gray-50">
                            <h3 class="text-lg font-bold" id="article-modal-title">เขียนบทความใหม่</h3>
                            <button onclick="blogUI.closeArticleEditor()" class="text-gray-500 hover:text-red-500 font-bold text-xl">&times;</button>
                        </div>
                        <div class="p-6 overflow-y-auto flex-1">
                            <input type="hidden" id="edit-article-id">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                                <div><label class="block text-sm font-bold mb-1">หัวข้อบทความ</label><input type="text" id="article-title" class="w-full border p-2 rounded"></div>
                                <div><label class="block text-sm font-bold mb-1">หมวดหมู่</label><select id="article-category" class="w-full border p-2 rounded"></select></div>
                            </div>
                            <div class="mb-4">
                                <label class="block text-sm font-bold mb-1">รูปภาพหน้าปก (Cover)</label>
                                <input type="file" id="article-cover" accept="image/*" class="w-full border p-1 rounded text-sm">
                            </div>
                            <div class="mb-4">
                                <label class="block text-sm font-bold mb-1">SEO Description (คำอธิบายแบบย่อ)</label>
                                <textarea id="article-seo" rows="2" class="w-full border p-2 rounded"></textarea>
                            </div>
                            <div class="mb-4">
                                <label class="block text-sm font-bold mb-1">เนื้อหาบทความ</label>
                                <div id="article-quill-editor" class="bg-white"></div>
                            </div>
                            <div class="mb-4 flex items-center">
                                <input type="checkbox" id="article-published" class="w-4 h-4 mr-2" checked>
                                <label class="text-sm font-bold text-gray-700">เผยแพร่บทความนี้ทันที</label>
                            </div>
                        </div>
                        <div class="px-6 py-4 border-t bg-gray-50 flex justify-end">
                            <button onclick="blogUI.saveArticle()" class="bg-primary text-white px-6 py-2 rounded font-bold shadow hover:bg-opacity-80">บันทึกบทความ</button>
                        </div>
                    </div>
                </div>

                <div id="category-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-gray-900/60 p-4">
                    <div class="bg-white rounded-xl shadow-2xl w-full max-w-md overflow-hidden">
                        <div class="px-6 py-4 border-b flex justify-between items-center">
                            <h3 class="text-lg font-bold">จัดการหมวดหมู่</h3>
                            <button onclick="document.getElementById('category-modal').classList.add('hidden')" class="text-gray-500 hover:text-red-500">&times;</button>
                        </div>
                        <div class="p-6">
                            <div class="flex space-x-2 mb-4">
                                <input type="text" id="new-category-name" placeholder="ชื่อหมวดหมู่ใหม่" class="flex-1 border p-2 rounded text-sm">
                                <button onclick="blogUI.addCategory()" class="bg-blue-600 text-white px-4 py-2 rounded text-sm">เพิ่ม</button>
                            </div>
                            <ul id="category-list" class="space-y-2 max-h-60 overflow-y-auto"></ul>
                        </div>
                    </div>
                </div>

            </div>
        </main>
    </div>

    <script>
        // ระบบ Tab หลัก
        function showTab(tabId, menuTitle) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.sidebar-menu-btn').forEach(el => {
                if(el.id !== 'btn-blog') { el.classList.remove('bg-gray-800', 'text-white'); el.classList.add('text-gray-400'); }
            });
            document.getElementById(tabId).classList.remove('hidden');
            let activeBtn = document.querySelector(`[data-target="${tabId}"]`);
            if(activeBtn && tabId !== 'tab-blog') { activeBtn.classList.add('bg-gray-800', 'text-white'); activeBtn.classList.remove('text-gray-400'); }
            
            if(tabId === 'tab-blog') {
                document.getElementById('main-settings-form').classList.add('hidden');
                document.getElementById('tab-blog').classList.remove('hidden');
                blogUI.loadArticles();
                blogUI.loadCategories();
            } else {
                document.getElementById('main-settings-form').classList.remove('hidden');
            }

            if(menuTitle) document.getElementById('page-title-display').innerText = menuTitle;
        }

        document.querySelectorAll('.sidebar-menu-btn').forEach(btn => {
            btn.addEventListener('click', (e) => showTab(e.currentTarget.dataset.target, e.currentTarget.innerText) );
        });
        showTab('tab-general', '1. ทั่วไป & Footer');

        // ควบคุม Sidebar Mobile
        document.getElementById('open-sidebar-btn').addEventListener('click', () => { document.getElementById('sidebar').classList.remove('-translate-x-full'); document.getElementById('mobile-sidebar-backdrop').classList.remove('hidden'); });
        document.getElementById('close-sidebar-btn').addEventListener('click', () => { document.getElementById('sidebar').classList.add('-translate-x-full'); document.getElementById('mobile-sidebar-backdrop').classList.add('hidden'); });
        
        // ควบคุม Dropdown
        document.getElementById('user-menu-btn').addEventListener('click', (e) => { e.stopPropagation(); document.getElementById('user-dropdown-panel').classList.toggle('hidden'); });
        document.addEventListener('click', () => document.getElementById('user-dropdown-panel').classList.add('hidden'));

        // ----------------------------------------------------
        // ระบบ Blog Management ด้วย Javascript (Fetch API)
        // ----------------------------------------------------
        const blogUI = {
            currentPage: 1, totalPages: 1, quillBlog: null, categories: [],
            
            initEditor: function() {
                if(!this.quillBlog) {
                    this.quillBlog = new Quill('#article-quill-editor', {
                        theme: 'snow',
                        modules: {
                            toolbar: {
                                container: [
                                    [{ 'header': [2, 3, 4, false] }],
                                    ['bold', 'italic', 'underline', 'strike', 'blockquote'],
                                    [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                                    ['link', 'image', 'video'], ['clean']
                                ],
                                handlers: { image: this.imageHandler }
                            }
                        }
                    });
                }
            },
            
            imageHandler: function() {
                const input = document.createElement('input');
                input.setAttribute('type', 'file');
                input.setAttribute('accept', 'image/*');
                input.click();
                input.onchange = async () => {
                    const file = input.files[0];
                    if(!file) return;
                    const formData = new FormData(); formData.append('image', file);
                    try {
                        const res = await fetch('/admin/api/upload-image', { method: 'POST', body: formData });
                        const data = await res.json();
                        if(data.success) {
                            const range = blogUI.quillBlog.getSelection();
                            blogUI.quillBlog.insertEmbed(range.index, 'image', data.url);
                        }
                    } catch(e) { alert("อัปโหลดรูปไม่สำเร็จ"); }
                };
            },

            loadCategories: async function() {
                const res = await fetch('/admin/api/categories');
                this.categories = await res.json();
                const select = document.getElementById('article-category');
                select.innerHTML = '<option value="">-- ไม่เลือกหมวดหมู่ --</option>';
                const list = document.getElementById('category-list'); list.innerHTML = '';
                
                this.categories.forEach(c => {
                    select.innerHTML += `<option value="${c.id}">${c.name}</option>`;
                    list.innerHTML += `<li class="flex justify-between items-center border p-2 rounded text-sm bg-gray-50"><span>${c.name}</span> <button onclick="blogUI.deleteCategory(${c.id})" class="text-red-500 hover:font-bold">ลบ</button></li>`;
                });
            },

            addCategory: async function() {
                const name = document.getElementById('new-category-name').value;
                if(!name) return;
                await fetch('/admin/api/categories', { method: 'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({name}) });
                document.getElementById('new-category-name').value = '';
                this.loadCategories();
            },

            deleteCategory: async function(id) {
                if(confirm('ยืนยันลบหมวดหมู่? บทความในหมวดนี้จะกลายเป็นไม่มีหมวดหมู่')) {
                    await fetch(`/admin/api/categories/${id}`, { method: 'DELETE' });
                    this.loadCategories();
                }
            },

            showCategoryModal: function() { document.getElementById('category-modal').classList.remove('hidden'); document.getElementById('category-modal').classList.add('flex'); },
            
            loadArticles: async function() {
                const tbody = document.getElementById('articles-tbody'); tbody.innerHTML = '<tr><td colspan="5" class="text-center py-4">กำลังโหลด...</td></tr>';
                const res = await fetch(`/admin/api/articles?page=${this.currentPage}`);
                const data = await res.json();
                this.totalPages = data.totalPages || 1;
                document.getElementById('pagination-info').innerText = `หน้า ${this.currentPage} จาก ${this.totalPages}`;
                
                tbody.innerHTML = '';
                if(data.articles.length === 0) tbody.innerHTML = '<tr><td colspan="5" class="text-center py-4">ยังไม่มีบทความ</td></tr>';
                
                data.articles.forEach(a => {
                    const status = a.is_published ? '<span class="px-2 py-1 bg-green-100 text-green-700 rounded text-xs">เผยแพร่</span>' : '<span class="px-2 py-1 bg-gray-100 text-gray-700 rounded text-xs">ซ่อน</span>';
                    tbody.innerHTML += `
                        <tr class="bg-white border-b hover:bg-gray-50">
                            <td class="px-6 py-4 font-medium text-gray-900">${a.title}</td>
                            <td class="px-6 py-4">${a.category_name || '-'}</td>
                            <td class="px-6 py-4">${status}</td>
                            <td class="px-6 py-4 text-xs text-gray-500">${new Date(a.created_at).toLocaleDateString('th-TH')}</td>
                            <td class="px-6 py-4 text-right space-x-2">
                                <button onclick="blogUI.editArticle(${a.id})" class="text-blue-600 hover:underline">แก้ไข</button>
                                <button onclick="blogUI.deleteArticle(${a.id})" class="text-red-600 hover:underline">ลบ</button>
                            </td>
                        </tr>
                    `;
                });
            },

            prevPage: function() { if(this.currentPage > 1) { this.currentPage--; this.loadArticles(); } },
            nextPage: function() { if(this.currentPage < this.totalPages) { this.currentPage++; this.loadArticles(); } },

            showArticleEditor: function() {
                this.initEditor();
                document.getElementById('edit-article-id').value = '';
                document.getElementById('article-title').value = '';
                document.getElementById('article-category').value = '';
                document.getElementById('article-seo').value = '';
                document.getElementById('article-cover').value = '';
                document.getElementById('article-published').checked = true;
                this.quillBlog.root.innerHTML = '';
                document.getElementById('article-modal-title').innerText = 'เขียนบทความใหม่';
                
                document.getElementById('article-modal').classList.remove('hidden');
                document.getElementById('article-modal').classList.add('flex');
            },

            closeArticleEditor: function() { document.getElementById('article-modal').classList.add('hidden'); document.getElementById('article-modal').classList.remove('flex'); },

            editArticle: async function(id) {
                this.showArticleEditor();
                document.getElementById('article-modal-title').innerText = 'กำลังโหลดข้อมูล...';
                const res = await fetch(`/admin/api/articles/${id}`);
                const a = await res.json();
                
                document.getElementById('edit-article-id').value = a.id;
                document.getElementById('article-title').value = a.title;
                document.getElementById('article-category').value = a.category_id || '';
                document.getElementById('article-seo').value = a.seo_description || '';
                document.getElementById('article-published').checked = a.is_published;
                this.quillBlog.root.innerHTML = a.content || '';
                document.getElementById('article-modal-title').innerText = 'แก้ไขบทความ';
            },

            saveArticle: async function() {
                const id = document.getElementById('edit-article-id').value;
                const formData = new FormData();
                formData.append('title', document.getElementById('article-title').value);
                formData.append('category_id', document.getElementById('article-category').value);
                formData.append('seo_description', document.getElementById('article-seo').value);
                formData.append('content', this.quillBlog.root.innerHTML);
                formData.append('is_published', document.getElementById('article-published').checked);
                
                const file = document.getElementById('article-cover').files[0];
                if(file) formData.append('cover_image', file);

                const url = id ? `/admin/api/articles/${id}` : '/admin/api/articles';
                const method = id ? 'PUT' : 'POST';

                document.getElementById('article-modal-title').innerText = 'กำลังบันทึก...';
                await fetch(url, { method: method, body: formData });
                
                this.closeArticleEditor();
                this.loadArticles();
            },

            deleteArticle: async function(id) {
                if(confirm('ยืนยันลบบทความถาวร?')) {
                    await fetch(`/admin/api/articles/${id}`, { method: 'DELETE' });
                    this.loadArticles();
                }
            }
        };
    </script>
</body>
</html>