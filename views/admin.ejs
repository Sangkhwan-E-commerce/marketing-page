    <script>
        const pageTitleDisplay = document.getElementById('page-title-display');
        
        function showTab(tabId, menuTitle) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.sidebar-menu-btn').forEach(el => {
                el.classList.remove('bg-gray-800', 'text-white');
                el.classList.add('text-gray-400');
            });
            document.getElementById(tabId).classList.remove('hidden');
            let activeBtn = document.querySelector(`[data-target="${tabId}"]`);
            if(activeBtn) {
                activeBtn.classList.add('bg-gray-800', 'text-white');
                activeBtn.classList.remove('text-gray-400');
                if(menuTitle) pageTitleDisplay.innerText = menuTitle;
            }
            
            // สลับการซ่อน/แสดง ฟอร์มหลัก กับ ระบบ Blog
            const mainForm = document.getElementById('main-settings-form');
            if (mainForm) {
                if(tabId === 'tab-blog') {
                    mainForm.classList.add('hidden');
                    blogUI.loadArticles();
                    blogUI.loadCategories();
                } else {
                    mainForm.classList.remove('hidden');
                }
            }

            if (window.innerWidth < 768) {
                document.getElementById('sidebar').classList.add('-translate-x-full');
                document.getElementById('mobile-sidebar-backdrop').classList.add('hidden');
            }
        }

        document.querySelectorAll('.sidebar-menu-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const targetId = e.currentTarget.dataset.target;
                const menuTitle = e.currentTarget.innerText;
                showTab(targetId, menuTitle);
            });
        });
        showTab('tab-general', '1. ทั่วไป & Footer');

        document.getElementById('open-sidebar-btn').addEventListener('click', () => {
            document.getElementById('sidebar').classList.remove('-translate-x-full');
            document.getElementById('mobile-sidebar-backdrop').classList.remove('hidden');
        });
        document.getElementById('close-sidebar-btn').addEventListener('click', () => {
            document.getElementById('sidebar').classList.add('-translate-x-full');
            document.getElementById('mobile-sidebar-backdrop').classList.add('hidden');
        });
        document.getElementById('user-menu-btn').addEventListener('click', (e) => {
            e.stopPropagation();
            document.getElementById('user-dropdown-panel').classList.toggle('hidden');
        });
        document.addEventListener('click', () => document.getElementById('user-dropdown-panel').classList.add('hidden'));

        document.querySelectorAll('.quill-editor').forEach(function(editorDiv) {
            var targetId = editorDiv.getAttribute('data-target');
            var input = document.getElementById(targetId);
            var quill = new Quill(editorDiv, { theme: 'snow', modules: { toolbar: [ ['bold', 'italic', 'underline'], [{'list': 'ordered'}, {'list': 'bullet'}], ['clean'] ] } });
            quill.on('text-change', function() { input.value = quill.root.innerHTML; });
            input.value = quill.root.innerHTML;
        });

        // --- ระบบ FAQ ---
        const faqContainer = document.getElementById('faq-container');
        const faqInput = document.getElementById('faq_list_input');
        let faqs = [];
        try { faqs = JSON.parse(faqInput.value || '[]'); } catch(e) { faqs = []; }

        function renderFaqs() {
            faqContainer.innerHTML = '';
            faqs.forEach((faq, index) => {
                const div = document.createElement('div');
                div.className = 'bg-white p-5 rounded border relative mt-2';
                const safeQuestion = faq.question ? faq.question.replace(/"/g, '&quot;') : '';
                
                let actionButtons = `
                    <div class="absolute top-2 right-2 flex space-x-2">
                        ${index > 0 ? `<button type="button" onclick="moveFaq(${index}, -1)" class="text-blue-600 hover:text-white hover:bg-blue-600 border border-blue-600 font-bold px-2 py-1 rounded text-xs transition">▲ ขึ้น</button>` : ''}
                        ${index < faqs.length - 1 ? `<button type="button" onclick="moveFaq(${index}, 1)" class="text-blue-600 hover:text-white hover:bg-blue-600 border border-blue-600 font-bold px-2 py-1 rounded text-xs transition">▼ ลง</button>` : ''}
                        <button type="button" onclick="removeFaq(${index})" class="text-red-500 hover:text-white hover:bg-red-500 border border-red-500 font-bold px-2 py-1 rounded text-xs transition">✖ ลบ</button>
                    </div>
                `;
                div.innerHTML = `
                    ${actionButtons}
                    <div class="pr-32">
                        <label class="block text-sm font-semibold mb-1">คำถาม</label>
                        <input type="text" class="w-full border p-2 text-sm mb-2" value="${safeQuestion}" onchange="updateFaq(${index}, 'question', this.value)">
                    </div>
                    <label class="block text-sm font-semibold mb-1">คำตอบ</label>
                    <div id="faq_editor_${index}" class="bg-white h-24"></div>
                `;
                faqContainer.appendChild(div);
                
                const quillFaq = new Quill(document.getElementById(`faq_editor_${index}`), { 
                    theme: 'snow',
                    modules: { toolbar: [ ['bold', 'italic', 'underline'], [{'list': 'ordered'}, {'list': 'bullet'}], ['clean'] ] }
                });
                quillFaq.root.innerHTML = faq.answer || '';
                quillFaq.on('text-change', () => { 
                    faqs[index].answer = quillFaq.root.innerHTML; 
                    faqInput.value = JSON.stringify(faqs); 
                });
            });
            faqInput.value = JSON.stringify(faqs);
        }

        window.moveFaq = (index, direction) => {
            const newIndex = index + direction;
            if (newIndex >= 0 && newIndex < faqs.length) {
                const temp = faqs[index];
                faqs[index] = faqs[newIndex];
                faqs[newIndex] = temp;
                renderFaqs();
            }
        };
        window.updateFaq = (index, key, value) => { faqs[index][key] = value; faqInput.value = JSON.stringify(faqs); };
        window.removeFaq = (index) => { if(confirm('ลบคำถามนี้?')) { faqs.splice(index, 1); renderFaqs(); } };
        document.getElementById('add-faq-btn').addEventListener('click', () => { faqs.push({ question: '', answer: '' }); renderFaqs(); });
        
        renderFaqs();

        // --- โครงสร้างหน้าเว็บ (ลำดับ / ซ่อน / สีพื้นหลังของแต่ละส่วน) ---
        const SECTION_CATALOGUE = <%- JSON.stringify(sectionCatalogue) %>;
        const SECTION_BGS = <%- JSON.stringify(sectionBgs) %>;

        const layoutContainer = document.getElementById('layout-container');
        const layoutInput = document.getElementById('section_order_input');
        let pageSections = [];
        try { pageSections = JSON.parse(layoutInput.value || '[]'); } catch(e) { pageSections = []; }

        // ตัดส่วนที่ไม่รู้จักทิ้ง แล้วเติมส่วนที่ยังไม่มีต่อท้าย (ตรรกะเดียวกับฝั่งเซิร์ฟเวอร์)
        (function normalize() {
            const seen = new Set();
            pageSections = pageSections.filter(s => {
                const meta = SECTION_CATALOGUE.find(m => m.type === (s || {}).type);
                if (!meta || seen.has(meta.type)) return false;
                seen.add(meta.type);
                if (!SECTION_BGS.some(b => b.id === s.bg)) s.bg = meta.defaultBg;
                s.enabled = s.enabled !== false;
                return true;
            });
            SECTION_CATALOGUE.forEach(meta => {
                if (!seen.has(meta.type)) pageSections.push({ type: meta.type, enabled: true, bg: meta.defaultBg });
            });
        })();

        const layoutSyncInput = () => { layoutInput.value = JSON.stringify(pageSections); };

        function renderPageSections() {
            layoutContainer.innerHTML = '';
            pageSections.forEach((sec, index) => {
                const meta = SECTION_CATALOGUE.find(m => m.type === sec.type);
                const row = document.createElement('div');
                row.className = 'flex flex-wrap items-center gap-3 bg-white border rounded p-3 ' + (sec.enabled ? '' : 'opacity-60');
                row.innerHTML = `
                    <span class="w-6 text-center text-xs font-bold text-gray-400">${index + 1}</span>
                    <span class="flex-1 min-w-[10rem] font-semibold text-sm">${meta.name}</span>
                    <label class="flex items-center gap-1 text-xs text-gray-600">
                        <input type="checkbox" ${sec.enabled ? 'checked' : ''} onchange="toggleSection(${index}, this.checked)" class="h-4 w-4"> แสดง
                    </label>
                    ${meta.bgEditable ? `
                    <select onchange="updateSectionBg(${index}, this.value)" class="border p-1 text-xs rounded">
                        ${SECTION_BGS.map(b => `<option value="${b.id}" ${sec.bg === b.id ? 'selected' : ''}>${b.name}</option>`).join('')}
                    </select>` : '<span class="text-xs text-gray-400">พื้นหลังตามเลย์เอาต์</span>'}
                    <div class="flex space-x-1">
                        ${index > 0 ? `<button type="button" onclick="movePageSection(${index}, -1)" class="text-blue-600 hover:text-white hover:bg-blue-600 border border-blue-600 font-bold px-2 py-1 rounded text-xs transition">▲</button>` : ''}
                        ${index < pageSections.length - 1 ? `<button type="button" onclick="movePageSection(${index}, 1)" class="text-blue-600 hover:text-white hover:bg-blue-600 border border-blue-600 font-bold px-2 py-1 rounded text-xs transition">▼</button>` : ''}
                    </div>
                `;
                layoutContainer.appendChild(row);
            });
            layoutSyncInput();
        }

        window.movePageSection = (index, direction) => {
            const newIndex = index + direction;
            if (newIndex >= 0 && newIndex < pageSections.length) {
                const temp = pageSections[index];
                pageSections[index] = pageSections[newIndex];
                pageSections[newIndex] = temp;
                renderPageSections();
            }
        };
        window.toggleSection = (index, enabled) => { pageSections[index].enabled = enabled; renderPageSections(); };
        window.updateSectionBg = (index, bg) => { pageSections[index].bg = bg; layoutSyncInput(); };

        renderPageSections();

        // --- ระบบ Hero (หลายบล็อก + เลือกเลย์เอาต์) ---
        const HERO_TPL = <%- JSON.stringify(templates.hero) %>;
        const FEATURE_TPL = <%- JSON.stringify(templates.features) %>;
        const BTN_STYLES = [['primary', 'ปุ่มหลัก'], ['secondary', 'ปุ่มรอง'], ['link', 'ลิงก์ข้อความ']];
        const BTN_SIZES = [['text-sm', 'เล็ก'], ['text-base', 'ปกติ'], ['text-lg', 'ใหญ่']];

        const heroContainer = document.getElementById('hero-container');
        const heroInput = document.getElementById('hero_list_input');
        const heroEmpty = document.getElementById('hero-empty');
        const heroCount = document.getElementById('hero-count');
        let heroBlocks = [];
        try { heroBlocks = JSON.parse(heroInput.value || '[]'); } catch(e) { heroBlocks = []; }

        const heroEscAttr = (str) => (str || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;');
        const heroTplNeedsImage = (id) => { const t = HERO_TPL.find(t => t.id === id); return t ? t.image : false; };
        const heroSyncInput = () => { heroInput.value = JSON.stringify(heroBlocks); };

        function heroButtonRow(blockIndex, btn, btnIndex) {
            const opt = (list, current) => list.map(([v, label]) =>
                `<option value="${v}" ${current === v ? 'selected' : ''}>${label}</option>`).join('');
            return `
                <div class="grid grid-cols-1 md:grid-cols-12 gap-2 items-center bg-white border rounded p-2">
                    <input type="text" class="md:col-span-3 border p-2 text-sm" placeholder="ข้อความบนปุ่ม" value="${heroEscAttr(btn.text)}" oninput="updateHeroButton(${blockIndex}, ${btnIndex}, 'text', this.value)">
                    <input type="text" class="md:col-span-4 border p-2 text-sm" placeholder="URL" value="${heroEscAttr(btn.url)}" oninput="updateHeroButton(${blockIndex}, ${btnIndex}, 'url', this.value)">
                    <select class="md:col-span-2 border p-2 text-sm" onchange="updateHeroButton(${blockIndex}, ${btnIndex}, 'style', this.value)">${opt(BTN_STYLES, btn.style)}</select>
                    <select class="md:col-span-2 border p-2 text-sm" onchange="updateHeroButton(${blockIndex}, ${btnIndex}, 'size', this.value)">${opt(BTN_SIZES, btn.size)}</select>
                    <button type="button" onclick="removeHeroButton(${blockIndex}, ${btnIndex})" class="md:col-span-1 text-red-500 hover:text-white hover:bg-red-500 border border-red-500 font-bold px-2 py-1 rounded text-xs transition">✖</button>
                </div>`;
        }

        function renderHeroBlocks() {
            heroContainer.innerHTML = '';
            heroEmpty.classList.toggle('hidden', heroBlocks.length > 0);
            heroCount.innerText = heroBlocks.length;

            heroBlocks.forEach((block, index) => {
                const buttons = Array.isArray(block.buttons) ? block.buttons : (block.buttons = []);
                const div = document.createElement('div');
                div.className = 'bg-gray-50/50 p-5 rounded-lg border border-gray-200 space-y-3';
                div.innerHTML = `
                    <div class="flex justify-between items-center border-b pb-2">
                        <h4 class="font-semibold">บล็อก ${index + 1}${index === 0 ? ' <span class="text-xs font-normal text-gray-500">(หัวข้อจะเป็น H1)</span>' : ''}</h4>
                        <div class="flex space-x-2">
                            ${index > 0 ? `<button type="button" onclick="moveHeroBlock(${index}, -1)" class="text-blue-600 hover:text-white hover:bg-blue-600 border border-blue-600 font-bold px-2 py-1 rounded text-xs transition">▲ ขึ้น</button>` : ''}
                            ${index < heroBlocks.length - 1 ? `<button type="button" onclick="moveHeroBlock(${index}, 1)" class="text-blue-600 hover:text-white hover:bg-blue-600 border border-blue-600 font-bold px-2 py-1 rounded text-xs transition">▼ ลง</button>` : ''}
                            <button type="button" onclick="removeHeroBlock(${index})" class="text-red-500 hover:text-white hover:bg-red-500 border border-red-500 font-bold px-2 py-1 rounded text-xs transition">✖ ลบ</button>
                        </div>
                    </div>

                    <label class="block text-xs font-semibold text-gray-600">เลย์เอาต์ (Template)</label>
                    <select class="w-full border p-2 text-sm" onchange="setHeroTemplate(${index}, this.value)">
                        ${HERO_TPL.map(t => `<option value="${t.id}" ${block.template === t.id ? 'selected' : ''}>${t.name}</option>`).join('')}
                    </select>

                    <label class="block text-xs font-semibold text-gray-600">ข้อความ Badge</label>
                    <input type="text" class="w-full border p-2 text-sm" value="${heroEscAttr(block.badge)}" oninput="updateHeroBlock(${index}, 'badge', this.value)">

                    <label class="block text-xs font-semibold text-gray-600">หัวข้อหลัก</label>
                    <input type="text" class="w-full border p-2 text-sm" value="${heroEscAttr(block.title)}" oninput="updateHeroBlock(${index}, 'title', this.value)">

                    <label class="block text-xs font-semibold text-gray-600">รายละเอียด</label>
                    <div id="hero_editor_${index}" class="bg-white" style="height: 120px;"></div>

                    <div class="pt-8 ${heroTplNeedsImage(block.template) ? '' : 'hidden'}">
                        <label class="block text-xs font-semibold text-gray-600 mb-1">รูปภาพประกอบ</label>
                        <input type="file" accept="image/*" onchange="uploadHeroImage(event, ${index})" class="w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-primary file:text-white hover:file:bg-opacity-80">
                        <p id="hero_img_status_${index}" class="text-xs text-gray-500 mt-1"></p>
                        <img id="hero_img_preview_${index}" src="${heroEscAttr(block.image)}" class="mt-2 max-h-28 w-auto rounded border border-gray-200 ${block.image ? '' : 'hidden'}">
                    </div>

                    <div class="pt-3 border-t">
                        <div class="flex justify-between items-center mb-2">
                            <label class="block text-xs font-semibold text-gray-600">ปุ่ม (${buttons.length})</label>
                            <button type="button" onclick="addHeroButton(${index})" class="bg-white px-2 py-1 text-xs border rounded hover:bg-gray-100">+ เพิ่มปุ่ม</button>
                        </div>
                        <div class="space-y-2">${buttons.map((btn, bi) => heroButtonRow(index, btn, bi)).join('')}</div>
                    </div>
                `;
                heroContainer.appendChild(div);

                const quillHero = new Quill(document.getElementById(`hero_editor_${index}`), {
                    theme: 'snow',
                    modules: { toolbar: [ ['bold', 'italic', 'underline'], [{'list': 'ordered'}, {'list': 'bullet'}], ['clean'] ] }
                });
                quillHero.root.innerHTML = block.desc || '';
                quillHero.on('text-change', () => {
                    heroBlocks[index].desc = quillHero.root.innerHTML;
                    heroSyncInput();
                });
            });
            heroSyncInput();
        }

        window.moveHeroBlock = (index, direction) => {
            const newIndex = index + direction;
            if (newIndex >= 0 && newIndex < heroBlocks.length) {
                const temp = heroBlocks[index];
                heroBlocks[index] = heroBlocks[newIndex];
                heroBlocks[newIndex] = temp;
                renderHeroBlocks();
            }
        };
        window.removeHeroBlock = (index) => { if(confirm('ลบบล็อกนี้?')) { heroBlocks.splice(index, 1); renderHeroBlocks(); } };
        window.updateHeroBlock = (index, key, value) => { heroBlocks[index][key] = value; heroSyncInput(); };
        window.setHeroTemplate = (index, value) => { heroBlocks[index].template = value; renderHeroBlocks(); };

        window.addHeroButton = (index) => {
            heroBlocks[index].buttons = heroBlocks[index].buttons || [];
            heroBlocks[index].buttons.push({ text: '', url: '#', style: 'primary', size: 'text-sm' });
            renderHeroBlocks();
        };
        window.removeHeroButton = (index, btnIndex) => { heroBlocks[index].buttons.splice(btnIndex, 1); renderHeroBlocks(); };
        window.updateHeroButton = (index, btnIndex, key, value) => { heroBlocks[index].buttons[btnIndex][key] = value; heroSyncInput(); };

        window.uploadHeroImage = async (event, index) => {
            const file = event.target.files[0];
            if (!file) return;
            const status = document.getElementById(`hero_img_status_${index}`);
            status.innerText = 'กำลังอัปโหลด...';
            const formData = new FormData();
            formData.append('media', file);
            try {
                const res = await fetch('/admin/api/upload-media', { method: 'POST', body: formData });
                const data = await res.json();
                if (!data.success) throw new Error(data.message || 'อัปโหลดไม่สำเร็จ');
                heroBlocks[index].image = data.url;
                heroSyncInput();
                const preview = document.getElementById(`hero_img_preview_${index}`);
                preview.src = data.url;
                preview.classList.remove('hidden');
                status.innerText = 'อัปโหลดสำเร็จ';
            } catch (err) {
                status.innerText = err.message || 'อัปโหลดไม่สำเร็จ';
            }
        };

        document.getElementById('add-hero-btn').addEventListener('click', () => {
            heroBlocks.push({ template: 'split-with-image', badge: '', title: '', desc: '', image: '', buttons: [] });
            renderHeroBlocks();
        });

        renderHeroBlocks();

        // --- ภาพประกอบของเลย์เอาต์ที่ต้องใช้รูป (ส่วนวิสัยทัศน์ / ฟีเจอร์หลัก) ---
        window.toggleSectionImage = (prefix) => {
            const tplId = document.getElementById(`${prefix}_template`).value;
            const tpl = FEATURE_TPL.find(t => t.id === tplId);
            document.getElementById(`${prefix}_image_wrap`).classList.toggle('hidden', !(tpl && tpl.image));
        };

        window.uploadSectionImage = async (event, prefix) => {
            const file = event.target.files[0];
            if (!file) return;
            const status = document.getElementById(`${prefix}_img_status`);
            status.innerText = 'กำลังอัปโหลด...';
            const formData = new FormData();
            formData.append('media', file);
            try {
                const res = await fetch('/admin/api/upload-media', { method: 'POST', body: formData });
                const data = await res.json();
                if (!data.success) throw new Error(data.message || 'อัปโหลดไม่สำเร็จ');
                document.getElementById(`${prefix}_img_url`).value = data.url;
                const preview = document.getElementById(`${prefix}_img_preview`);
                preview.src = data.url;
                preview.classList.remove('hidden');
                status.innerText = 'อัปโหลดสำเร็จ';
            } catch (err) {
                status.innerText = err.message || 'อัปโหลดไม่สำเร็จ';
            }
        };

        toggleSectionImage('col');
        toggleSectionImage('grid');

        // --- ระบบวิสัยทัศน์ (เพิ่ม/ลด/สลับลำดับได้) ---
        const colContainer = document.getElementById('col-container');
        const colInput = document.getElementById('col_list_input');
        const colEmpty = document.getElementById('col-empty');
        const colCount = document.getElementById('col-count');
        let visionCols = [];
        try { visionCols = JSON.parse(colInput.value || '[]'); } catch(e) { visionCols = []; }

        const colEscAttr = (str) => (str || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;');
        const colEscText = (str) => (str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

        function renderVisionCols() {
            colContainer.innerHTML = '';
            colEmpty.classList.toggle('hidden', visionCols.length > 0);
            colCount.innerText = visionCols.length;

            visionCols.forEach((col, index) => {
                const div = document.createElement('div');
                div.className = 'space-y-2 bg-gray-50/50 p-4 rounded-lg border border-gray-100';
                div.innerHTML = `
                    <div class="flex justify-between items-center border-b pb-2">
                        <h4 class="font-semibold">คอลัมน์ ${index + 1}</h4>
                        <div class="flex space-x-2">
                            ${index > 0 ? `<button type="button" onclick="moveVisionCol(${index}, -1)" class="text-blue-600 hover:text-white hover:bg-blue-600 border border-blue-600 font-bold px-2 py-1 rounded text-xs transition">▲ ขึ้น</button>` : ''}
                            ${index < visionCols.length - 1 ? `<button type="button" onclick="moveVisionCol(${index}, 1)" class="text-blue-600 hover:text-white hover:bg-blue-600 border border-blue-600 font-bold px-2 py-1 rounded text-xs transition">▼ ลง</button>` : ''}
                            <button type="button" onclick="removeVisionCol(${index})" class="text-red-500 hover:text-white hover:bg-red-500 border border-red-500 font-bold px-2 py-1 rounded text-xs transition">✖ ลบ</button>
                        </div>
                    </div>
                    <label class="block text-xs font-semibold text-gray-600">ไอคอน (โค้ด SVG)</label>
                    <textarea rows="2" class="w-full border p-2 text-xs font-mono" placeholder="วางโค้ด SVG ที่นี่" oninput="updateVisionCol(${index}, 'icon', this.value)">${colEscText(col.icon)}</textarea>
                    <label class="block text-xs font-semibold text-gray-600">หัวข้อ</label>
                    <input type="text" class="w-full border p-2 text-sm" value="${colEscAttr(col.title)}" oninput="updateVisionCol(${index}, 'title', this.value)">
                    <label class="block text-xs font-semibold text-gray-600">รายละเอียด</label>
                    <div id="col_editor_${index}" class="bg-white" style="height: 100px;"></div>
                    <div class="flex items-center gap-2 pt-8">
                        <input type="checkbox" id="col_highlight_${index}" ${col.highlight ? 'checked' : ''} onchange="updateVisionCol(${index}, 'highlight', this.checked)" class="h-4 w-4">
                        <label for="col_highlight_${index}" class="text-xs font-semibold text-gray-600">เน้นเป็นการ์ดแนะนำ</label>
                        <input type="text" class="flex-1 border p-2 text-sm" placeholder="ข้อความป้าย เช่น คุ้มค่าที่สุด" value="${colEscAttr(col.badge)}" oninput="updateVisionCol(${index}, 'badge', this.value)">
                    </div>
                `;
                colContainer.appendChild(div);

                const quillCol = new Quill(document.getElementById(`col_editor_${index}`), {
                    theme: 'snow',
                    modules: { toolbar: [ ['bold', 'italic', 'underline'], [{'list': 'ordered'}, {'list': 'bullet'}], ['clean'] ] }
                });
                quillCol.root.innerHTML = col.desc || '';
                quillCol.on('text-change', () => {
                    visionCols[index].desc = quillCol.root.innerHTML;
                    colInput.value = JSON.stringify(visionCols);
                });
            });
            colInput.value = JSON.stringify(visionCols);
        }

        window.moveVisionCol = (index, direction) => {
            const newIndex = index + direction;
            if (newIndex >= 0 && newIndex < visionCols.length) {
                const temp = visionCols[index];
                visionCols[index] = visionCols[newIndex];
                visionCols[newIndex] = temp;
                renderVisionCols();
            }
        };
        window.updateVisionCol = (index, key, value) => { visionCols[index][key] = value; colInput.value = JSON.stringify(visionCols); };
        window.removeVisionCol = (index) => { if(confirm('ลบคอลัมน์นี้?')) { visionCols.splice(index, 1); renderVisionCols(); } };
        document.getElementById('add-col-btn').addEventListener('click', () => { visionCols.push({ icon: '', title: '', desc: '', highlight: false, badge: '' }); renderVisionCols(); });

        renderVisionCols();

        // --- ระบบฟีเจอร์หลัก (เพิ่ม/ลด/สลับลำดับได้) ---
        const gridContainer = document.getElementById('grid-container');
        const gridInput = document.getElementById('grid_list_input');
        const gridEmpty = document.getElementById('grid-empty');
        const gridCount = document.getElementById('grid-count');
        let gridFeatures = [];
        try { gridFeatures = JSON.parse(gridInput.value || '[]'); } catch(e) { gridFeatures = []; }

        const gridEscAttr = (str) => (str || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;');
        const gridEscText = (str) => (str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

        function renderGridFeatures() {
            gridContainer.innerHTML = '';
            gridEmpty.classList.toggle('hidden', gridFeatures.length > 0);
            gridCount.innerText = gridFeatures.length;

            gridFeatures.forEach((feature, index) => {
                const div = document.createElement('div');
                div.className = 'space-y-2 bg-gray-50/50 p-4 rounded-lg border border-gray-100';
                div.innerHTML = `
                    <div class="flex justify-between items-center border-b pb-2">
                        <h4 class="font-semibold">ฟีเจอร์ ${index + 1}</h4>
                        <div class="flex space-x-2">
                            ${index > 0 ? `<button type="button" onclick="moveGridFeature(${index}, -1)" class="text-blue-600 hover:text-white hover:bg-blue-600 border border-blue-600 font-bold px-2 py-1 rounded text-xs transition">▲ ขึ้น</button>` : ''}
                            ${index < gridFeatures.length - 1 ? `<button type="button" onclick="moveGridFeature(${index}, 1)" class="text-blue-600 hover:text-white hover:bg-blue-600 border border-blue-600 font-bold px-2 py-1 rounded text-xs transition">▼ ลง</button>` : ''}
                            <button type="button" onclick="removeGridFeature(${index})" class="text-red-500 hover:text-white hover:bg-red-500 border border-red-500 font-bold px-2 py-1 rounded text-xs transition">✖ ลบ</button>
                        </div>
                    </div>
                    <label class="block text-xs font-semibold text-gray-600">ไอคอน (โค้ด SVG)</label>
                    <textarea rows="2" class="w-full border p-2 text-xs font-mono" placeholder="วางโค้ด SVG ที่นี่" oninput="updateGridFeature(${index}, 'icon', this.value)">${gridEscText(feature.icon)}</textarea>
                    <label class="block text-xs font-semibold text-gray-600">หัวข้อ</label>
                    <input type="text" class="w-full border p-2 text-sm" value="${gridEscAttr(feature.title)}" oninput="updateGridFeature(${index}, 'title', this.value)">
                    <label class="block text-xs font-semibold text-gray-600">รายละเอียด</label>
                    <textarea rows="2" class="w-full border p-2 text-sm" oninput="updateGridFeature(${index}, 'desc', this.value)">${gridEscText(feature.desc)}</textarea>
                `;
                gridContainer.appendChild(div);
            });
            gridInput.value = JSON.stringify(gridFeatures);
        }

        window.moveGridFeature = (index, direction) => {
            const newIndex = index + direction;
            if (newIndex >= 0 && newIndex < gridFeatures.length) {
                const temp = gridFeatures[index];
                gridFeatures[index] = gridFeatures[newIndex];
                gridFeatures[newIndex] = temp;
                renderGridFeatures();
            }
        };
        window.updateGridFeature = (index, key, value) => { gridFeatures[index][key] = value; gridInput.value = JSON.stringify(gridFeatures); };
        window.removeGridFeature = (index) => { if(confirm('ลบฟีเจอร์นี้?')) { gridFeatures.splice(index, 1); renderGridFeatures(); } };
        document.getElementById('add-grid-btn').addEventListener('click', () => { gridFeatures.push({ icon: '', title: '', desc: '' }); renderGridFeatures(); });

        renderGridFeatures();

        // --- ระบบ Banner Carousel ---
        const bannerContainer = document.getElementById('banner-container');
        const bannerInput = document.getElementById('banner_list_input');
        let banners = [];
        try { banners = JSON.parse(bannerInput.value || '[]'); } catch(e) { banners = []; }
        let quillBanners = [];

        function renderBanners() {
            bannerContainer.innerHTML = '';
            quillBanners = [];

            if (banners.length === 0) {
                bannerContainer.innerHTML = '<p class="text-center text-gray-500 py-4">ยังไม่มีสไลด์โฆษณา กดปุ่ม "+ เพิ่มสไลด์ใหม่" ด้านบน</p>';
                bannerInput.value = '[]';
                return;
            }

            banners.forEach((banner, index) => {
                const div = document.createElement('div');
                div.className = 'bg-gray-50 p-5 rounded-lg border border-gray-200 relative mb-4';
                
                let actionButtons = `
                    <div class="absolute top-3 right-3 flex space-x-2 z-10">
                        ${index > 0 ? `<button type="button" onclick="moveBanner(${index}, -1)" class="bg-white text-blue-600 hover:text-white hover:bg-blue-600 border border-blue-600 font-bold px-2 py-1 rounded text-xs transition shadow-sm">▲ ขึ้น</button>` : ''}
                        ${index < banners.length - 1 ? `<button type="button" onclick="moveBanner(${index}, 1)" class="bg-white text-blue-600 hover:text-white hover:bg-blue-600 border border-blue-600 font-bold px-2 py-1 rounded text-xs transition shadow-sm">▼ ลง</button>` : ''}
                        <button type="button" onclick="removeBanner(${index})" class="bg-white text-red-500 hover:text-white hover:bg-red-500 border border-red-500 font-bold px-2 py-1 rounded text-xs transition shadow-sm">✖ ลบ</button>
                    </div>
                `;
                div.innerHTML = `
                    ${actionButtons}
                    <div class="pr-40 mb-4 flex items-center space-x-2">
                        <span class="bg-primary text-white font-bold w-6 h-6 flex items-center justify-center rounded-full text-xs"> ${index + 1} </span>
                        <h4 class="font-bold text-gray-700">สไลด์ที่ ${index + 1}</h4>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                        <div>
                            <label class="block text-sm font-semibold mb-1">รูปภาพแบนเนอร์</label>
                            <div class="flex space-x-2">
                                <input type="text" id="img_input_${index}" class="flex-1 border border-gray-300 p-2 text-sm rounded bg-gray-50 focus:bg-white transition" value="${banner.img_url || ''}" onchange="updateBanner(${index}, 'img_url', this.value)" placeholder="อัปโหลดรูป หรือ วางลิงก์...">
                                <label class="bg-blue-600 text-white px-3 py-2 rounded shadow-sm hover:bg-blue-700 cursor-pointer text-sm font-semibold flex items-center justify-center whitespace-nowrap transition">
                                    <svg class="w-4 h-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg>
                                    อัปโหลด
                                    <input type="file" class="hidden" accept="image/*" onchange="uploadSlideImage(event, ${index})">
                                </label>
                            </div>
                            ${banner.img_url ? `<img src="${banner.img_url}" class="mt-3 h-24 w-auto rounded border border-gray-200 object-cover shadow-sm">` : ''}
                        </div>
                        <div>
                            <label class="block text-sm font-semibold mb-1">ลิงก์ปลายทางเมื่อคลิกรูป (ถ้ามี)</label>
                            <input type="url" class="w-full border border-gray-300 p-2 text-sm rounded focus:border-primary transition" value="${banner.link_url || ''}" onchange="updateBanner(${index}, 'link_url', this.value)" placeholder="https://...">
                        </div>
                    </div>
                    <label class="block text-sm font-semibold mb-1">ข้อความรายละเอียดด้านล่างรูป</label>
                    <div id="banner_editor_${index}" class="bg-white h-24 rounded-b border-gray-300"></div>
                `;
                bannerContainer.appendChild(div);
                
                const quillBanner = new Quill(document.getElementById(`banner_editor_${index}`), { 
                    theme: 'snow',
                    modules: { toolbar: [ ['bold', 'italic', 'underline'], [{'color': []}], [{ 'align': [] }], ['clean'] ] }
                });
                quillBanner.root.innerHTML = banner.content || '';
                quillBanner.on('text-change', () => { 
                    banners[index].content = quillBanner.root.innerHTML; 
                    bannerInput.value = JSON.stringify(banners); 
                });
                quillBanners.push(quillBanner);
            });
            bannerInput.value = JSON.stringify(banners);
        }

        window.moveBanner = (index, direction) => {
            const newIndex = index + direction;
            if (newIndex >= 0 && newIndex < banners.length) {
                const temp = banners[index];
                banners[index] = banners[newIndex];
                banners[newIndex] = temp;
                renderBanners();
            }
        };
        window.updateBanner = (index, key, value) => { 
            banners[index][key] = value;
            bannerInput.value = JSON.stringify(banners);
            if (key === 'img_url') renderBanners(); 
        };
        window.removeBanner = (index) => { 
            if(confirm('ลบสไลด์นี้?')) { 
                banners.splice(index, 1);
                renderBanners(); 
            } 
        };
        document.getElementById('add-banner-btn').addEventListener('click', () => { 
            banners.push({ img_url: '', link_url: '', content: '' }); 
            renderBanners(); 
        });

        window.uploadSlideImage = async (event, index) => {
            const file = event.target.files[0];
            if (!file) return;

            const inputEl = document.getElementById(`img_input_${index}`);
            const originalVal = inputEl.value;
            inputEl.value = 'กำลังอัปโหลด... ⏳';

            const formData = new FormData();
            formData.append('slide_image', file);
            try {
                const response = await fetch('/admin/api/upload-slide', {
                    method: 'POST',
                    body: formData
                });
                const data = await response.json();
                
                if (data.success) {
                    updateBanner(index, 'img_url', data.url);
                } else {
                    alert('เกิดข้อผิดพลาด: ' + data.message);
                    inputEl.value = originalVal;
                }
            } catch (err) {
                console.error(err);
                alert('ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์เพื่ออัปโหลดได้');
                inputEl.value = originalVal;
            }
            event.target.value = '';
        };
        
        renderBanners();

        // --- ระบบ Blog Management (Tab 11) ---
        const blogUI = {
            currentPage: 1, totalPages: 1, quillBlog: null, categories: [],
            initEditor: function() {
                if(!this.quillBlog) {
                    this.quillBlog = new Quill('#article-quill-editor', {
                        theme: 'snow',
                        modules: {
                            toolbar: {
                                container: [ [{ 'header': [2, 3, 4, false] }], ['bold', 'italic', 'underline', 'strike', 'blockquote'], [{ 'list': 'ordered'}, { 'list': 'bullet' }], ['link', 'image', 'video'], ['clean'] ],
                                handlers: { image: this.imageHandler }
                            }
                        }
                    });
                }
            },
            imageHandler: function() {
                const input = document.createElement('input'); input.setAttribute('type', 'file'); input.setAttribute('accept', 'image/*'); input.click();
                input.onchange = async () => {
                    const file = input.files[0]; if(!file) return;
                    const formData = new FormData(); formData.append('image', file);
                    try {
                        const res = await fetch('/admin/api/upload-image', { method: 'POST', body: formData });
                        const data = await res.json();
                        if(data.success) { const range = blogUI.quillBlog.getSelection(); blogUI.quillBlog.insertEmbed(range.index, 'image', data.url); }
                    } catch(e) { alert("อัปโหลดรูปไม่สำเร็จ"); }
                };
            },
            loadCategories: async function() {
                const res = await fetch('/admin/api/categories'); this.categories = await res.json();
                const select = document.getElementById('article-category'); select.innerHTML = '<option value="">-- ไม่เลือกหมวดหมู่ --</option>';
                const list = document.getElementById('category-list'); list.innerHTML = '';
                this.categories.forEach(c => {
                    select.innerHTML += `<option value="${c.id}">${c.name}</option>`;
                    list.innerHTML += `<li class="flex justify-between items-center border p-2 rounded text-sm bg-gray-50"><span>${c.name}</span> <button onclick="blogUI.deleteCategory(${c.id})" class="text-red-500 hover:font-bold">ลบ</button></li>`;
                });
            },
            addCategory: async function() { const name = document.getElementById('new-category-name').value; if(!name) return; await fetch('/admin/api/categories', { method: 'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({name}) }); document.getElementById('new-category-name').value = ''; this.loadCategories(); },
            deleteCategory: async function(id) { if(confirm('ยืนยันลบหมวดหมู่?')) { await fetch(`/admin/api/categories/${id}`, { method: 'DELETE' }); this.loadCategories(); } },
            showCategoryModal: function() { document.getElementById('category-modal').classList.remove('hidden'); document.getElementById('category-modal').classList.add('flex'); },
            loadArticles: async function() {
                const tbody = document.getElementById('articles-tbody'); tbody.innerHTML = '<tr><td colspan="5" class="text-center py-4">กำลังโหลด...</td></tr>';
                const res = await fetch(`/admin/api/articles?page=${this.currentPage}`); const data = await res.json();
                this.totalPages = data.totalPages || 1; document.getElementById('pagination-info').innerText = `หน้า ${this.currentPage} จาก ${this.totalPages}`;
                tbody.innerHTML = ''; if(data.articles.length === 0) tbody.innerHTML = '<tr><td colspan="5" class="text-center py-4">ยังไม่มีบทความ</td></tr>';
                data.articles.forEach(a => {
                    const status = a.is_published ? '<span class="px-2 py-1 bg-green-100 text-green-700 rounded text-xs">เผยแพร่</span>' : '<span class="px-2 py-1 bg-gray-100 text-gray-700 rounded text-xs">ซ่อน</span>';
                    tbody.innerHTML += `<tr class="bg-white border-b hover:bg-gray-50"><td class="px-6 py-4 font-medium text-gray-900">${a.title}</td><td class="px-6 py-4">${a.category_name || '-'}</td><td class="px-6 py-4">${status}</td><td class="px-6 py-4 text-xs text-gray-500">${new Date(a.created_at).toLocaleDateString('th-TH')}</td><td class="px-6 py-4 text-right space-x-2"><button onclick="blogUI.editArticle(${a.id})" class="text-blue-600 hover:underline">แก้ไข</button><button onclick="blogUI.deleteArticle(${a.id})" class="text-red-600 hover:underline">ลบ</button></td></tr>`;
                });
            },
            prevPage: function() { if(this.currentPage > 1) { this.currentPage--; this.loadArticles(); } },
            nextPage: function() { if(this.currentPage < this.totalPages) { this.currentPage++; this.loadArticles(); } },
            showArticleEditor: function() {
                this.initEditor();
                document.getElementById('edit-article-id').value = ''; document.getElementById('article-title').value = '';
                document.getElementById('article-category').value = ''; document.getElementById('article-seo').value = '';
                document.getElementById('article-cover').value = ''; document.getElementById('article-published').checked = true;
                this.quillBlog.root.innerHTML = ''; document.getElementById('article-modal-title').innerText = 'เขียนบทความใหม่';
                document.getElementById('article-modal').classList.remove('hidden'); document.getElementById('article-modal').classList.add('flex');
            },
            closeArticleEditor: function() { document.getElementById('article-modal').classList.add('hidden'); document.getElementById('article-modal').classList.remove('flex'); },
            editArticle: async function(id) {
                this.showArticleEditor(); document.getElementById('article-modal-title').innerText = 'กำลังโหลดข้อมูล...';
                const res = await fetch(`/admin/api/articles/${id}`); const a = await res.json();
                document.getElementById('edit-article-id').value = a.id; document.getElementById('article-title').value = a.title;
                document.getElementById('article-category').value = a.category_id || ''; document.getElementById('article-seo').value = a.seo_description || '';
                document.getElementById('article-published').checked = a.is_published; this.quillBlog.root.innerHTML = a.content || '';
                document.getElementById('article-modal-title').innerText = 'แก้ไขบทความ';
            },
            saveArticle: async function() {
                const id = document.getElementById('edit-article-id').value;
                const formData = new FormData();
                formData.append('title', document.getElementById('article-title').value); formData.append('category_id', document.getElementById('article-category').value);
                formData.append('seo_description', document.getElementById('article-seo').value); formData.append('content', this.quillBlog.root.innerHTML);
                formData.append('is_published', document.getElementById('article-published').checked);
                const file = document.getElementById('article-cover').files[0]; if(file) formData.append('cover_image', file);
                const url = id ? `/admin/api/articles/${id}` : '/admin/api/articles'; const method = id ? 'PUT' : 'POST';
                document.getElementById('article-modal-title').innerText = 'กำลังบันทึก...';
                await fetch(url, { method: method, body: formData });
                this.closeArticleEditor(); this.loadArticles();
            },
            deleteArticle: async function(id) { if(confirm('ยืนยันลบบทความถาวร?')) { await fetch(`/admin/api/articles/${id}`, { method: 'DELETE' }); this.loadArticles(); } }
        };
    </script>
</body>
</html>