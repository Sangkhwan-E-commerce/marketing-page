    <!-- Scripts สำหรับ UI และการทำงานของฟอร์ม -->
    <script>
        // --- ระบบ Sidebar และ Dropdown (Tailwind UI) ---
        const openSidebarBtn = document.getElementById('open-sidebar-btn');
        const closeSidebarBtn = document.getElementById('close-sidebar-btn');
        const sidebar = document.getElementById('sidebar');
        const sidebarBackdrop = document.getElementById('mobile-sidebar-backdrop');
        const userMenuBtn = document.getElementById('user-menu-btn');
        const userDropdownPanel = document.getElementById('user-dropdown-panel');

        function toggleSidebar() {
            sidebar.classList.toggle('-translate-x-full');
            sidebarBackdrop.classList.toggle('hidden');
        }

        openSidebarBtn.addEventListener('click', toggleSidebar);
        closeSidebarBtn.addEventListener('click', toggleSidebar);
        sidebarBackdrop.addEventListener('click', toggleSidebar);

        userMenuBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            if (userDropdownPanel.classList.contains('hidden')) {
                userDropdownPanel.classList.remove('hidden');
                // Allow animation to run
                setTimeout(() => {
                    userDropdownPanel.classList.remove('opacity-0', 'scale-95');
                    userDropdownPanel.classList.add('opacity-100', 'scale-100');
                }, 10);
            } else {
                userDropdownPanel.classList.remove('opacity-100', 'scale-100');
                userDropdownPanel.classList.add('opacity-0', 'scale-95');
                setTimeout(() => { userDropdownPanel.classList.add('hidden'); }, 200);
            }
        });

        document.addEventListener('click', () => {
            if (!userDropdownPanel.classList.contains('hidden')) {
                userDropdownPanel.classList.remove('opacity-100', 'scale-100');
                userDropdownPanel.classList.add('opacity-0', 'scale-95');
                setTimeout(() => { userDropdownPanel.classList.add('hidden'); }, 200);
            }
        });

        // --- ระบบ Tabs ---
        function showTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(el => {
                el.classList.remove('border-primary', 'text-primary');
                el.classList.add('border-transparent', 'text-gray-500');
            });
            document.getElementById(tabId).classList.remove('hidden');
            let activeBtn = document.querySelector(`[data-target="${tabId}"]`);
            activeBtn.classList.add('border-primary', 'text-primary');
            activeBtn.classList.remove('border-transparent', 'text-gray-500');
        }
        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.addEventListener('click', (e) => showTab(e.target.dataset.target));
        });
        showTab('tab-general'); // แสดงแท็บแรกเสมอ

        // --- ระบบ Text Editor (Quill) ---
        document.querySelectorAll('.quill-editor').forEach(function(editorDiv) {
            var targetId = editorDiv.getAttribute('data-target');
            var input = document.getElementById(targetId);
            var quill = new Quill(editorDiv, {
                theme: 'snow',
                modules: { toolbar: [ ['bold', 'italic', 'underline'], [{'list': 'ordered'}, {'list': 'bullet'}], ['clean'] ] }
            });
            quill.on('text-change', function() { input.value = quill.root.innerHTML; });
            input.value = quill.root.innerHTML;
        });

        // --- ระบบจัดการ FAQ (JSON Array) ---
        const faqContainer = document.getElementById('faq-container');
        const faqInput = document.getElementById('faq_list_input');
        const addFaqBtn = document.getElementById('add-faq-btn');
        let faqs = [];
        try { faqs = JSON.parse(faqInput.value || '[]'); } catch(e) { faqs = []; }

        function renderFaqs() {
            faqContainer.innerHTML = '';
            faqs.forEach((faq, index) => {
                const div = document.createElement('div');
                div.className = 'bg-white p-5 rounded-lg border border-gray-200 shadow-sm relative';
                const safeQuestion = faq.question ? faq.question.replace(/"/g, '&quot;') : '';

                div.innerHTML = `
                    <button type="button" onclick="removeFaq(${index})" class="absolute top-4 right-4 text-gray-400 hover:text-red-500 transition-colors" title="ลบคำถามนี้">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                    </button>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">คำถาม</label>
                    <input type="text" class="w-full border-gray-300 rounded-md border p-2 text-sm mb-4 pr-10" value="${safeQuestion}" onchange="updateFaq(${index}, 'question', this.value)">
                    <label class="block text-sm font-semibold text-gray-700 mb-1">คำตอบ (รายละเอียด)</label>
                    <div id="faq_editor_${index}" class="bg-white rounded-b-md" style="height: 100px;"></div>
                `;
                faqContainer.appendChild(div);

                const editorDiv = document.getElementById(`faq_editor_${index}`);
                editorDiv.innerHTML = faq.answer || '';
                const quillFaq = new Quill(editorDiv, {
                    theme: 'snow',
                    modules: { toolbar: [ ['bold', 'italic', 'underline'], [{'list': 'ordered'}, {'list': 'bullet'}], ['clean'] ] }
                });
                quillFaq.on('text-change', function() {
                    faqs[index].answer = quillFaq.root.innerHTML;
                    faqInput.value = JSON.stringify(faqs);
                });
            });
            faqInput.value = JSON.stringify(faqs);
        }

        window.updateFaq = function(index, key, value) {
            faqs[index][key] = value;
            faqInput.value = JSON.stringify(faqs);
        };
        window.removeFaq = function(index) {
            if(confirm('ต้องการลบคำถามนี้ใช่หรือไม่?')) {
                faqs.splice(index, 1);
                renderFaqs();
            }
        };
        addFaqBtn.addEventListener('click', () => {
            faqs.push({ question: '', answer: '' });
            renderFaqs();
        });
        renderFaqs();
    </script>
</body>
</html>