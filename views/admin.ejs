<!DOCTYPE html>
<html lang="th" class="h-full bg-gray-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>จัดการเว็บไซต์ - Lullapos Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
    <style> 
        body { font-family: 'Prompt', sans-serif; } 
        /* ซ่อน Scrollbar ของ Sidebar แต่ยัง Scroll ได้ */
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
    <script>
      tailwind.config = {
        theme: {
          extend: { colors: { primary: '<%= settings.theme_color %>' } }
        }
      }
    </script>
</head>
<body class="h-full overflow-hidden flex">

    <!-- Mobile sidebar backdrop (ซ่อนเป็นค่าเริ่มต้น) -->
    <div id="mobile-sidebar-backdrop" class="fixed inset-0 z-40 hidden bg-gray-900/80 transition-opacity md:hidden" aria-hidden="true"></div>

    <!-- Sidebar -->
    <aside id="sidebar" class="fixed inset-y-0 left-0 z-50 flex w-72 -translate-x-full flex-col bg-gray-900 transition-transform duration-300 ease-in-out md:static md:translate-x-0">
        <!-- Sidebar Header (Logo) -->
        <div class="flex h-16 shrink-0 items-center bg-gray-900 px-6 border-b border-gray-800">
            <span class="text-2xl font-bold text-white tracking-wide">Lulla<span class="text-primary">pos</span> <span class="text-xs text-gray-400 font-normal ml-1">Admin</span></span>
            <!-- Close button (Mobile only) -->
            <button id="close-sidebar-btn" type="button" class="ml-auto flex items-center justify-center text-gray-400 hover:text-white md:hidden">
                <span class="sr-only">Close sidebar</span>
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
        </div>

        <!-- Sidebar Navigation -->
        <nav class="flex flex-1 flex-col overflow-y-auto no-scrollbar px-4 py-6">
            <ul role="list" class="flex flex-1 flex-col gap-y-7">
                <li>
                    <div class="text-xs font-semibold leading-6 text-gray-400 uppercase tracking-wider mb-2">จัดการเว็บไซต์</div>
                    <ul role="list" class="-mx-2 space-y-1">
                        <!-- เมนูที่ 1 (Active) -->
                        <li>
                            <a href="#" class="group flex gap-x-3 rounded-md bg-gray-800 p-2 text-sm font-semibold leading-6 text-white">
                                <svg class="h-6 w-6 shrink-0 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" /></svg>
                                หน้า Landing Page
                            </a>
                        </li>
                        <!-- เมนูที่ 2 (สำหรับอนาคต) -->
                        <li>
                            <a href="#" class="group flex gap-x-3 rounded-md p-2 text-sm font-semibold leading-6 text-gray-400 hover:bg-gray-800 hover:text-white transition-colors">
                                <svg class="h-6 w-6 shrink-0 text-gray-400 group-hover:text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>
                                จัดการผู้ใช้งาน (เร็วๆ นี้)
                            </a>
                        </li>
                    </ul>
                </li>
                <li>
                    <div class="text-xs font-semibold leading-6 text-gray-400 uppercase tracking-wider mb-2">ตั้งค่าระบบ</div>
                    <ul role="list" class="-mx-2 space-y-1">
                        <li>
                            <a href="#" class="group flex gap-x-3 rounded-md p-2 text-sm font-semibold leading-6 text-gray-400 hover:bg-gray-800 hover:text-white transition-colors">
                                <svg class="h-6 w-6 shrink-0 text-gray-400 group-hover:text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                                ตั้งค่าทั่วไป (เร็วๆ นี้)
                            </a>
                        </li>
                    </ul>
                </li>
            </ul>
        </nav>
    </aside>

    <!-- Main Column -->
    <div class="flex flex-col flex-1 w-0 overflow-hidden bg-gray-50">
        
        <!-- Top Navbar -->
        <header class="flex items-center justify-between h-16 px-4 bg-white border-b border-gray-200 shadow-sm sm:px-6 lg:px-8 shrink-0 relative z-10">
            <!-- Mobile Hamburger -->
            <button id="open-sidebar-btn" type="button" class="text-gray-500 hover:text-gray-700 focus:outline-none md:hidden">
                <span class="sr-only">Open sidebar</span>
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25H12" /></svg>
            </button>

            <!-- Page Title (Desktop) -->
            <h1 class="hidden text-xl font-bold text-gray-800 md:block">แก้ไขเนื้อหาเว็บ (Landing Page)</h1>

            <!-- Right Nav -->
            <div class="flex items-center ml-auto space-x-4">
                <!-- User Dropdown -->
                <div class="relative ml-3">
                    <button id="user-menu-btn" type="button" class="flex items-center max-w-xs text-sm bg-white rounded-full focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 transition-all">
                        <span class="sr-only">Open user menu</span>
                        <img class="w-9 h-9 rounded-full object-cover border border-gray-200 shadow-sm" src="https://ui-avatars.com/api/?name=Admin&background=random&color=fff" alt="Admin">
                    </button>
                    <!-- Dropdown Panel (ซ่อนเป็นค่าเริ่มต้น) -->
                    <div id="user-dropdown-panel" class="absolute right-0 z-10 hidden w-48 py-1 mt-2 origin-top-right bg-white rounded-md shadow-lg ring-1 ring-black ring-opacity-5 focus:outline-none transform opacity-0 scale-95 transition-all duration-200">
                        <div class="px-4 py-2 border-b border-gray-100">
                            <p class="text-sm text-gray-900 font-semibold">ผู้ดูแลระบบ</p>
                            <p class="text-xs text-gray-500 truncate">admin@lullapos.com</p>
                        </div>
                        <a href="/" target="_blank" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 transition-colors">ดูหน้าเว็บไซต์จริง</a>
                        <a href="/admin/login" class="block px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition-colors">ออกจากระบบ</a>
                    </div>
                </div>
            </div>
        </header>

        <!-- Main Content (Scrollable) -->
        <main class="flex-1 relative overflow-y-auto focus:outline-none">
            <div class="py-6 px-4 sm:px-6 lg:px-8 mx-auto max-w-7xl">
                
                <form action="/admin/save" method="POST" enctype="multipart/form-data" class="bg-white rounded-xl shadow-sm border border-gray-200">
                    
                    <!-- ส่วนหัวของ Card -->
                    <div class="px-6 py-5 border-b border-gray-200 flex flex-col sm:flex-row sm:items-center sm:justify-between">
                        <div>
                            <h3 class="text-lg font-semibold leading-6 text-gray-900">ตัวจัดการข้อมูลหน้าแรก</h3>
                            <p class="mt-1 text-sm text-gray-500">เลือกแท็บด้านล่างเพื่อแก้ไขข้อมูลในแต่ละส่วนของหน้าเว็บไซต์</p>
                        </div>
                        <div class="mt-4 sm:mt-0">
                            <button type="submit" class="inline-flex items-center rounded-md bg-primary px-5 py-2 text-sm font-semibold text-white shadow-sm hover:opacity-80 transition-opacity focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2">
                                บันทึกและอัปเดตเว็บไซต์
                            </button>
                        </div>
                    </div>

                    <!-- Tab Navigation -->
                    <div class="border-b border-gray-200 px-6">
                        <nav class="-mb-px flex space-x-6 overflow-x-auto no-scrollbar" aria-label="Tabs" id="tabs">
                            <button type="button" class="tab-btn whitespace-nowrap border-b-2 py-4 px-1 text-sm font-medium transition-colors border-primary text-primary" data-target="tab-general">1. ทั่วไป & Footer</button>
                            <button type="button" class="tab-btn whitespace-nowrap border-b-2 py-4 px-1 text-sm font-medium transition-colors border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700" data-target="tab-hero">2. ส่วนบนสุด</button>
                            <button type="button" class="tab-btn whitespace-nowrap border-b-2 py-4 px-1 text-sm font-medium transition-colors border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700" data-target="tab-features3">3. วิสัยทัศน์</button>
                            <button type="button" class="tab-btn whitespace-nowrap border-b-2 py-4 px-1 text-sm font-medium transition-colors border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700" data-target="tab-features4">4. ฟีเจอร์</button>
                            <button type="button" class="tab-btn whitespace-nowrap border-b-2 py-4 px-1 text-sm font-medium transition-colors border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700" data-target="tab-stats">5. ภารกิจและสถิติ</button>
                            <button type="button" class="tab-btn whitespace-nowrap border-b-2 py-4 px-1 text-sm font-medium transition-colors border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700" data-target="tab-faq">6. ฟังก์ชั่น (FAQ)</button>
                            <button type="button" class="tab-btn whitespace-nowrap border-b-2 py-4 px-1 text-sm font-medium transition-colors border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700" data-target="tab-cta">7. เชิญชวน</button>
                            <button type="button" class="tab-btn whitespace-nowrap border-b-2 py-4 px-1 text-sm font-medium transition-colors border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700" data-target="tab-seo">8. SEO</button>
                        </nav>
                    </div>

                    <!-- เนื้อหาฟอร์ม (ใส่ padding รอบๆ) -->
                    <div class="p-6">
                        
                        <!-- Tab 1: General -->
                        <div id="tab-general" class="tab-content space-y-6">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 bg-gray-50/50 p-6 rounded-lg border border-gray-100">
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">Favicon (PNG/ICO)</label>
                                    <input type="file" name="favicon" accept="image/*" class="w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-primary file:text-white hover:file:bg-opacity-80">
                                    <p class="text-xs text-gray-500 mt-2">ไฟล์ปัจจุบัน: <a href="<%= settings.favicon_url %>" target="_blank" class="text-blue-600 hover:underline">คลิกเพื่อดูรูป</a></p>
                                </div>
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">Logo โปร่งใส (PNG)</label>
                                    <input type="file" name="logo" accept="image/png" class="w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-primary file:text-white hover:file:bg-opacity-80">
                                    <p class="text-xs text-gray-500 mt-2">ไฟล์ปัจจุบัน: <a href="<%= settings.logo_url %>" target="_blank" class="text-blue-600 hover:underline">คลิกเพื่อดูรูป</a></p>
                                </div>
                            </div>
                            
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">สีธีมหลัก (เช่น <code>rgb(244 97 100 / 98%)</code> หรือ <code>#F46164</code>)</label>
                                <input type="text" name="theme_color" value="<%= settings.theme_color %>" class="w-full border-gray-300 rounded-md shadow-sm focus:border-primary focus:ring-primary sm:text-sm border p-2" required>
                            </div>
                            
                            <div class="pt-6 border-t border-gray-200">
                                <h4 class="text-base font-semibold text-gray-900 mb-4">ตั้งค่า Footer & โซเชียล</h4>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">ลิงก์ Facebook</label>
                                        <input type="url" name="facebook_url" value="<%= settings.facebook_url %>" class="w-full border-gray-300 rounded-md shadow-sm border p-2 text-sm">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">ไอคอน Facebook (SVG)</label>
                                        <textarea name="facebook_icon" rows="2" class="w-full border-gray-300 rounded-md shadow-sm border p-2 text-xs font-mono"><%= settings.facebook_icon %></textarea>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">ลิงก์ LINE</label>
                                        <input type="url" name="line_url" value="<%= settings.line_url %>" class="w-full border-gray-300 rounded-md shadow-sm border p-2 text-sm">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">ไอคอน LINE (SVG)</label>
                                        <textarea name="line_icon" rows="2" class="w-full border-gray-300 rounded-md shadow-sm border p-2 text-xs font-mono"><%= settings.line_icon %></textarea>
                                    </div>
                                </div>
                                <div class="mt-4">
                                    <label class="block text-sm font-medium text-gray-700 mb-1">ข้อความ Copyright</label>
                                    <input type="text" name="footer_text" value="<%= settings.footer_text %>" class="w-full border-gray-300 rounded-md shadow-sm border p-2 text-sm" required>
                                </div>
                            </div>
                        </div>

                        <!-- Tab 2: Hero -->
                        <div id="tab-hero" class="tab-content space-y-6 hidden">
                            <div class="space-y-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">ข้อความ Badge (ด้านบนสุด)</label>
                                    <input type="text" name="hero_badge" value="<%= settings.hero_badge %>" class="w-full border-gray-300 rounded-md shadow-sm border p-2 text-sm" required>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">หัวข้อหลัก (Title)</label>
                                    <input type="text" name="hero_title" value="<%= settings.hero_title %>" class="w-full border-gray-300 rounded-md shadow-sm border p-2 text-sm" required>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">รายละเอียด (Description)</label>
                                    <input type="hidden" name="hero_desc" id="hero_desc">
                                    <div class="quill-editor bg-white rounded-b-md" data-target="hero_desc" style="height: 150px;"><%- settings.hero_desc %></div>
                                </div>
                            </div>
                            
                            <div class="bg-gray-50/50 p-6 rounded-lg border border-gray-100">
                                <label class="block text-sm font-semibold text-gray-700 mb-2">รูปภาพหน้าจอระบบ (Hero Image)</label>
                                <input type="file" name="hero_img" accept="image/*" class="w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-primary file:text-white hover:file:bg-opacity-80">
                                <p class="text-xs text-gray-500 mt-2">ไฟล์ปัจจุบัน: <a href="<%= settings.hero_img_url %>" target="_blank" class="text-blue-600 hover:underline">คลิกเพื่อดูรูป</a></p>
                            </div>
                            
                            <div class="pt-6 border-t border-gray-200">
                                <h4 class="text-base font-semibold text-gray-900 mb-4">ปุ่มสมัครใช้งาน</h4>
                                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">ข้อความ</label>
                                        <input type="text" name="btn_text" value="<%= settings.btn_text %>" class="w-full border-gray-300 rounded-md shadow-sm border p-2 text-sm" required>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">URL ลิงก์</label>
                                        <input type="text" name="btn_url" value="<%= settings.btn_url %>" class="w-full border-gray-300 rounded-md shadow-sm border p-2 text-sm" required>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">ขนาดอักษร</label>
                                        <select name="btn_size" class="w-full border-gray-300 rounded-md shadow-sm border p-2 text-sm">
                                            <option value="text-sm" <%= settings.btn_size === 'text-sm' ? 'selected' : '' %>>เล็ก (text-sm)</option>
                                            <option value="text-base" <%= settings.btn_size === 'text-base' ? 'selected' : '' %>>ปกติ (text-base)</option>
                                            <option value="text-lg" <%= settings.btn_size === 'text-lg' ? 'selected' : '' %>>ใหญ่ (text-lg)</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tab 3: Features 3 Columns -->
                        <div id="tab-features3" class="tab-content space-y-6 hidden">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">หัวข้อหลัก</label>
                                    <input type="text" name="feature_title" value="<%= settings.feature_title %>" class="w-full border-gray-300 rounded-md shadow-sm border p-2 text-sm" required>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">คำโปรยย่อย (Subtitle)</label>
                                    <input type="text" name="feature_subtitle" value="<%= settings.feature_subtitle %>" class="w-full border-gray-300 rounded-md shadow-sm border p-2 text-sm" required>
                                </div>
                            </div>
                            
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-6 border-t border-gray-200">
                                <!-- Col 1 -->
                                <div class="space-y-3 bg-gray-50/50 p-4 rounded-lg border border-gray-100">
                                    <h4 class="font-semibold text-gray-900 border-b pb-2">คอลัมน์ 1</h4>
                                    <label class="block text-xs font-semibold text-blue-600">ไอคอน (ก๊อปปี้ SVG จาก <a href="https://heroicons.com" target="_blank" class="underline">Heroicons</a>)</label>
                                    <textarea name="col1_icon" rows="3" class="w-full border-gray-300 rounded-md border p-2 text-xs font-mono bg-white" required><%= settings.col1_icon %></textarea>
                                    <input type="text" name="col1_title" value="<%= settings.col1_title %>" class="w-full border-gray-300 rounded-md border p-2 text-sm" placeholder="หัวข้อ" required>
                                    <input type="hidden" name="col1_desc" id="col1_desc">
                                    <div class="quill-editor bg-white rounded-b-md" data-target="col1_desc" style="height: 100px;"><%- settings.col1_desc %></div>
                                </div>
                                <!-- Col 2 -->
                                <div class="space-y-3 bg-gray-50/50 p-4 rounded-lg border border-gray-100">
                                    <h4 class="font-semibold text-gray-900 border-b pb-2">คอลัมน์ 2</h4>
                                    <label class="block text-xs font-semibold text-blue-600">ไอคอน SVG</label>
                                    <textarea name="col2_icon" rows="3" class="w-full border-gray-300 rounded-md border p-2 text-xs font-mono bg-white" required><%= settings.col2_icon %></textarea>
