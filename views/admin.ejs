<!DOCTYPE html>
<html lang="th">
<head>
    <title>จัดการเว็บไซต์ - Lullapos</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@400;600&display=swap" rel="stylesheet">
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
    <style> body { font-family: 'Prompt', sans-serif; } </style>
    <script>
      tailwind.config = {
        theme: {
          extend: { colors: { primary: '<%= settings.theme_color %>' } }
        }
      }
    </script>
</head>
<body class="bg-gray-50 text-gray-800 p-4 md:p-8">
    <div class="max-w-5xl mx-auto bg-white p-6 md:p-8 rounded-xl shadow-lg border border-gray-100">
        <h1 class="text-3xl font-bold mb-6 text-primary border-b pb-4">จัดการหน้า Landing Page</h1>
        
        <!-- Tab Navigation -->
        <div class="flex border-b border-gray-200 mb-8 overflow-x-auto" id="tabs">
            <button type="button" class="tab-btn px-4 py-3 border-b-2 font-semibold whitespace-nowrap transition-colors" data-target="tab-general">1. ทั่วไป & Footer</button>
            <button type="button" class="tab-btn px-4 py-3 border-b-2 font-semibold whitespace-nowrap transition-colors" data-target="tab-hero">2. ส่วนบนสุด</button>
            <button type="button" class="tab-btn px-4 py-3 border-b-2 font-semibold whitespace-nowrap transition-colors" data-target="tab-features3">3. วิสัยทัศน์</button>
            <button type="button" class="tab-btn px-4 py-3 border-b-2 font-semibold whitespace-nowrap transition-colors" data-target="tab-features4">4. ฟีเจอร์</button>
            <button type="button" class="tab-btn px-4 py-3 border-b-2 font-semibold whitespace-nowrap transition-colors" data-target="tab-stats">5. ภารกิจและสถิติ</button>
            <button type="button" class="tab-btn px-4 py-3 border-b-2 font-semibold whitespace-nowrap transition-colors" data-target="tab-faq">6. ฟังก์ชั่น</button>
            <button type="button" class="tab-btn px-4 py-3 border-b-2 font-semibold whitespace-nowrap transition-colors" data-target="tab-cta">7. ส่วนเชิญชวน</button>
            <button type="button" class="tab-btn px-4 py-3 border-b-2 font-semibold whitespace-nowrap transition-colors" data-target="tab-seo">8. SEO</button>
        </div>

        <!-- ฟอร์มรวมทุก Tabs -->
        <form action="/admin/save" method="POST" enctype="multipart/form-data">
            
            <!-- Tab 1: General -->
            <div id="tab-general" class="tab-content space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 bg-blue-50 p-6 rounded-lg">
                    <div>
                        <label class="block font-semibold mb-2">Favicon (PNG/ICO)</label>
                        <input type="file" name="favicon" accept="image/*" class="w-full text-sm">
                        <p class="text-xs text-gray-500 mt-1">ไฟล์ปัจจุบัน: <a href="<%= settings.favicon_url %>" target="_blank" class="text-blue-500 underline">ดูรูป</a></p>
                    </div>
                    <div>
                        <label class="block font-semibold mb-2">Logo โปร่งใส (PNG)</label>
                        <input type="file" name="logo" accept="image/png" class="w-full text-sm">
                        <p class="text-xs text-gray-500 mt-1">ไฟล์ปัจจุบัน: <a href="<%= settings.logo_url %>" target="_blank" class="text-blue-500 underline">ดูรูป</a></p>
                    </div>
                </div>
                <div class="bg-gray-50 p-6 rounded-lg border border-gray-200">
                    <label class="block font-semibold mb-2">สีธีมหลัก (เช่น <code>rgb(244 97 100 / 98%)</code> หรือ <code>#F46164</code>)</label>
                    <input type="text" name="theme_color" value="<%= settings.theme_color %>" class="w-full border p-2 rounded" required>
                </div>
                <div class="bg-gray-50 p-6 rounded-lg border border-gray-200 space-y-4">
                    <h3 class="font-bold text-lg text-primary border-b pb-2">ตั้งค่า Footer & โซเชียล</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block font-semibold mb-2">ลิงก์ Facebook</label>
                            <input type="url" name="facebook_url" value="<%= settings.facebook_url %>" class="w-full border p-2 rounded">
                        </div>
                        <div>
                            <label class="block font-semibold mb-2">ไอคอน Facebook (SVG)</label>
                            <textarea name="facebook_icon" rows="2" class="w-full border p-2 rounded text-xs font-mono"><%= settings.facebook_icon %></textarea>
                        </div>
                        <div>
                            <label class="block font-semibold mb-2">ลิงก์ LINE</label>
                            <input type="url" name="line_url" value="<%= settings.line_url %>" class="w-full border p-2 rounded">
                        </div>
                        <div>
                            <label class="block font-semibold mb-2">ไอคอน LINE (SVG)</label>
                            <textarea name="line_icon" rows="2" class="w-full border p-2 rounded text-xs font-mono"><%= settings.line_icon %></textarea>
                        </div>
                    </div>
                    <div>
                        <label class="block font-semibold mb-2">ข้อความ Copyright</label>
                        <input type="text" name="footer_text" value="<%= settings.footer_text %>" class="w-full border p-2 rounded" required>
                    </div>
                </div>
            </div>

            <!-- Tab 2: Hero -->
            <div id="tab-hero" class="tab-content space-y-6 hidden">
                <div class="space-y-4">
                    <div>
                        <label class="block font-semibold mb-2">ข้อความ Badge (ด้านบนสุด)</label>
                        <input type="text" name="hero_badge" value="<%= settings.hero_badge %>" class="w-full border p-2 rounded" required>
                    </div>
                    <div>
                        <label class="block font-semibold mb-2">หัวข้อหลัก (Title)</label>
                        <input type="text" name="hero_title" value="<%= settings.hero_title %>" class="w-full border p-2 rounded" required>
                    </div>
                    <div>
                        <label class="block font-semibold mb-2">รายละเอียด (Description)</label>
                        <input type="hidden" name="hero_desc" id="hero_desc">
                        <div class="quill-editor bg-white" data-target="hero_desc" style="height: 150px;"><%- settings.hero_desc %></div>
                    </div>
                </div>
                <div class="bg-blue-50 p-6 rounded-lg">
                    <label class="block font-semibold mb-2">รูปภาพหน้าจอระบบ (Hero Image)</label>
                    <input type="file" name="hero_img" accept="image/*" class="w-full text-sm">
                    <p class="text-xs text-gray-500 mt-1">ไฟล์ปัจจุบัน: <a href="<%= settings.hero_img_url %>" target="_blank" class="text-blue-500 underline">ดูรูป</a></p>
                </div>
                <div class="bg-gray-50 p-6 rounded-lg border border-gray-200">
                    <h3 class="font-bold text-lg text-primary border-b pb-2 mb-4">ปุ่มสมัครใช้งาน</h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div>
                            <label class="block font-semibold mb-2">ข้อความ</label>
                            <input type="text" name="btn_text" value="<%= settings.btn_text %>" class="w-full border p-2 rounded" required>
                        </div>
                        <div>
                            <label class="block font-semibold mb-2">URL ลิงก์</label>
                            <input type="text" name="btn_url" value="<%= settings.btn_url %>" class="w-full border p-2 rounded" required>
                        </div>
                        <div>
                            <label class="block font-semibold mb-2">ขนาดอักษร</label>
                            <select name="btn_size" class="w-full border p-2 rounded">
                                <option value="text-sm" <%= settings.btn_size === 'text-sm' ? 'selected' : '' %>>เล็ก (text-sm)</option>
                                <option value="text-base" <%= settings.btn_size === 'text-base' ? 'selected' : '' %>>ปกติ (text-base)</option>
                                <option value="text-lg" <%= settings.btn_size === 'text-lg' ? 'selected' : '' %>>ใหญ่ (text-lg)</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tab 3: Features 3 Columns -->
            <div id="tab-features3" class="tab-content space-y-6 hidden">
                <div class="space-y-4 mb-6">
                    <div>
                        <label class="block font-semibold mb-2">หัวข้อหลัก</label>
                        <input type="text" name="feature_title" value="<%= settings.feature_title %>" class="w-full border p-2 rounded" required>
                    </div>
                    <div>
                        <label class="block font-semibold mb-2">คำโปรยย่อย (Subtitle)</label>
                        <input type="text" name="feature_subtitle" value="<%= settings.feature_subtitle %>" class="w-full border p-2 rounded" required>
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 bg-gray-50 p-6 rounded-lg border border-gray-200">
                    <!-- Col 1 -->
                    <div class="space-y-3">
                        <h3 class="font-bold text-lg text-gray-700">คอลัมน์ 1</h3>
                        <label class="block text-xs font-semibold text-blue-600">ไอคอน (ก๊อปปี้โค้ด SVG จาก <a href="https://heroicons.com" target="_blank" class="underline">Heroicons.com</a>)</label>
                        <textarea name="col1_icon" rows="3" class="w-full border p-2 rounded text-xs font-mono bg-gray-100" required><%= settings.col1_icon %></textarea>
                        <input type="text" name="col1_title" value="<%= settings.col1_title %>" class="w-full border p-2 rounded" placeholder="หัวข้อ" required>
                        <input type="hidden" name="col1_desc" id="col1_desc">
                        <div class="quill-editor bg-white" data-target="col1_desc" style="height: 100px;"><%- settings.col1_desc %></div>
                    </div>
                    <!-- Col 2 -->
                    <div class="space-y-3">
                        <h3 class="font-bold text-lg text-gray-700">คอลัมน์ 2</h3>
                        <label class="block text-xs font-semibold text-blue-600">ไอคอน SVG</label>
                        <textarea name="col2_icon" rows="3" class="w-full border p-2 rounded text-xs font-mono bg-gray-100" required><%= settings.col2_icon %></textarea>
                        <input type="text" name="col2_title" value="<%= settings.col2_title %>" class="w-full border p-2 rounded" placeholder="หัวข้อ" required>
                        <input type="hidden" name="col2_desc" id="col2_desc">
                        <div class="quill-editor bg-white" data-target="col2_desc" style="height: 100px;"><%- settings.col2_desc %></div>
                    </div>
                    <!-- Col 3 -->
                    <div class="space-y-3">
                        <h3 class="font-bold text-lg text-gray-700">คอลัมน์ 3</h3>
                        <label class="block text-xs font-semibold text-blue-600">ไอคอน SVG</label>
                        <textarea name="col3_icon" rows="3" class="w-full border p-2 rounded text-xs font-mono bg-gray-100" required><%= settings.col3_icon %></textarea>
                        <input type="text" name="col3_title" value="<%= settings.col3_title %>" class="w-full border p-2 rounded" placeholder="หัวข้อ" required>
                        <input type="hidden" name="col3_desc" id="col3_desc">
                        <div class="quill-editor bg-white" data-target="col3_desc" style="height: 100px;"><%- settings.col3_desc %></div>
                    </div>
                </div>
            </div>

            <!-- Tab 4: Features 4 Grids -->
            <div id="tab-features4" class="tab-content space-y-6 hidden">
                <div class="space-y-4 mb-6">
                    <div>
                        <label class="block font-semibold mb-2">ข้อความ Badge</label>
                        <input type="text" name="grid_badge" value="<%= settings.grid_badge %>" class="w-full border p-2 rounded" required>
                    </div>
                    <div>
                        <label class="block font-semibold mb-2">หัวข้อหลัก</label>
                        <input type="text" name="grid_title" value="<%= settings.grid_title %>" class="w-full border p-2 rounded" required>
                    </div>
                    <div>
                        <label class="block font-semibold mb-2">รายละเอียด</label>
                        <input type="hidden" name="grid_desc" id="grid_desc">
                        <div class="quill-editor bg-white" data-target="grid_desc" style="height: 120px;"><%- settings.grid_desc %></div>
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 bg-gray-50 p-6 rounded-lg border border-gray-200">
                    <!-- Grid 1 -->
                    <div class="space-y-2">
                        <h3 class="font-bold text-gray-700">ฟีเจอร์ 1</h3>
                        <label class="block text-xs font-semibold text-blue-600">ไอคอน SVG</label>
                        <textarea name="grid1_icon" rows="2" class="w-full border p-2 rounded text-xs font-mono bg-gray-100" required><%= settings.grid1_icon %></textarea>
                        <input type="text" name="grid1_title" value="<%= settings.grid1_title %>" class="w-full border p-2 rounded" placeholder="หัวข้อ" required>
                        <textarea name="grid1_desc" rows="2" class="w-full border p-2 rounded text-sm" placeholder="รายละเอียด" required><%= settings.grid1_desc %></textarea>
                    </div>
                    <!-- Grid 2 -->
                    <div class="space-y-2">
                        <h3 class="font-bold text-gray-700">ฟีเจอร์ 2</h3>
                        <label class="block text-xs font-semibold text-blue-600">ไอคอน SVG</label>
                        <textarea name="grid2_icon" rows="2" class="w-full border p-2 rounded text-xs font-mono bg-gray-100" required><%= settings.grid2_icon %></textarea>
                        <input type="text" name="grid2_title" value="<%= settings.grid2_title %>" class="w-full border p-2 rounded" placeholder="หัวข้อ" required>
                        <textarea name="grid2_desc" rows="2" class="w-full border p-2 rounded text-sm" placeholder="รายละเอียด" required><%= settings.grid2_desc %></textarea>
                    </div>
                    <!-- Grid 3 -->
                    <div class="space-y-2">
                        <h3 class="font-bold text-gray-700">ฟีเจอร์ 3</h3>
                        <label class="block text-xs font-semibold text-blue-600">ไอคอน SVG</label>
                        <textarea name="grid3_icon" rows="2" class="w-full border p-2 rounded text-xs font-mono bg-gray-100" required><%= settings.grid3_icon %></textarea>
                        <input type="text" name="grid3_title" value="<%= settings.grid3_title %>" class="w-full border p-2 rounded" placeholder="หัวข้อ" required>
                        <textarea name="grid3_desc" rows="2" class="w-full border p-2 rounded text-sm" placeholder="รายละเอียด" required><%= settings.grid3_desc %></textarea>
                    </div>
                    <!-- Grid 4 -->
                    <div class="space-y-2">
                        <h3 class="font-bold text-gray-700">ฟีเจอร์ 4</h3>
                        <label class="block text-xs font-semibold text-blue-600">ไอคอน SVG</label>
                        <textarea name="grid4_icon" rows="2" class="w-full border p-2 rounded text-xs font-mono bg-gray-100" required><%= settings.grid4_icon %></textarea>
                        <input type="text" name="grid4_title" value="<%= settings.grid4_title %>" class="w-full border p-2 rounded" placeholder="หัวข้อ" required>
                        <textarea name="grid4_desc" rows="2" class="w-full border p-2 rounded text-sm" placeholder="รายละเอียด" required><%= settings.grid4_desc %></textarea>
                    </div>
                    <!-- Grid 5 -->
                    <div class="space-y-2">
                        <h3 class="font-bold text-gray-700">ฟีเจอร์ 5</h3>
                        <label class="block text-xs font-semibold text-blue-600">ไอคอน SVG</label>
                        <textarea name="grid5_icon" rows="2" class="w-full border p-2 rounded text-xs font-mono bg-gray-100" required><%= settings.grid5_icon %></textarea>
                        <input type="text" name="grid5_title" value="<%= settings.grid5_title %>" class="w-full border p-2 rounded" placeholder="หัวข้อ" required>
                        <textarea name="grid5_desc" rows="2" class="w-full border p-2 rounded text-sm" placeholder="รายละเอียด" required><%= settings.grid5_desc %></textarea>
                    </div>
                    <!-- Grid 6 -->
                    <div class="space-y-2">
                        <h3 class="font-bold text-gray-700">ฟีเจอร์ 6</h3>
                        <label class="block text-xs font-semibold text-blue-600">ไอคอน SVG</label>
                        <textarea name="grid6_icon" rows="2" class="w-full border p-2 rounded text-xs font-mono bg-gray-100" required><%= settings.grid6_icon %></textarea>
                        <input type="text" name="grid6_title" value="<%= settings.grid6_title %>" class="w-full border p-2 rounded" placeholder="หัวข้อ" required>
                        <textarea name="grid6_desc" rows="2" class="w-full border p-2 rounded text-sm" placeholder="รายละเอียด" required><%= settings.grid6_desc %></textarea>
                    </div>
                </div>
            </div>

            <!-- Tab 5: Stats -->
            <div id="tab-stats" class="tab-content space-y-6 hidden">
                <div class="bg-blue-50 p-6 rounded-lg mb-6">
                    <label class="block font-semibold mb-2">รูปภาพประกอบ (ฝั่งซ้าย)</label>
                    <input type="file" name="stats_img" accept="image/*" class="w-full text-sm">
                    <p class="text-xs text-gray-500 mt-1">ไฟล์ปัจจุบัน: <a href="<%= settings.stats_img_url %>" target="_blank" class="text-blue-500 underline">ดูรูป</a></p>
                </div>
                <div class="space-y-4 mb-6">
                    <div>
                        <label class="block font-semibold mb-2">ข้อความ Badge</label>
                        <input type="text" name="stats_badge" value="<%= settings.stats_badge %>" class="w-full border p-2 rounded" required>
                    </div>
                    <div>
                        <label class="block font-semibold mb-2">หัวข้อหลัก</label>
                        <input type="text" name="stats_title" value="<%= settings.stats_title %>" class="w-full border p-2 rounded" required>
                    </div>
                    <div>
                        <label class="block font-semibold mb-2">รายละเอียด</label>
                        <input type="hidden" name="stats_desc" id="stats_desc">
                        <div class="quill-editor bg-white" data-target="stats_desc" style="height: 120px;"><%- settings.stats_desc %></div>
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 bg-gray-50 p-6 rounded-lg border border-gray-200">
                    <div>
                        <h3 class="font-bold mb-2 text-gray-700 border-b pb-2">สถิติที่ 1</h3>
                        <input type="text" name="stat1_value" value="<%= settings.stat1_value %>" class="w-full border p-2 rounded mb-2" placeholder="ตัวเลข" required>
                        <input type="text" name="stat1_label" value="<%= settings.stat1_label %>" class="w-full border p-2 rounded" placeholder="คำอธิบาย" required>
                    </div>
                    <div>
                        <h3 class="font-bold mb-2 text-gray-700 border-b pb-2">สถิติที่ 2</h3>
                        <input type="text" name="stat2_value" value="<%= settings.stat2_value %>" class="w-full border p-2 rounded mb-2" placeholder="ตัวเลข" required>
                        <input type="text" name="stat2_label" value="<%= settings.stat2_label %>" class="w-full border p-2 rounded" placeholder="คำอธิบาย" required>
                    </div>
                    <div>
                        <h3 class="font-bold mb-2 text-gray-700 border-b pb-2">สถิติที่ 3</h3>
                        <input type="text" name="stat3_value" value="<%= settings.stat3_value %>" class="w-full border p-2 rounded mb-2" placeholder="ตัวเลข" required>
                        <input type="text" name="stat3_label" value="<%= settings.stat3_label %>" class="w-full border p-2 rounded" placeholder="คำอธิบาย" required>
                    </div>
                    <div>
                        <h3 class="font-bold mb-2 text-gray-700 border-b pb-2">สถิติที่ 4</h3>
                        <input type="text" name="stat4_value" value="<%= settings.stat4_value %>" class="w-full border p-2 rounded mb-2" placeholder="ตัวเลข" required>
                        <input type="text" name="stat4_label" value="<%= settings.stat4_label %>" class="w-full border p-2 rounded" placeholder="คำอธิบาย" required>
                    </div>
                </div>
            </div>

            <!-- Tab 6: FAQ -->
            <div id="tab-faq" class="tab-content space-y-6 hidden">
                <div>
                    <label class="block font-semibold mb-2">หัวข้อหลัก (Title)</label>
                    <input type="text" name="faq_title" value="<%= settings.faq_title %>" class="w-full border p-2 rounded" required>
                </div>
                
                <div class="bg-gray-50 p-6 rounded-lg border border-gray-200">
                    <div class="flex justify-between items-center mb-4">
                        <h3 class="font-bold text-lg text-primary">รายการคำถาม (เพิ่มได้ไม่จำกัด)</h3>
                        <button type="button" id="add-faq-btn" class="bg-green-500 text-white px-4 py-2 rounded text-sm hover:bg-green-600 transition">+ เพิ่มคำถามใหม่</button>
                    </div>
                    
                    <!-- ส่วนแสดงรายการคำถาม -->
                    <div id="faq-container" class="space-y-4"></div>
                    
                    <!-- Input ที่ซ่อนไว้สำหรับส่งค่า JSON กลับไปที่ Server -->
                    <input type="hidden" name="faq_list" id="faq_list_input" value="<%= settings.faq_list %>">
                </div>
            </div>

            <!-- Tab 7: CTA (Call to Action) -->
            <div id="tab-cta" class="tab-content space-y-6 hidden">
                <h2 class="text-2xl font-bold mb-6 text-primary border-b pb-4">ส่วนเชิญชวน (Call to Action)</h2>
                
                <div class="space-y-4 mb-6">
                    <div>
                        <label class="block font-semibold mb-2">หัวข้อหลัก (Title)</label>
                        <input type="text" name="cta_title" value="<%= settings.cta_title %>" class="w-full border p-2 rounded" required>
                    </div>
                    <div>
                        <label class="block font-semibold mb-2">รายละเอียด (Description)</label>
                        <input type="hidden" name="cta_desc" id="cta_desc">
                        <!-- เรียกใช้ Text Editor -->
                        <div class="quill-editor bg-white" data-target="cta_desc" style="height: 120px;"><%- settings.cta_desc %></div>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 bg-gray-50 p-6 rounded-lg border border-gray-200">
                    <!-- ปุ่มหลัก -->
                    <div>
                        <h3 class="font-bold text-lg text-gray-700 border-b pb-2 mb-4">ปุ่มหลัก (ปุ่มทึบ)</h3>
                        <label class="block text-sm mb-1">ข้อความบนปุ่ม</label>
                        <input type="text" name="cta_btn1_text" value="<%= settings.cta_btn1_text %>" class="w-full border p-2 rounded mb-3" required>
                        <label class="block text-sm mb-1">URL ลิงก์</label>
                        <input type="text" name="cta_btn1_url" value="<%= settings.cta_btn1_url %>" class="w-full border p-2 rounded" required>
                    </div>
                    <!-- ปุ่มรอง -->
                    <div>
                        <h3 class="font-bold text-lg text-gray-700 border-b pb-2 mb-4">ปุ่มรอง (ลิงก์มีลูกศร)</h3>
                        <label class="block text-sm mb-1">ข้อความบนปุ่ม</label>
                        <input type="text" name="cta_btn2_text" value="<%= settings.cta_btn2_text %>" class="w-full border p-2 rounded mb-3" required>
                        <label class="block text-sm mb-1">URL ลิงก์</label>
                        <input type="text" name="cta_btn2_url" value="<%= settings.cta_btn2_url %>" class="w-full border p-2 rounded" required>
                    </div>
                </div>
            </div>

            <!-- Tab 8: SEO settings -->
            <div id="tab-seo" class="tab-content space-y-6 hidden">
                <h2 class="text-2xl font-bold mb-6 text-primary border-b pb-4">ตั้งค่า SEO & โซเชียลแชร์</h2>
                
                <div class="bg-blue-50 p-6 rounded-lg mb-6">
                    <label class="block font-semibold mb-2">รูปภาพ Thumbnail (แสดงเวลาแชร์ลิงก์ไปที่ Facebook/LINE)</label>
                    <input type="file" name="seo_thumbnail" accept="image/*" class="w-full text-sm">
                    <p class="text-xs text-gray-500 mt-1">ไฟล์ปัจจุบัน: <a href="<%= settings.seo_thumbnail_url %>" target="_blank" class="text-blue-500 underline">ดูรูป</a></p>
                </div>

                <div class="space-y-4">
                    <div>
                        <label class="block font-semibold mb-2">SEO Title (ชื่อเว็บที่แสดงบน Google)</label>
                        <input type="text" name="seo_title" value="<%= settings.seo_title %>" class="w-full border p-2 rounded" required>
                        <p class="text-xs text-gray-500 mt-1">คำแนะนำ: ความยาวไม่ควรเกิน 60 ตัวอักษร (เช่น "Lullapos - ระบบ POS ฟรีสำหรับร้านค้าเล็กๆ")</p>
                    </div>
                    <div>
                        <label class="block font-semibold mb-2">SEO Description (คำอธิบายเว็บใต้ลิงก์บน Google)</label>
                        <textarea name="seo_description" rows="3" class="w-full border p-2 rounded" required><%= settings.seo_description %></textarea>
                        <p class="text-xs text-gray-500 mt-1">คำแนะนำ: ความยาว 150-160 ตัวอักษร อธิบายจุดเด่นให้คนอยากคลิกอ่าน</p>
                    </div>
                    <div>
                        <label class="block font-semibold mb-2">SEO Keywords (คำค้นหาหลัก)</label>
                        <input type="text" name="seo_keywords" value="<%= settings.seo_keywords %>" class="w-full border p-2 rounded" required>
                        <p class="text-xs text-gray-500 mt-1">คำแนะนำ: คั่นแต่ละคำด้วยเครื่องหมายจุลภาค (,) เช่น ระบบ pos, pos ฟรี, เครื่องคิดเงิน</p>
                    </div>
                </div>
            </div>

            <!-- Submit Button (Sticky to bottom) -->
            <div class="mt-8 pt-6 border-t border-gray-200 sticky bottom-0 bg-white p-4 shadow-[0_-10px_15px_-3px_rgba(0,0,0,0.05)] rounded-b-xl z-20">
                <button type="submit" class="bg-primary text-white px-8 py-4 rounded-lg font-bold hover:opacity-80 w-full text-lg shadow-lg transition">บันทึกและอัปเดตเว็บไซต์</button>
            </div>
        </form>
    </div>

    <!-- Scripts สำหรับระบบ Tabs และ Quill Editor -->
    <script>
        // ระบบ Tabs
        function showTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(el => {
                el.classList.remove('border-primary', 'text-primary');
                el.classList.add('border-transparent', 'text-gray-500');
            });
            document.getElementById(tabId).classList.remove('hidden');
            let activeBtn = document.querySelector(`[data-target="${tabId}"]`);
            activeBtn.classList.add('border-primary', 'text-primary');
            activeBtn.classList.remove('border-transparent', 'text-gray-500');
        }
        
        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.addEventListener('click', (e) => showTab(e.target.dataset.target));
        });
        showTab('tab-general'); // แสดงแท็บแรกเมื่อโหลดหน้าเว็บ

        // ระบบ Text Editor (Quill)
        document.querySelectorAll('.quill-editor').forEach(function(editorDiv) {
            var targetId = editorDiv.getAttribute('data-target');
            var input = document.getElementById(targetId);
            
            var quill = new Quill(editorDiv, {
                theme: 'snow',
                modules: { toolbar: [ ['bold', 'italic', 'underline'], [{'list': 'ordered'}, {'list': 'bullet'}], ['clean'] ] }
            });
            quill.on('text-change', function() { input.value = quill.root.innerHTML; });
            input.value = quill.root.innerHTML;
        });

        // ระบบจัดการ FAQ (JSON Array)
        const faqContainer = document.getElementById('faq-container');
        const faqInput = document.getElementById('faq_list_input');
        const addFaqBtn = document.getElementById('add-faq-btn');
        
        // โหลดข้อมูล FAQ เดิมจาก Input
        let faqs = [];
        try { faqs = JSON.parse(faqInput.value || '[]'); } catch(e) { faqs = []; }

        function renderFaqs() {
            faqContainer.innerHTML = '';
            faqs.forEach((faq, index) => {
                const div = document.createElement('div');
                div.className = 'bg-white p-4 rounded border border-gray-200 relative mb-4';
                
                // ใช้การเข้ารหัสเครื่องหมายคำพูดป้องกัน HTML พัง
                const safeQuestion = faq.question ? faq.question.replace(/"/g, '&quot;') : '';

                div.innerHTML = `
                    <button type="button" onclick="removeFaq(${index})" class="absolute top-2 right-2 text-red-500 hover:text-red-700 font-bold text-lg" title="ลบคำถามนี้">&times;</button>
                    <label class="block text-sm font-semibold mb-1">คำถาม</label>
                    <input type="text" class="w-full border p-2 rounded mb-4 text-sm" value="${safeQuestion}" onchange="updateFaq(${index}, 'question', this.value)">
                    
                    <label class="block text-sm font-semibold mb-1">คำตอบ (รายละเอียด)</label>
                    <!-- สร้างพื้นที่สำหรับ Text Editor -->
                    <div id="faq_editor_${index}" class="bg-white" style="height: 100px;"></div>
                `;
                faqContainer.appendChild(div);

                // เริ่มต้นการทำงานของ Quill Editor สำหรับแต่ละข้อ
                const editorDiv = document.getElementById(`faq_editor_${index}`);
                editorDiv.innerHTML = faq.answer || ''; // ใส่ค่าเริ่มต้น

                const quillFaq = new Quill(editorDiv, {
                    theme: 'snow',
                    modules: { toolbar: [ ['bold', 'italic', 'underline'], [{'list': 'ordered'}, {'list': 'bullet'}], ['clean'] ] }
                });

                // เมื่อพิมพ์ข้อความ ให้อัปเดตค่าลง JSON ทันที
                quillFaq.on('text-change', function() {
                    faqs[index].answer = quillFaq.root.innerHTML;
                    faqInput.value = JSON.stringify(faqs);
                });
            });
            faqInput.value = JSON.stringify(faqs); // อัปเดต JSON ลง Input
        }

        window.updateFaq = function(index, key, value) {
            faqs[index][key] = value;
            faqInput.value = JSON.stringify(faqs);
        };

        window.removeFaq = function(index) {
            if(confirm('ต้องการลบคำถามนี้ใช่หรือไม่?')) {
                faqs.splice(index, 1);
                renderFaqs();
            }
        };

        addFaqBtn.addEventListener('click', () => {
            faqs.push({ question: '', answer: '' });
            renderFaqs();
        });

        renderFaqs(); // โหลดครั้งแรก
    </script>
</body>
</html>